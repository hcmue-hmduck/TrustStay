            .stage-3d {
                transform-style: preserve-3d;
                will-change: transform;
                transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
            }

            .carousel-3d-card {
                position: absolute;
                left: 50%;
                top: 50%;
                margin-left: -140px;
                /* -half of width */
                margin-top: -190px;
                /* -half of height */
                width: 280px;
                height: 380px;
                transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.8s ease, border-color 0.8s ease, box-shadow 0.8s ease;
                transform-style: preserve-3d;
            }

            .tilt-card-inner {
                width: 100%;
                height: 100%;
                transform-style: preserve-3d;
                transition: transform 0.2s ease-out;
            }
        </style>

        <!-- 3D Carousel container with left/right arrows -->
        <div class="relative w-full max-w-4xl mx-auto h-[480px] flex items-center justify-center overflow-visible mb-6">
