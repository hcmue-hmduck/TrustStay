<div class="space-y-6 text-left">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-slate-900">
    <div>
      <h1 class="text-2xl md:text-3xl font-mono font-black text-white uppercase tracking-tight flex items-center gap-3">
        <i data-lucide="home" class="w-7 h-7 text-brand-accent"></i>
        <span>Quản Lý Danh Sách Phòng Trọ</span>
      </h1>
      <p class="text-xs md:text-sm text-brand-muted mt-1.5">Danh sách tin đăng phòng trọ, căn hộ studio, ký túc xá cho thuê trên hệ thống TrustStay</p>
    </div>

    <a href="/admin/rooms/create" class="px-6 py-3 bg-brand-primary hover:bg-brand-accent text-slate-950 font-black text-xs md:text-sm rounded-xl transition-all shadow-lg flex items-center gap-2 cursor-pointer">
      <i data-lucide="plus-circle" class="w-5 h-5"></i>
      <span>THÊM PHÒNG TRỌ MỚI</span>
    </a>
  </div>

  <!-- Table Section -->
  <div class="glass-card rounded-3xl border border-white/10 overflow-hidden shadow-2xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs md:text-sm text-slate-300">
        <thead class="bg-slate-950/90 text-brand-muted uppercase text-xs tracking-wider font-mono border-b border-slate-900">
          <tr>
            <th class="py-4 px-5">Hình ảnh</th>
            <th class="py-4 px-5">Tên phòng / Tiêu đề</th>
            <th class="py-4 px-5">Loại phòng</th>
            <th class="py-4 px-5">Khu vực</th>
            <th class="py-4 px-5">Giá thuê / tháng</th>
            <th class="py-4 px-5">Diện tích</th>
            <th class="py-4 px-5">Trạng thái</th>
            <th class="py-4 px-5 text-right">Thao tác</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-900/60">
          <% if (data && data.length > 0) { %>
            <% data.forEach(room => { 
              const roomCat = category.find(c => c.ma_danh_muc === room.ma_danh_muc) || {};
              const roomLoc = location.find(l => l.ma_dia_diem === room.ma_dia_diem) || {};
            %>
              <tr class="hover:bg-white/[0.03] transition-colors">
                <td class="py-4 px-5">
                  <img src="<%= room.hinh_anh_dai_dien %>" alt="<%= room.ten_phong %>" class="w-16 h-12 rounded-xl object-cover border border-white/10 shadow-md" />
                </td>

                <td class="py-4 px-5 max-w-xs">
                  <a href="/room-details/<%= room.ma_phong %>" target="_blank" class="font-bold text-white hover:text-brand-accent transition-colors line-clamp-1 text-sm md:text-base">
                    <%= room.ten_phong %>
                  </a>
                  <p class="text-xs text-brand-muted truncate mt-0.5"><%= room.dia_chi_chi_tiet %></p>
                </td>

                <td class="py-4 px-5 font-semibold text-slate-300">
                  <%= roomCat.ten_danh_muc || 'Chưa phân loại' %>
                </td>

                <td class="py-4 px-5 font-semibold text-brand-accent">
                  <%= roomLoc.ten_dia_diem || 'Chưa rõ' %>
                </td>

                <td class="py-4 px-5 font-black text-brand-accent text-base font-mono">
                  <%= room.gia_thue ? room.gia_thue.toLocaleString('vi-VN') : 0 %> đ
                </td>

                <td class="py-4 px-5 font-mono text-slate-300 font-bold">
                  <%= room.dien_tich %> m²
                </td>

                <td class="py-4 px-5">
                  <% if (room.trang_thai === 'active') { %>
                    <span class="px-3 py-1 bg-green-500/10 text-green-400 border border-green-500/20 rounded-full text-xs font-bold">Hoạt động</span>
                  <% } else if (room.trang_thai === 'rented') { %>
                    <span class="px-3 py-1 bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 rounded-full text-xs font-bold">Đã cho thuê</span>
                  <% } else { %>
                    <span class="px-3 py-1 bg-slate-500/10 text-slate-400 border border-slate-500/20 rounded-full text-xs font-bold">Ẩn</span>
                  <% } %>
                </td>

                <td class="py-4 px-5 text-right space-x-2">
                  <a href="/admin/rooms/<%= room.ma_phong %>" class="p-2.5 text-brand-accent hover:bg-brand-accent/15 rounded-xl inline-block transition-colors" title="Sửa">
                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                  </a>

                  <button onclick="deleteRoom('<%= room.ma_phong %>')" class="p-2.5 text-red-400 hover:bg-red-500/15 rounded-xl transition-colors cursor-pointer" title="Xóa">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="p-10 text-center text-brand-muted text-sm">
                Chưa có dữ liệu phòng trọ nào.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<script>
  async function deleteRoom(ma_phong) {
    if (!confirm('Bạn có chắc chắn muốn xóa phòng trọ này?')) return;

    try {
      const res = await fetch('/api/rooms/delete/' + ma_phong, {
        method: 'DELETE'
      });
      const result = await res.json();
      if (result.success) {
        window.showAdminToast('Đã xóa phòng trọ thành công!');
        setTimeout(() => location.reload(), 800);
      } else {
        alert('Xóa thất bại: ' + result.message);
      }
    } catch (err) {
      alert('Lỗi kết nối máy chủ!');
    }
  }
</script>
