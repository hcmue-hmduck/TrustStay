        } else {
            statusBadge.classList.add('hidden');
        }

        container.innerHTML = filteredTours.map(pkg => {
            const isFav = favorites.includes(pkg.id);
            return `
                <div class="glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-brand-accent/50 hover:shadow-2xl transition-all duration-300 border border-white/10 group">
                    <!-- Card Banner -->
                    <div class="relative h-48 overflow-hidden">
                      <img 
                        alt="${pkg.title}" 
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 brightness-95" 
                        src="${pkg.image}"
                        referrerPolicy="no-referrer"
                      />
                      
                      <!-- Discount Tag -->
                      <div class="absolute top-4 left-4">
                        <span class="px-2.5 py-1 bg-red-600 text-white text-[10px] font-black rounded-lg">
                          -${pkg.discountPercent}%
