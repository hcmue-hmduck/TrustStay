<div class="space-y-6 text-left">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-slate-900">
    <div>
      <h1 class="text-2xl font-mono font-black text-white uppercase tracking-tight flex items-center gap-2">
        <i data-lucide="map-pin" class="w-6 h-6 text-brand-accent"></i>
        <span>Quản Lý Khu Vực & Địa Điểm</span>
      </h1>
      <p class="text-xs text-brand-muted mt-1">Danh sách các quận huyện, khu vực lân cận trường học và trung tâm cho thuê phòng trọ</p>
    </div>

    <button onclick="openAddLocationModal()" class="px-5 py-2.5 bg-brand-primary hover:bg-brand-accent text-slate-950 font-bold text-xs rounded-xl transition-all shadow-lg flex items-center gap-2 cursor-pointer">
      <i data-lucide="plus-circle" class="w-4 h-4"></i>
      <span>Thêm Khu Vực Mới</span>
    </button>
  </div>

  <!-- Locations Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (data && data.length > 0) { %>
      <% data.forEach(loc => { %>
        <div class="glass-card rounded-2xl border border-white/5 p-6 flex flex-col justify-between space-y-4 hover:border-brand-accent/30 transition-all">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 bg-brand-accent/10 border border-brand-accent/20 text-brand-accent font-mono text-[10px] font-bold rounded-lg uppercase">
                <%= loc.ma_dia_diem %>
              </span>
              <div class="flex items-center gap-1">
                <button onclick="editLocation('<%= loc.ma_dia_diem %>', '<%= loc.ten_dia_diem %>', '<%= loc.tinh_thanh %>', '<%= (loc.mo_ta || '').replace(/'/g, '\\\'') %>', '<%= loc.hinh_anh || '' %>')" class="p-1.5 text-brand-accent hover:bg-brand-accent/10 rounded-lg transition-colors cursor-pointer" title="Sửa">
                  <i data-lucide="edit-3" class="w-4 h-4"></i>
                </button>
                <button onclick="deleteLocation('<%= loc.ma_dia_diem %>')" class="p-1.5 text-red-400 hover:bg-red-500/10 rounded-lg transition-colors cursor-pointer" title="Xóa">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <% if (loc.hinh_anh) { %>
                <img src="<%= loc.hinh_anh %>" alt="<%= loc.ten_dia_diem %>" class="w-12 h-12 rounded-xl object-cover border border-white/10 shrink-0" />
              <% } else { %>
                <div class="w-12 h-12 rounded-xl bg-slate-900 border border-white/10 flex items-center justify-center text-brand-accent shrink-0 font-mono font-black text-xs">
                  LOC
                </div>
              <% } %>
              <div>
                <h3 class="font-bold text-white text-sm"><%= loc.ten_dia_diem %></h3>
                <span class="text-[10px] text-brand-muted"><%= loc.tinh_thanh || 'TP.HCM / Hà Nội' %></span>
              </div>
            </div>

            <p class="text-xs text-brand-muted leading-relaxed line-clamp-2"><%= loc.mo_ta || 'Khu vực đông đúc sinh viên & người đi làm.' %></p>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-span-full py-12 text-center text-brand-muted glass-card rounded-2xl border border-white/5">
        Chưa có khu vực / địa điểm nào.
      </div>
    <% } %>
  </div>

</div>

<!-- Add/Edit Location Modal -->
<div id="locationModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden">
  <div class="glass-card bg-slate-950 max-w-md w-full rounded-2xl p-6 border border-white/10 shadow-2xl relative space-y-4 text-left">
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <h3 id="locModalTitle" class="text-sm font-bold text-white uppercase tracking-wider">Thêm Khu Vực Mới</h3>
      <button onclick="closeLocationModal()" class="text-slate-400 hover:text-white p-1">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form id="locationAdminForm" onsubmit="saveLocation(event)" class="space-y-4 text-xs">
      <input type="hidden" name="ma_dia_diem" id="locMaDiaDiem" />

      <div class="space-y-1">
        <label class="block font-bold text-slate-300">Tên Khu Vực / Quận Huyện *</label>
        <input type="text" name="ten_dia_diem" id="locTen" required placeholder="Ví dụ: Quận 7, Bách Khoa, Thủ Đức..." class="w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-xl text-white focus:outline-none focus:border-brand-accent" />
      </div>

      <div class="space-y-1">
        <label class="block font-bold text-slate-300">Tỉnh / Thành Phố</label>
        <input type="text" name="tinh_thanh" id="locTinhThanh" placeholder="Ví dụ: TP. Hồ Chí Minh / Hà Nội" class="w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-xl text-white focus:outline-none focus:border-brand-accent" />
      </div>

      <div class="space-y-1">
        <label class="block font-bold text-slate-300">Link Ảnh Đại Diện (tùy chọn)</label>
        <input type="url" name="hinh_anh" id="locHinhAnh" placeholder="https://images.unsplash.com/..." class="w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-xl text-white focus:outline-none focus:border-brand-accent" />
      </div>

      <div class="space-y-1">
        <label class="block font-bold text-slate-300">Mô Tả Khu Vực</label>
        <textarea name="mo_ta" id="locMoTa" rows="3" placeholder="Mô tả trường đại học, khu công nghiệp xung quanh..." class="w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-xl text-white focus:outline-none focus:border-brand-accent resize-none"></textarea>
      </div>

      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="closeLocationModal()" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl">Hủy</button>
        <button type="submit" class="px-5 py-2 bg-brand-primary hover:bg-brand-accent text-slate-950 font-bold rounded-xl">Lưu Khu Vực</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAddLocationModal() {
    document.getElementById('locModalTitle').innerText = 'Thêm Khu Vực Mới';
    document.getElementById('locMaDiaDiem').value = '';
    document.getElementById('locTen').value = '';
    document.getElementById('locTinhThanh').value = '';
    document.getElementById('locHinhAnh').value = '';
    document.getElementById('locMoTa').value = '';
    document.getElementById('locationModal').classList.remove('hidden');
  }

  function editLocation(ma, ten, tinhThanh, moTa, hinhAnh) {
    document.getElementById('locModalTitle').innerText = 'Chỉnh Sửa Khu Vực (' + ma + ')';
    document.getElementById('locMaDiaDiem').value = ma;
    document.getElementById('locTen').value = ten;
    document.getElementById('locTinhThanh').value = tinhThanh;
    document.getElementById('locMoTa').value = moTa;
    document.getElementById('locHinhAnh').value = hinhAnh;
    document.getElementById('locationModal').classList.remove('hidden');
  }

  function closeLocationModal() {
    document.getElementById('locationModal').classList.add('hidden');
  }

  async function saveLocation(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const ma_dia_diem = data.ma_dia_diem;

    const url = ma_dia_diem ? ('/api/location/' + ma_dia_diem) : '/api/location';
    const method = ma_dia_diem ? 'PUT' : 'POST';

    try {
      const res = await fetch(url, {
        method: method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        window.showAdminToast('Lưu thông tin khu vực thành công!');
        closeLocationModal();
        setTimeout(() => location.reload(), 600);
      } else {
        alert('Lưu thất bại: ' + result.message);
      }
    } catch(err) {
      alert('Lỗi kết nối máy chủ!');
    }
  }

  async function deleteLocation(ma) {
    if (!confirm('Bạn có chắc chắn muốn xóa khu vực này?')) return;
    try {
      const res = await fetch('/api/location/' + ma, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) {
        window.showAdminToast('Đã xóa khu vực thành công!');
        setTimeout(() => location.reload(), 600);
      } else {
        alert('Xóa thất bại: ' + result.message);
      }
    } catch(err) {
      alert('Lỗi kết nối máy chủ!');
    }
  }
</script>
