<!-- Hero Header Section for Customer Rental Experience Blog -->
<section class="relative min-h-[48vh] flex flex-col justify-center py-12 overflow-hidden text-left">
    <!-- Backdrop Image -->
    <div class="absolute inset-0 z-0">
        <img alt="Rental Blog background cover" class="w-full h-full object-cover opacity-20"
            src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&q=80&w=2000"
            referrerpolicy="no-referrer" />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-50/70 via-slate-50/90 to-[#f8fafc]"></div>
    </div>

    <!-- Outer Alignment Container -->
    <div class="max-w-screen-2xl mx-auto w-full px-4 md:px-8 z-10 flex flex-col items-center">
        <!-- Content Panel -->
        <div class="w-full max-w-4xl text-center">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 bg-sky-50 border border-sky-200 rounded-full shadow-sm">
                <i data-lucide="book-open" class="w-4 h-4 text-sky-600"></i>
                <span class="text-[10px] font-extrabold text-sky-700 uppercase tracking-widest">Góc Chia Sẻ & Review Khách Hàng</span>
            </div>

            <!-- Title -->
            <h1 class="text-3xl md:text-6xl font-black text-slate-900 leading-tight tracking-tight mb-6">
                Kinh Nghiệm <span class="hero-gradient-text">Thuê Phòng Trọ</span>
            </h1>

            <p class="text-sm md:text-base text-slate-600 font-medium mb-8 max-w-2xl mx-auto leading-relaxed">
                Tổng hợp những nhận xét thực tế, kinh nghiệm soi hợp đồng, mẹo decor và câu chuyện tìm trọ thực chiến từ cộng đồng người thuê TrustStay.
            </p>

            <!-- Search & Create Bar -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-3xl mx-auto mb-4">
                <div class="w-full sm:flex-1 bg-white p-2 rounded-full flex items-center border border-slate-200 shadow-lg">
                    <i data-lucide="search" class="w-5 h-5 text-slate-400 ml-4"></i>
                    <input type="text" id="blogSearchInput" onkeyup="filterBlogArticles()" placeholder="Tìm bài viết kinh nghiệm, review phòng..." 
                        class="flex-1 bg-transparent border-none text-xs font-medium text-slate-800 px-4 py-2 focus:outline-none placeholder:text-slate-400" />
                </div>

                <button onclick="openCreateBlogModal()" class="w-full sm:w-auto px-6 py-3 bg-sky-600 text-white rounded-full text-xs font-black hover:bg-sky-700 active:scale-95 transition-all shadow-md flex items-center justify-center gap-2 shrink-0 cursor-pointer">
                    <i data-lucide="pen-tool" class="w-4 h-4"></i>
                    <span>VIẾT BÀI CHIA SẺ</span>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Blog Listing Section -->
<section class="py-12 bg-[#f8fafc] relative z-10 text-left">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8">
        <% if (data && data.length > 0) { %>
            
            <!-- Featured Blog (First Item) -->
            <% const featured = data[0]; %>
            <div id="blog-card-<%= featured.ma_bai_viet %>" class="blog-article-card bg-white rounded-3xl overflow-hidden border border-slate-200 group mb-16 hover:border-sky-300 transition-colors duration-500 shadow-md hover:shadow-xl">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
                    <!-- Image -->
                    <a href="/blogs/<%= featured.ma_bai_viet %>" class="relative h-64 lg:h-[420px] overflow-hidden block">
                        <img src="<%= featured.hinh_anh_dai_dien || 'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=1000&q=80' %>" 
                             alt="<%= featured.tieu_de %>" 
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute top-5 left-5">
                            <span class="px-3 py-1.5 bg-sky-600 text-white text-[10px] font-black rounded-lg uppercase tracking-widest shadow-md">
                                BÀI VIẾT NỔI BẬT
                            </span>
                        </div>
                    </a>
                    
                    <!-- Content -->
                    <div class="p-8 lg:p-12 flex flex-col justify-center relative">
                        <div class="flex items-center gap-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-4">
                            <span class="flex items-center gap-1.5">
                                <i data-lucide="calendar" class="w-3.5 h-3.5 text-sky-600"></i>
                                <%= new Date(featured.createdAt || Date.now()).toLocaleDateString('vi-VN') %>
                            </span>
                            <span class="px-2.5 py-0.5 rounded-full bg-sky-50 border border-sky-200 text-sky-700">
                                Chia sẻ từ Người Thuê
                            </span>
                        </div>
                        
                        <h2 class="text-2xl lg:text-3xl font-black text-slate-900 leading-tight mb-4 group-hover:text-sky-600 transition-colors article-title">
                            <a href="/blogs/<%= featured.ma_bai_viet %>" class="hover:text-sky-600 transition-colors"><%= featured.tieu_de %></a>
                        </h2>
                        
                        <p class="text-slate-600 text-xs md:text-sm leading-relaxed mb-6 line-clamp-4 article-summary">
                            <%= featured.tom_tat || featured.noi_dung %>
                        </p>

                        <% if (featured.noi_dung) { %>
                            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-700 leading-relaxed mb-6 line-clamp-2 italic">
                                "<%= featured.noi_dung %>"
                            </div>
                        <% } %>

                        <div class="pt-2">
                            <a href="/blogs/<%= featured.ma_bai_viet %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-sky-600 text-sky-700 text-xs font-black hover:bg-sky-600 hover:text-white transition-all group/link">
                                <span>Đọc Tiếp Bài Viết</span>
                                <i data-lucide="arrow-right" class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid Blogs -->
            <% if (data.length > 1) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="blogGridContainer">
                    <% data.slice(1).forEach(blog => { %>
                        <div id="blog-card-<%= blog.ma_bai_viet %>" class="blog-article-card bg-white rounded-2xl overflow-hidden border border-slate-200 flex flex-col group hover:-translate-y-2 hover:border-sky-300 shadow-sm hover:shadow-xl transition-all duration-300">
                            <!-- Image -->
                            <a href="/blogs/<%= blog.ma_bai_viet %>" class="relative h-56 overflow-hidden block">
                                <img src="<%= blog.hinh_anh_dai_dien || 'https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=1000&q=80' %>" 
                                     alt="<%= blog.tieu_de %>" 
                                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            </a>
                            
                            <!-- Content -->
                            <div class="p-6 flex-1 flex flex-col justify-between">
                                <div>
                                    <div class="flex items-center gap-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-3">
                                        <span class="px-2.5 py-1 bg-sky-50 rounded text-sky-700 border border-sky-200">
                                            <%= new Date(blog.createdAt || Date.now()).toLocaleDateString('vi-VN') %>
                                        </span>
                                        <span>Góc Người Thuê</span>
                                    </div>
                                    <h3 class="text-base font-black text-slate-900 leading-snug mb-3 group-hover:text-sky-600 transition-colors line-clamp-2 article-title">
                                        <a href="/blogs/<%= blog.ma_bai_viet %>" class="hover:text-sky-600 transition-colors"><%= blog.tieu_de %></a>
                                    </h3>
                                    <p class="text-slate-500 text-xs leading-relaxed line-clamp-3 article-summary">
                                        <%= blog.tom_tat || blog.noi_dung %>
                                    </p>
                                </div>

                                <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                                    <a href="/blogs/<%= blog.ma_bai_viet %>" class="text-sky-600 text-xs font-bold hover:text-sky-700 transition-colors flex items-center gap-1.5">
                                        <span>Đọc bài viết</span>
                                        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>

        <% } else { %>
            <!-- Empty State -->
            <div class="py-20 text-center bg-white rounded-3xl border border-slate-200 max-w-2xl mx-auto shadow-md relative overflow-hidden">
                <div class="w-16 h-16 bg-sky-100 rounded-full flex items-center justify-center mx-auto mb-4 border border-sky-200">
                    <i data-lucide="file-text" class="w-8 h-8 text-sky-600"></i>
                </div>
                <h3 class="text-xl font-black text-slate-900 mb-2">Chưa có bài chia sẻ nào</h3>
                <p class="text-slate-500 text-xs max-w-md mx-auto mb-6">Hãy là người đầu tiên chia sẻ kinh nghiệm thuê trọ, review không gian sống của bạn cho cộng đồng TrustStay!</p>
                <button onclick="openCreateBlogModal()" class="px-6 py-2.5 bg-sky-600 text-white rounded-full text-xs font-black hover:bg-sky-700 shadow-sm">
                    + Viết bài chia sẻ ngay
                </button>
            </div>
        <% } %>
    </div>
</section>

<!-- CREATE CUSTOMER BLOG MODAL -->
<div id="createBlogModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 hidden">
    <div class="bg-white max-w-2xl w-full rounded-3xl p-6 md:p-8 border border-slate-200 shadow-2xl relative text-left">
        
        <button onclick="closeCreateBlogModal()" class="absolute top-5 right-5 text-slate-400 hover:text-slate-900 p-1 rounded-full hover:bg-slate-100 transition-colors">
            <i data-lucide="x" class="w-5 h-5"></i>
        </button>

        <div class="space-y-2 mb-6 border-b border-slate-100 pb-4">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-50 text-sky-700 border border-sky-200 text-[11px] font-bold">
                <i data-lucide="pen-tool" class="w-3.5 h-3.5"></i> Góc Chia Sẻ Khách Hàng
            </div>
            <h3 class="text-xl font-black text-slate-900">Đăng Bài Chia Sẻ Kinh Nghiệm Thuê Trọ</h3>
            <p class="text-xs text-slate-500">Chia sẻ trải nghiệm xem phòng, mẹo chọn trọ hoặc kinh nghiệm cá nhân đến cộng đồng.</p>
        </div>

        <form id="createBlogForm" onsubmit="submitCustomerBlog(event)" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Tiêu đề bài viết <span class="text-red-500">*</span></label>
                <input type="text" name="tieu_de" required placeholder="Ví dụ: Kinh nghiệm đàm phán hợp đồng thuê trọ sinh viên..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Tóm tắt ngắn</label>
                <input type="text" name="tom_tat" placeholder="Tóm tắt nội dung chính trong 1-2 câu..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Link hình ảnh bìa (tùy chọn)</label>
                <input type="url" name="hinh_anh_dai_dien" placeholder="https://images.unsplash.com/..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nội dung bài viết chi tiết <span class="text-red-500">*</span></label>
                <textarea name="noi_dung" rows="5" required placeholder="Chia sẻ kinh nghiệm thực tế, chi phí sinh hoạt, lưu ý chủ trọ, thiết bị phòng..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-sky-500 focus:bg-white focus:ring-2 focus:ring-sky-500/20"></textarea>
            </div>

            <div class="pt-2 flex justify-end gap-3">
                <button type="button" onclick="closeCreateBlogModal()" class="px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs border border-slate-200">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-7 py-3 bg-sky-600 hover:bg-sky-700 text-white font-black rounded-xl transition-all shadow-md flex items-center gap-2 text-xs uppercase tracking-wider cursor-pointer">
                    <i data-lucide="send" class="w-4 h-4"></i>
                    <span>ĐĂNG BÀI VIẾT</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openCreateBlogModal() {
        document.getElementById('createBlogModal').classList.remove('hidden');
    }

    function closeCreateBlogModal() {
        document.getElementById('createBlogModal').classList.add('hidden');
    }

    async function submitCustomerBlog(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const res = await fetch('/api/blogs/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) {
                alert('Đăng bài chia sẻ kinh nghiệm thành công!');
                closeCreateBlogModal();
                form.reset();
                window.location.reload();
            } else {
                alert('Có lỗi xảy ra: ' + (result.message || 'Không thể đăng bài.'));
            }
        } catch (err) {
            alert('Lỗi kết nối máy chủ!');
        }
    }

    function filterBlogArticles() {
        const query = (document.getElementById('blogSearchInput').value || '').toLowerCase().trim();
        const cards = document.querySelectorAll('.blog-article-card');

        cards.forEach(card => {
            const titleEl = card.querySelector('.article-title');
            const summaryEl = card.querySelector('.article-summary');
            const titleText = titleEl ? titleEl.innerText.toLowerCase() : '';
            const summaryText = summaryEl ? summaryEl.innerText.toLowerCase() : '';

            if (titleText.includes(query) || summaryText.includes(query)) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }

    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>