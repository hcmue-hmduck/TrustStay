<!-- Hero Header Section for Blog -->
<section class="relative min-h-[50vh] flex flex-col justify-center py-12 overflow-hidden">
    <!-- Cinematic Backdrop Image -->
    <div class="absolute inset-0 z-0">
        <img alt="Blog background cover" class="w-full h-full object-cover brightness-[0.25]"
            src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&q=80&w=2021"
            referrerpolicy="no-referrer" />
        <div class="absolute inset-0 bg-gradient-to-b from-[#020e1f]/50 via-[#020e1f]/80 to-[#020e1f]"></div>
    </div>

    <!-- Outer Alignment Container -->
    <div class="max-w-screen-2xl mx-auto w-full px-4 md:px-8 z-10 flex flex-col items-center">
        <!-- Content Panel -->
        <div class="w-full max-w-4xl text-center">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 glass-panel rounded-full shadow-[0_0_15px_rgba(164,230,255,0.1)]">
                <i data-lucide="book-open" class="w-4 h-4 text-brand-accent"></i>
                <span class="text-[10px] font-extrabold text-brand-accent uppercase tracking-widest">Góc Chia Sẻ</span>
            </div>

            <!-- Slogan -->
            <h1 class="text-4xl md:text-6xl font-black text-white leading-tight tracking-tight mb-6">
                Cẩm Nang <span class="hero-gradient-text">Du Lịch</span>
            </h1>

            <p class="text-sm md:text-base text-brand-muted font-medium mb-10 max-w-2xl mx-auto opacity-90 leading-relaxed">
                Khám phá những vùng đất mới, kinh nghiệm du lịch thực tế và những câu chuyện truyền cảm hứng từ hành trình của TPVTravel.
            </p>

            <!-- Search Bar -->
            <div class="max-w-2xl mx-auto mb-8 glass-panel p-2.5 rounded-full flex items-center border border-white/10 shadow-2xl">
                <i data-lucide="search" class="w-5 h-5 text-brand-muted ml-4"></i>
                <input type="text" placeholder="Tìm kiếm bài viết, kinh nghiệm, địa điểm..." 
                    class="flex-1 bg-transparent border-none text-sm font-medium text-white px-4 py-2 focus:outline-none placeholder:text-brand-muted/50" />
                <button class="px-6 py-2.5 bg-brand-accent text-brand-dark rounded-full text-xs font-black hover:bg-brand-primary active:scale-95 transition-all shadow-[0_0_15px_rgba(164,230,255,0.3)]">
                    Tìm kiếm
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Blog Listing Section -->
<section class="py-12 bg-[#020e1f] relative z-10">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8">
        <% if (data && data.length > 0) { %>
            
            <!-- Featured Blog (First Item) -->
            <% const featured = data[0]; %>
            <div class="glass-panel rounded-3xl overflow-hidden border border-white/10 group mb-16 hover:border-brand-accent/40 transition-colors duration-500 shadow-2xl">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
                    <!-- Image -->
                    <div class="relative h-64 lg:h-[420px] overflow-hidden">
                        <img src="<%= featured.hinh_anh_dai_dien || 'https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&q=80&w=1000' %>" 
                             alt="<%= featured.tieu_de %>" 
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                        <div class="absolute top-5 left-5">
                            <span class="px-3 py-1.5 bg-brand-accent text-brand-dark text-[10px] font-black rounded-lg uppercase tracking-widest shadow-lg">
                                BÀI NỔI BẬT
                            </span>
                        </div>
                    </div>
                    
                    <!-- Content -->
                    <div class="p-8 lg:p-12 flex flex-col justify-center relative">
                        <!-- Decorative glow -->
                        <div class="absolute -top-24 -right-24 w-64 h-64 bg-brand-accent/10 blur-[100px] rounded-full pointer-events-none"></div>

                        <div class="flex items-center gap-4 text-[10px] font-bold text-brand-muted uppercase tracking-widest mb-4">
                            <span class="flex items-center gap-1.5">
                                <i data-lucide="calendar" class="w-3.5 h-3.5 text-brand-accent"></i>
                                <%= new Date(featured.createdAt).toLocaleDateString('vi-VN') %>
                            </span>
                        </div>
                        
                        <h2 class="text-2xl lg:text-4xl font-black text-white leading-tight mb-5 group-hover:text-brand-accent transition-colors">
                            <a href="/blogs/<%= featured.ma_bai_viet %>"><%= featured.tieu_de %></a>
                        </h2>
                        
                        <p class="text-brand-muted text-sm leading-relaxed mb-8 line-clamp-4">
                            <%= featured.tom_tat || 'Khám phá chi tiết hành trình trong bài viết này cùng những kinh nghiệm quý báu được chia sẻ từ chúng tôi.' %>
                        </p>
                        
                        <div class="mt-auto">
                            <a href="/blogs/<%= featured.ma_bai_viet %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-brand-accent/30 text-brand-accent text-xs font-black hover:bg-brand-accent hover:text-brand-dark transition-all group/link">
                                <span>Đọc Tiếp Bài Viết</span>
                                <i data-lucide="arrow-right" class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid Blogs -->
            <% if (data.length > 1) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% data.slice(1).forEach(blog => { %>
                        <div class="glass-panel rounded-2xl overflow-hidden border border-white/10 flex flex-col group hover:-translate-y-2 hover:border-brand-accent/30 hover:shadow-[0_15px_30px_-15px_rgba(164,230,255,0.15)] transition-all duration-300">
                            <!-- Image -->
                            <div class="relative h-56 overflow-hidden">
                                <img src="<%= blog.hinh_anh_dai_dien || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&q=80&w=1000' %>" 
                                     alt="<%= blog.tieu_de %>" 
                                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                                <div class="absolute inset-0 bg-gradient-to-t from-[#020e1f] via-transparent to-transparent opacity-90"></div>
                            </div>
                            
                            <!-- Content -->
                            <div class="p-6 flex-1 flex flex-col justify-between z-10 relative -mt-10">
                                <div>
                                    <div class="flex items-center gap-3 text-[10px] font-bold text-brand-muted uppercase tracking-widest mb-3">
                                        <span class="px-2.5 py-1 bg-[#020e1f]/80 rounded text-brand-accent border border-white/10 backdrop-blur-md">
                                            <%= new Date(blog.createdAt).toLocaleDateString('vi-VN') %>
                                        </span>
                                    </div>
                                    <h3 class="text-lg font-black text-white leading-snug mb-3 group-hover:text-brand-accent transition-colors line-clamp-2">
                                        <a href="/blogs/<%= blog.ma_bai_viet %>"><%= blog.tieu_de %></a>
                                    </h3>
                                    <p class="text-brand-muted text-xs leading-relaxed line-clamp-3">
                                        <%= blog.tom_tat || 'Đọc thêm để biết thêm chi tiết về kinh nghiệm và bài học quý giá này.' %>
                                    </p>
                                </div>
                                
                                <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between">
                                    <a href="/blogs/<%= blog.ma_bai_viet %>" class="text-brand-accent text-xs font-bold hover:text-brand-primary transition-colors flex items-center gap-1.5">
                                        Đọc bài viết <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>

        <% } else { %>
            <!-- Empty State -->
            <div class="py-24 text-center glass-panel rounded-3xl border border-white/10 max-w-2xl mx-auto shadow-2xl relative overflow-hidden">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-48 h-48 bg-brand-accent/5 blur-[80px] rounded-full"></div>
                <div class="w-20 h-20 bg-brand-accent/10 rounded-full flex items-center justify-center mx-auto mb-6 border border-brand-accent/20 relative z-10">
                    <i data-lucide="file-text" class="w-8 h-8 text-brand-accent"></i>
                </div>
                <h3 class="text-xl font-black text-white mb-2 relative z-10">Chưa có bài viết nào</h3>
                <p class="text-brand-muted text-sm relative z-10 max-w-md mx-auto">Chúng tôi đang biên tập và sẽ sớm cập nhật thêm các bài viết hấp dẫn về du lịch. Vui lòng quay lại sau nhé!</p>
            </div>
        <% } %>
    </div>
</section>

<!-- Pagination -->
<% if (data && data.length > 0) { %>
<div class="py-8 bg-[#020e1f] flex justify-center pb-24 border-t border-white/5">
    <div class="flex items-center gap-2">
        <button class="w-9 h-9 rounded-full glass-panel flex items-center justify-center text-brand-muted hover:text-white hover:bg-white/10 transition-colors cursor-not-allowed opacity-50">
            <i data-lucide="chevron-left" class="w-4 h-4"></i>
        </button>
        <button class="w-9 h-9 rounded-full bg-brand-accent text-brand-dark font-black flex items-center justify-center shadow-[0_0_15px_rgba(164,230,255,0.3)]">
            1
        </button>
        <button class="w-9 h-9 rounded-full glass-panel flex items-center justify-center text-white font-bold hover:bg-white/10 transition-colors border border-white/5">
            2
        </button>
        <button class="w-9 h-9 rounded-full glass-panel flex items-center justify-center text-white font-bold hover:bg-white/10 transition-colors border border-white/5">
            <i data-lucide="chevron-right" class="w-4 h-4"></i>
        </button>
    </div>
</div>
<% } %>

<!-- Re-initialize icons if loaded via AJAX/Dynamic -->
<script>
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>