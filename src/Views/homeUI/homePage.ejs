    // Toast function
    function showToast(message) {
        const toast = document.getElementById('toast-notification');
        const text = document.getElementById('toast-text');
        text.innerText = message;
        toast.classList.remove('hidden');
        setTimeout(() => {
            toast.classList.remove('opacity-0', '-translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');
        }, 50);

        setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', '-translate-y-4');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 300);
        }, 3000);
    }

    // Toggle Bento Item View
    function toggleBentoView(id) {
        const activeCard = document.getElementById(`bento-card-${id}`);
        const activePanel = document.getElementById(`bento-info-${id}`);
        const activeLabel = document.getElementById(`bento-label-${id}`);

        if (!activeCard) return;

        const isCurrentlyActive = activeCard.classList.contains('lg:flex-[4.5]');

        // If clicking a card that is already active:
        if (isCurrentlyActive) {
            // If it's already halong, do nothing (keep it open)
            if (id === 'halong') return;

            // If it's another card, close it and open halong back
            toggleBentoView('halong');
            return;
        }

        // Reset all cards to flex-1 (including halong)
        ['halong', 'phuquoc', 'hoian', 'sapa'].forEach(key => {
            const card = document.getElementById(`bento-card-${key}`);
            const panel = document.getElementById(`bento-info-${key}`);
            const label = document.getElementById(`bento-label-${key}`);

            if (card) {
                card.classList.remove('lg:flex-[4.5]');
                card.classList.add('flex-1');

                // Height on mobile
                card.classList.remove('h-[350px]');
                card.classList.add('h-[120px]');
            }
            if (panel) {
                panel.classList.add('opacity-0', 'pointer-events-none');
                panel.classList.remove('opacity-100');
                // Hide panel after fade transition to prevent text wrapping in small columns
                setTimeout(() => {
                    if (panel.classList.contains('opacity-0')) {
                        panel.classList.add('hidden');
                    }
                }, 500);
            }
            if (label) {
                label.classList.remove('opacity-0');
                label.classList.add('opacity-100');
            }
        });

        // Activate clicked card
        activeCard.classList.remove('flex-1');
        activeCard.classList.add('lg:flex-[4.5]');

        // Height on mobile
        activeCard.classList.remove('h-[120px]');
        activeCard.classList.add('h-[350px]');

        if (activePanel) {
            activePanel.classList.remove('hidden');
            // Small delay to allow display: flex state to register in DOM, then fade in
            setTimeout(() => {
                activePanel.classList.remove('opacity-0', 'pointer-events-none');
                activePanel.classList.add('opacity-100');
            }, 50);
        }
        if (activeLabel) {
            activeLabel.classList.remove('opacity-100');
            activeLabel.classList.add('opacity-0');
        }
    }

    // Close Dropdowns on Document Click
    document.addEventListener('click', (e) => {
        if (!e.target.closest('#bento-destinations')) {
            const halongCard = document.getElementById('bento-card-halong');
            if (halongCard && !halongCard.classList.contains('lg:flex-[4.5]')) {
                toggleBentoView('halong');
