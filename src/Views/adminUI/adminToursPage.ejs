<div class="space-y-6">
    <!-- Header Page -->
    <div class="glass-card p-6 rounded-2xl flex flex-col lg:flex-row lg:items-center justify-between gap-6 border-l-4 border-l-brand-accent shadow-2xl">
        <div class="space-y-1">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-brand-accent/10 rounded-xl shadow-inner">
                    <i data-lucide="map" class="w-6 h-6 text-brand-accent"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-black text-white leading-tight">Quản Lý Danh Sách Tours</h1>
                    <p class="text-xs text-brand-muted font-medium mt-1">Điều hành, thêm mới và thiết lập toàn bộ hệ thống tour du lịch.</p>
                </div>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <button type="button" onclick="openCategoryModal()"
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-800/50 border border-white/10 text-slate-300 text-xs font-bold rounded-xl hover:bg-slate-700 hover:text-white hover:border-white/20 transition-all cursor-pointer">
                <i data-lucide="folder-open" class="w-4 h-4 text-brand-accent"></i>
                <span>Danh Mục</span>
            </button>
            <button type="button" onclick="openLocationModal()"
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-800/50 border border-white/10 text-slate-300 text-xs font-bold rounded-xl hover:bg-slate-700 hover:text-white hover:border-white/20 transition-all cursor-pointer">
                <i data-lucide="map-pin" class="w-4 h-4 text-brand-accent"></i>
                <span>Địa Điểm</span>
            </button>
            <a href="/admin/tours/create"
                class="inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-brand-primary to-brand-accent text-brand-dark text-xs font-black rounded-xl hover:scale-[1.02] active:scale-95 transition-all shadow-[0_0_20px_rgba(0,210,255,0.3)] hover:shadow-[0_0_30px_rgba(0,210,255,0.5)] cursor-pointer">
                <i data-lucide="plus-circle" class="w-4.5 h-4.5"></i>
                <span>Tạo Tour Mới</span>
            </a>
        </div>
    </div>

    <!-- Toolbar Filters -->
    <div class="glass-card p-4 rounded-2xl">
        <!-- Search bar input -->
        <div class="relative w-full">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-brand-muted">
                <i data-lucide="search" class="w-4.5 h-4.5"></i>
            </span>
            <input type="text" id="tour-search-input" placeholder="Tìm kiếm theo mã tour, tên tour..."
                class="w-full pl-10 pr-4 py-2.5 bg-[#0b1329] border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 placeholder:text-brand-muted/40 font-semibold transition-all" />
        </div>
    </div>

    <!-- Tours Table component -->
    <div class="glass-card rounded-2xl overflow-hidden">
        <div class="overflow-x-auto min-w-full">
            <table class="min-w-full text-sm text-left">
                <thead>
                    <tr class="border-b border-white/10 text-brand-muted font-bold bg-[#0b1329]/80">
                        <th class="py-4 px-6">Tour</th>
                        <th class="py-4 px-4">Danh Mục</th>
                        <th class="py-4 px-4">Địa Điểm</th>
                        <th class="py-4 px-4">Giá Khuyến mãi</th>
                        <th class="py-4 px-4">Khởi Hành</th>
                        <th class="py-4 px-2 text-center w-px whitespace-nowrap">Trạng Thái</th>
                        <th class="py-4 px-2 text-center w-px whitespace-nowrap">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tours-table-body">
                    <% if (data && data.length> 0) { %>
                        <% data.forEach(tour=> { %>
                            <% const cat=(category || []).find(c=> c.ma_danh_muc === tour.ma_danh_muc);
                                const catName = cat ? cat.ten_danh_muc : 'Chưa phân loại';
                                const loc = (location || []).find(l => l.ma_dia_diem === tour.ma_dia_diem);
                                const locName = loc ? loc.ten_dia_diem : 'Chưa xác định';
                                %>
                                <tr id="tour-row-<%= tour._id %>"
                                    class="border-b border-white/5 hover:bg-white/5 transition-colors tour-row"
                                    data-search-text="<%= (tour.ma_tour + ' ' + tour.ten_tour + ' ' + catName + ' ' + locName).toLowerCase() %>">
                                    <!-- Image & Title details -->
                                    <td class="py-4 px-6">
                                        <div class="flex items-center gap-3">
                                            <img src="<%= tour.hinh_anh_dai_dien || 'https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80' %>"
                                                alt="<%= tour.ten_tour %>"
                                                class="w-14 h-14 rounded-lg object-cover border border-white/5 shrink-0" />
                                            <div class="min-w-0">
                                                <p class="font-extrabold text-white text-base max-w-[400px] truncate flex items-center gap-1.5"
                                                    title="<%= tour.ten_tour %>">
                                                    <% if (tour.la_noi_bat) { %>
                                                        <i data-lucide="star"
                                                            class="w-4 h-4 text-yellow-500 fill-yellow-500 shrink-0"
                                                            title="Tour nổi bật"></i>
                                                        <% } %>
                                                            <span>
                                                                <%= tour.ten_tour %>
                                                            </span>
                                                </p>
                                                <p
                                                    class="text-[11px] text-brand-muted mt-1.5 flex items-center gap-x-2.5 flex-wrap font-semibold">
                                                    <span class="flex items-center gap-1">
                                                        <i data-lucide="users"
                                                            class="w-3.5 h-3.5 text-brand-accent"></i>
                                                        <span>Tối đa <%= tour.so_nguoi_toi_da %> khách</span>
                                                    </span>
                                                    <span class="text-white/10">•</span>
                                                    <span class="flex items-center gap-1">
                                                        <i data-lucide="clock"
                                                            class="w-3.5 h-3.5 text-brand-accent"></i>
                                                        <span>
                                                            <%= tour.thoi_gian %>
                                                        </span>
                                                    </span>
                                                </p>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="py-4 px-4 text-slate-300 font-bold">
                                        <%= catName %>
                                    </td>

                                    <td class="py-4 px-4 text-slate-300 font-bold">
                                        <%= locName %>
                                    </td>

                                    <td class="py-4 px-4 font-bold">
                                        <% if (tour.gia_khuyen_mai> 0) { %>
                                            <p class="text-brand-accent font-black text-base">
                                                <%= tour.gia_khuyen_mai.toLocaleString('vi-VN') %> đ
                                            </p>
                                            <% } else { %>
                                                <p class="text-white font-black text-base">
                                                    <%= tour.gia_nguoi_lon.toLocaleString('vi-VN') %> đ
                                                </p>
                                                <% } %>
                                    </td>

                                    <td class="py-4 px-4 text-slate-300 font-bold">
                                        <%= tour.diem_khoi_hanh %>
                                    </td>

                                    <!-- Status badge -->
                                    <td class="py-4 px-2 text-center w-px whitespace-nowrap">
                                        <% if (tour.trang_thai==='active' ) { %>
                                            <span class="inline-flex items-center justify-center p-1 bg-brand-emerald/10 text-brand-emerald rounded-full border border-brand-emerald/20" title="Hoạt động">
                                                <i data-lucide="check-circle" class="w-4 h-4"></i>
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center justify-center p-1 bg-red-500/10 text-red-400 rounded-full border border-red-500/20" title="Tạm khóa">
                                                <i data-lucide="lock" class="w-4 h-4"></i>
                                            </span>
                                        <% } %>
                                    </td>

                                    <!-- Actions trigger -->
                                    <td class="py-4 px-2 text-center w-px whitespace-nowrap">
                                        <div class="flex items-center justify-center gap-0.5">
                                            <a href="/admin/tours/<%= tour._id %>" title="Chỉnh sửa Tour"
                                                class="p-1 text-slate-400 hover:text-brand-accent hover:bg-brand-primary/10 rounded transition-all border border-transparent hover:border-brand-accent/20">
                                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                                            </a>
                                            <a href="/tour-details/<%= tour.ma_tour %>" target="_blank"
                                                title="Xem chi tiết client"
                                                class="p-1 text-slate-400 hover:text-brand-accent hover:bg-brand-primary/10 rounded transition-all border border-transparent hover:border-brand-accent/20">
                                                <i data-lucide="external-link" class="w-4 h-4"></i>
                                            </a>
                                            <button onclick="deleteTour('<%= tour._id %>', '<%= tour.ten_tour %>')"
                                                title="Xóa Tour"
                                                class="p-1 text-slate-400 hover:text-red-400 hover:bg-red-500/10 rounded transition-all border border-transparent hover:border-red-500/20 cursor-pointer">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="py-12 text-center text-brand-muted">
                                                Không tìm thấy dữ liệu Tours nào trong Cơ sở dữ liệu.
                                            </td>
                                        </tr>
                                        <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>



<!-- Frontend JavaScript controllers -->
<script>
    // Live Search input filter
    const searchInput = document.getElementById('tour-search-input');
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();
            document.querySelectorAll('.tour-row').forEach(row => {
                const text = row.getAttribute('data-search-text');
                if (!query || text.includes(query)) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
        });
    }
</script>

<!-- Safely pass server-side data to client script -->
<script id="tours-data" type="application/json">
    <%- JSON.stringify(data || []) %>
</script>

<script>
    const deleteTour = async (id, title) => {
        if (confirm(`Bạn có chắc chắn muốn xóa tour "${title}" không ?\nHành động này sẽ không thể hoàn tác.`)) {
            try {
                // Post fetch API delete request
                const res = await fetch(`/api/tours/delete/${id}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await res.json();

                if (result.success) {
                    showAdminToast("Đã xóa tour thành công!");
                    const row = document.getElementById(`tour-row-${id}`);
                    if (row) {
                        row.style.transition = 'all 0.5s ease';
                        row.style.opacity = '0';
                        row.style.transform = 'translateX(-20px)';
                        setTimeout(() => row.remove(), 500);
                    }
                } else {
                    alert("Lỗi: " + result.message);
                }
            } catch (err) {
                console.error(err);
                alert("Không thể xóa tour do lỗi kết nối.");
            }
        }
    };
</script>

<%- include('formCategoryPage') %>
    <%- include('formLocationPage') %>