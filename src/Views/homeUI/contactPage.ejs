<!-- Hero Header Section for Contact -->
<section class="relative min-h-[40vh] flex flex-col justify-center py-12 overflow-hidden">
    <!-- Cinematic Backdrop Image -->
    <div class="absolute inset-0 z-0">
        <img alt="Contact background cover" class="w-full h-full object-cover brightness-[0.25]"
            src="https://images.unsplash.com/photo-1516738901171-8eb4fc13bd20?auto=format&fit=crop&q=80&w=2000"
            referrerpolicy="no-referrer" />
        <div class="absolute inset-0 bg-gradient-to-b from-[#020e1f]/50 via-[#020e1f]/80 to-[#020e1f]"></div>
    </div>

    <!-- Outer Alignment Container -->
    <div class="max-w-screen-2xl mx-auto w-full px-4 md:px-8 z-10 flex flex-col items-center">
        <!-- Content Panel -->
        <div class="w-full max-w-4xl text-center">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 glass-panel rounded-full shadow-[0_0_15px_rgba(164,230,255,0.1)]">
                <i data-lucide="headset" class="w-4 h-4 text-brand-accent"></i>
                <span class="text-[10px] font-extrabold text-brand-accent uppercase tracking-widest">Hỗ Trợ 24/7</span>
            </div>

            <!-- Slogan -->
            <h1 class="text-4xl md:text-6xl font-black text-white leading-tight tracking-tight mb-6">
                Liên Hệ <span class="hero-gradient-text">Với TPVTravel</span>
            </h1>

            <p class="text-sm md:text-base text-brand-muted font-medium mb-10 max-w-2xl mx-auto opacity-90 leading-relaxed">
                Đội ngũ của chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn trong mọi thắc mắc và yêu cầu. Hãy để chúng tôi đồng hành cùng chuyến đi của bạn.
            </p>
        </div>
    </div>
</section>

<!-- Contact Form & Info Section -->
<section class="py-12 bg-[#020e1f] relative z-10 pb-24">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-8">
            
            <!-- Left: Contact Information Cards -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Decorative element -->
                <div class="mb-8">
                    <h2 class="text-2xl font-black text-white mb-2">Thông Tin <span class="text-brand-accent">Liên Hệ</span></h2>
                    <p class="text-brand-muted text-sm">Kết nối với chúng tôi qua các kênh dưới đây hoặc ghé thăm văn phòng trực tiếp.</p>
                </div>

                <div class="glass-panel p-6 rounded-3xl border border-white/10 hover:border-brand-accent/30 transition-colors flex items-start gap-4 group">
                    <div class="w-12 h-12 bg-brand-accent/10 rounded-full flex items-center justify-center shrink-0 group-hover:bg-brand-accent/20 transition-colors">
                        <i data-lucide="map-pin" class="w-6 h-6 text-brand-accent"></i>
                    </div>
                    <div>
                        <h4 class="text-white font-bold mb-1">Văn Phòng Đại Diện</h4>
                        <p class="text-brand-muted text-sm leading-relaxed">Số 1 Đại Cồ Việt, Phường Bách Khoa, Quận Hai Bà Trưng, Hà Nội</p>
                    </div>
                </div>

                <div class="glass-panel p-6 rounded-3xl border border-white/10 hover:border-brand-accent/30 transition-colors flex items-start gap-4 group">
                    <div class="w-12 h-12 bg-brand-accent/10 rounded-full flex items-center justify-center shrink-0 group-hover:bg-brand-accent/20 transition-colors">
                        <i data-lucide="phone-call" class="w-6 h-6 text-brand-accent"></i>
                    </div>
                    <div>
                        <h4 class="text-white font-bold mb-1">Hotline Đặt Tour</h4>
                        <p class="text-brand-accent font-black text-lg">1900 6789</p>
                        <p class="text-brand-muted text-xs mt-1">Hỗ trợ tư vấn trực tuyến 24/7</p>
                    </div>
                </div>

                <div class="glass-panel p-6 rounded-3xl border border-white/10 hover:border-brand-accent/30 transition-colors flex items-start gap-4 group">
                    <div class="w-12 h-12 bg-brand-accent/10 rounded-full flex items-center justify-center shrink-0 group-hover:bg-brand-accent/20 transition-colors">
                        <i data-lucide="mail" class="w-6 h-6 text-brand-accent"></i>
                    </div>
                    <div>
                        <h4 class="text-white font-bold mb-1">Email Hỗ Trợ</h4>
                        <p class="text-brand-muted text-sm leading-relaxed">hotro@tpvtravel.vn</p>
                        <p class="text-brand-muted text-sm leading-relaxed">doitac@tpvtravel.vn</p>
                    </div>
                </div>
            </div>

            <!-- Right: Contact Form -->
            <div class="lg:col-span-3">
                <div class="glass-panel p-8 md:p-12 rounded-3xl border border-white/10 shadow-2xl relative overflow-hidden">
                    <div class="absolute -top-32 -right-32 w-64 h-64 bg-brand-accent/10 blur-[100px] rounded-full pointer-events-none"></div>

                    <h3 class="text-2xl font-black text-white mb-8 relative z-10">Gửi Tin Nhắn Cho Chúng Tôi</h3>
                    
                    <form action="#" method="POST" class="space-y-6 relative z-10">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="text-xs font-bold text-brand-muted uppercase tracking-wider">Họ và tên <span class="text-red-500">*</span></label>
                                <input type="text" name="ho_ten" required placeholder="Nguyễn Văn A" 
                                    class="w-full px-4 py-3 bg-[#020e1f]/50 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-brand-accent transition-all placeholder:text-white/20" />
                            </div>
                            <div class="space-y-2">
                                <label class="text-xs font-bold text-brand-muted uppercase tracking-wider">Số điện thoại <span class="text-red-500">*</span></label>
                                <input type="tel" name="so_dien_thoai" required placeholder="0987.xxx.xxx" 
                                    class="w-full px-4 py-3 bg-[#020e1f]/50 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-brand-accent transition-all placeholder:text-white/20" />
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="text-xs font-bold text-brand-muted uppercase tracking-wider">Địa chỉ Email</label>
                            <input type="email" name="email" placeholder="example@email.com" 
                                class="w-full px-4 py-3 bg-[#020e1f]/50 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-brand-accent transition-all placeholder:text-white/20" />
                        </div>

                        <div class="space-y-2">
                            <label class="text-xs font-bold text-brand-muted uppercase tracking-wider">Tiêu đề <span class="text-red-500">*</span></label>
                            <input type="text" name="tieu_de" required placeholder="Bạn cần hỗ trợ vấn đề gì?" 
                                class="w-full px-4 py-3 bg-[#020e1f]/50 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-brand-accent transition-all placeholder:text-white/20" />
                        </div>

                        <div class="space-y-2">
                            <label class="text-xs font-bold text-brand-muted uppercase tracking-wider">Nội dung <span class="text-red-500">*</span></label>
                            <textarea name="noi_dung" required rows="5" placeholder="Chi tiết yêu cầu của bạn..." 
                                class="w-full px-4 py-3 bg-[#020e1f]/50 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-brand-accent transition-all placeholder:text-white/20 resize-none"></textarea>
                        </div>

                        <button type="button" onclick="alert('Đã gửi thông tin liên hệ thành công! Chúng tôi sẽ phản hồi sớm nhất.')" 
                            class="w-full py-4 bg-brand-accent text-brand-dark rounded-xl font-black text-sm uppercase tracking-widest hover:bg-brand-primary transition-all active:scale-95 shadow-[0_0_20px_rgba(164,230,255,0.2)]">
                            Gửi Yêu Cầu
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Team / Staff Section -->
<section class="py-12 bg-brand-dark/40 relative z-10 border-t border-white/5 pb-24">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8">
        <div class="mb-12 text-center">
            <div class="inline-flex items-center gap-2 px-4 py-2 mb-4 glass-panel rounded-full">
                <span class="w-2 h-2 bg-brand-accent rounded-full animate-ping"></span>
                <span class="text-[10px] font-extrabold text-brand-accent uppercase tracking-widest">Gặp Gỡ Chuyên Gia</span>
            </div>
            <h2 class="text-2xl md:text-4xl font-black text-white mb-4">Đội Ngũ <span class="text-brand-accent">Chuyên Viên</span></h2>
            <p class="text-brand-muted text-sm max-w-2xl mx-auto leading-relaxed">Chúng tôi tự hào với đội ngũ chuyên viên tận tâm, luôn sẵn lòng tư vấn nhiệt tình và mang đến trải nghiệm du lịch tuyệt vời nhất cho bạn.</p>
        </div>

        <% if (data && data.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
                <% data.forEach(staff => { %>
                    <div class="glass-panel p-6 md:p-8 rounded-3xl border border-white/10 hover:border-brand-accent/30 hover:-translate-y-2 hover:shadow-[0_15px_30px_-15px_rgba(164,230,255,0.15)] transition-all duration-300 group flex flex-col items-center text-center relative overflow-hidden">
                        
                        <div class="absolute -top-10 -right-10 w-32 h-32 bg-brand-accent/5 blur-[50px] rounded-full pointer-events-none transition-all group-hover:bg-brand-accent/10"></div>

                        <div class="w-24 h-24 bg-[#020e1f] rounded-full p-1.5 mb-5 border border-white/10 group-hover:border-brand-accent/50 transition-colors relative z-10 shadow-xl">
                            <div class="w-full h-full bg-brand-accent/5 group-hover:bg-brand-accent/20 rounded-full flex items-center justify-center text-brand-accent overflow-hidden transition-colors">
                                <i data-lucide="user" class="w-10 h-10 opacity-80"></i>
                            </div>
                        </div>
                        <h4 class="text-white font-black text-lg mb-1.5 group-hover:text-brand-accent transition-colors relative z-10"><%= staff.ho_ten %></h4>
                        <p class="text-brand-accent text-[10px] font-extrabold uppercase tracking-widest mb-6 relative z-10"><%= staff.tieu_de || 'Chuyên viên tư vấn' %></p>
                        
                        <div class="w-full space-y-3 mt-auto pt-6 border-t border-white/5 relative z-10">
                            <a href="tel:<%= staff.so_dien_thoai %>" class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-brand-accent hover:text-[#020e1f] text-white text-xs font-bold transition-colors">
                                <i data-lucide="phone" class="w-4 h-4"></i>
                                <span><%= staff.so_dien_thoai %></span>
                            </a>
                            <a href="mailto:<%= staff.email %>" class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-brand-accent hover:text-[#020e1f] text-white text-xs font-bold transition-colors">
                                <i data-lucide="mail" class="w-4 h-4"></i>
                                <span class="line-clamp-1"><%= staff.email %></span>
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <!-- No staff available -->
            <div class="text-center py-16 glass-panel rounded-3xl border border-white/10 max-w-lg mx-auto shadow-2xl relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-brand-accent/5 to-transparent opacity-50"></div>
                <i data-lucide="users" class="w-12 h-12 text-brand-accent mx-auto mb-4 opacity-50 relative z-10"></i>
                <h4 class="text-white font-black text-lg mb-2 relative z-10">Chưa có dữ liệu chuyên viên</h4>
                <p class="text-brand-muted text-sm relative z-10">Danh sách nhân sự đang được hệ thống cập nhật.</p>
            </div>
        <% } %>
    </div>
</section>

<!-- Re-initialize icons -->
<script>
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>