<div class="max-w-screen-2xl mx-auto px-4 md:px-8 py-12">

  <!-- Header Banner -->
  <div class="mb-10 text-left">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-accent/10 border border-brand-accent/20 text-brand-accent text-xs font-bold uppercase tracking-wider mb-3">
      <i data-lucide="home" class="w-3.5 h-3.5"></i>
      <span>Danh mục phòng trọ</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-black text-white tracking-tight">Tìm Kiếm Phòng Trọ Phù Hợp</h1>
    <p class="text-xs text-brand-muted mt-1">Danh sách tất cả các phòng trọ khép kín, căn hộ studio, ký túc xá chất lượng cao</p>
  </div>

  <!-- Filter & Search Panel -->
  <div class="glass-panel p-6 rounded-3xl mb-10 border border-white/10 text-left">
    <form action="/rooms" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
      
      <!-- Category Filter -->
      <div>
        <label class="block text-[11px] font-bold text-brand-muted uppercase tracking-wider mb-1.5">Loại phòng</label>
        <div class="relative">
          <select name="ma_danh_muc" class="w-full bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-accent appearance-none cursor-pointer">
            <option value="" class="bg-slate-900 text-white">Tất cả loại phòng</option>
            <% category.forEach(cat => { %>
              <option value="<%= cat.ma_danh_muc %>" <%= filter.ma_danh_muc === cat.ma_danh_muc ? 'selected' : '' %> class="bg-slate-900 text-white"><%= cat.ten_danh_muc %></option>
            <% }) %>
          </select>
          <i data-lucide="chevron-down" class="w-4 h-4 text-brand-muted absolute right-3 top-3 pointer-events-none"></i>
        </div>
      </div>

      <!-- Location Filter -->
      <div>
        <label class="block text-[11px] font-bold text-brand-muted uppercase tracking-wider mb-1.5">Khu vực</label>
        <div class="relative">
          <select name="ma_dia_diem" class="w-full bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-accent appearance-none cursor-pointer">
            <option value="" class="bg-slate-900 text-white">Tất cả khu vực</option>
            <% location.forEach(loc => { %>
              <option value="<%= loc.ma_dia_diem %>" <%= filter.ma_dia_diem === loc.ma_dia_diem ? 'selected' : '' %> class="bg-slate-900 text-white"><%= loc.ten_dia_diem %></option>
            <% }) %>
          </select>
          <i data-lucide="chevron-down" class="w-4 h-4 text-brand-muted absolute right-3 top-3 pointer-events-none"></i>
        </div>
      </div>

      <!-- Max Price Filter -->
      <div>
        <label class="block text-[11px] font-bold text-brand-muted uppercase tracking-wider mb-1.5">Mức giá thuê</label>
        <div class="relative">
          <select name="gia_max" class="w-full bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-brand-accent appearance-none cursor-pointer">
            <option value="" class="bg-slate-900 text-white">Tất cả mức giá</option>
            <option value="2000000" <%= filter.gia_max === '2000000' ? 'selected' : '' %> class="bg-slate-900 text-white">Dưới 2 Triệu/tháng</option>
            <option value="4000000" <%= filter.gia_max === '4000000' ? 'selected' : '' %> class="bg-slate-900 text-white">Dưới 4 Triệu/tháng</option>
            <option value="6000000" <%= filter.gia_max === '6000000' ? 'selected' : '' %> class="bg-slate-900 text-white">Dưới 6 Triệu/tháng</option>
            <option value="10000000" <%= filter.gia_max === '10000000' ? 'selected' : '' %> class="bg-slate-900 text-white">Dưới 10 Triệu/tháng</option>
          </select>
          <i data-lucide="chevron-down" class="w-4 h-4 text-brand-muted absolute right-3 top-3 pointer-events-none"></i>
        </div>
      </div>

      <!-- Submit & Reset Buttons -->
      <div class="flex items-end gap-2">
        <button type="submit" class="flex-1 bg-brand-accent hover:bg-brand-primary text-brand-dark font-black py-2.5 px-4 rounded-xl transition-all shadow-lg flex items-center justify-center gap-2 text-xs">
          <i data-lucide="filter" class="w-4 h-4"></i>
          <span>Lọc phòng</span>
        </button>
        <a href="/rooms" class="p-2.5 bg-white/5 hover:bg-white/10 text-brand-muted hover:text-white border border-white/10 rounded-xl transition-all" title="Bỏ lọc">
          <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
        </a>
      </div>

    </form>
  </div>

  <!-- Room Grid List -->
  <% if (data && data.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% data.forEach(room => { 
        const roomLoc = location.find(l => l.ma_dia_diem === room.ma_dia_diem) || {};
        const roomCat = category.find(c => c.ma_danh_muc === room.ma_danh_muc) || {};
      %>
        <div class="glass-panel rounded-3xl overflow-hidden border border-white/10 hover:border-brand-accent/40 transition-all duration-300 shadow-xl flex flex-col group text-left">
          <!-- Thumbnail -->
          <div class="relative aspect-[16/10] overflow-hidden">
            <img src="<%= room.hinh_anh_dai_dien %>" alt="<%= room.ten_phong %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute top-3 left-3 px-3 py-1 bg-black/60 backdrop-blur-md rounded-full border border-white/10 text-[10px] font-bold text-brand-accent uppercase">
              <%= roomCat.ten_danh_muc || 'Phòng trọ' %>
            </div>
            <% if (room.la_noi_bat) { %>
              <div class="absolute top-3 right-3 px-2.5 py-1 bg-red-500 text-white rounded-full text-[10px] font-black uppercase shadow-lg flex items-center gap-1">
                <i data-lucide="star" class="w-3 h-3 fill-white"></i> HOT
              </div>
            <% } %>
          </div>

          <!-- Details -->
          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center gap-2 text-xs text-brand-accent font-semibold mb-1">
                <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
                <span><%= roomLoc.ten_dia_diem || 'TP.HCM' %></span>
                <% if (room.dien_tich) { %>
                  <span class="text-white/40">•</span>
                  <i data-lucide="maximize" class="w-3.5 h-3.5 text-brand-muted"></i>
                  <span class="text-brand-muted"><%= room.dien_tich %> m²</span>
                <% } %>
              </div>

              <h3 class="text-base font-bold text-white group-hover:text-brand-accent transition-colors line-clamp-2 leading-snug">
                <a href="/room-details/<%= room.ma_phong %>"><%= room.ten_phong %></a>
              </h3>

              <p class="text-xs text-brand-muted line-clamp-2 mt-2 leading-relaxed opacity-80">
                <%= room.mo_ta_ngan %>
              </p>
            </div>

            <!-- Amenities Badges Preview -->
            <% if (room.tien_nghi && room.tien_nghi.length > 0) { %>
              <div class="flex flex-wrap gap-1.5 pt-2 border-t border-white/5">
                <% room.tien_nghi.slice(0, 3).forEach(item => { %>
                  <span class="px-2 py-0.5 bg-white/5 text-brand-muted rounded-md text-[10px] font-medium border border-white/5">
                    <%= item %>
                  </span>
                <% }) %>
                <% if (room.tien_nghi.length > 3) { %>
                  <span class="px-2 py-0.5 bg-white/5 text-brand-muted rounded-md text-[10px] font-medium">
                    +<%= room.tien_nghi.length - 3 %>
                  </span>
                <% } %>
              </div>
            <% } %>

            <!-- Footer Price & Action -->
            <div class="flex items-center justify-between pt-4 border-t border-white/10">
              <div>
                <span class="text-[10px] text-brand-muted uppercase font-bold tracking-wider">Giá thuê</span>
                <p class="text-lg font-black text-brand-accent">
                  <%= room.gia_thue.toLocaleString('vi-VN') %> <span class="text-xs font-normal text-white/70">đ/tháng</span>
                </p>
              </div>

              <a href="/room-details/<%= room.ma_phong %>" class="px-4 py-2 bg-brand-accent/15 hover:bg-brand-accent text-brand-accent hover:text-brand-dark rounded-xl text-xs font-bold transition-all border border-brand-accent/30 flex items-center gap-1.5">
                <span>Xem chi tiết</span>
                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="glass-panel p-16 rounded-3xl text-center space-y-4 max-w-lg mx-auto border border-white/10">
      <div class="w-16 h-16 rounded-full bg-brand-accent/10 flex items-center justify-center text-brand-accent mx-auto">
        <i data-lucide="search-x" class="w-8 h-8"></i>
      </div>
      <h3 class="text-xl font-bold text-white">Không tìm thấy phòng trọ phù hợp</h3>
      <p class="text-xs text-brand-muted">Vui lòng thử lại với các tiêu chí tìm kiếm khác hoặc xóa bộ lọc để xem toàn bộ danh sách phòng trọ.</p>
      <a href="/rooms" class="inline-flex items-center gap-2 px-6 py-2.5 bg-brand-accent text-brand-dark font-bold text-xs rounded-xl hover:bg-brand-primary transition-all">
        <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
        <span>Xóa bộ lọc</span>
      </a>
    </div>
  <% } %>

</div>
