                          </span>
                          <span class="text-brand-muted font-medium text-[11px] line-through decoration-red-500/50">
                            ${pkg.originalPrice.toLocaleString('vi-VN')} đ
                          </span>
                        </div>

                        <button 
                          onclick="openBookingModal('${pkg.id}')"
