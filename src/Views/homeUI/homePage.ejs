<section class="py-24 bg-brand-dark border-t border-white/5" id="tours-3d-section">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8 overflow-hidden">

        <div class="text-center mb-12 flex flex-col items-center justify-center">
            <p
                class="text-brand-accent font-extrabold text-xs md:text-sm tracking-wider mb-2 flex items-center gap-1.5 justify-center">
                <i data-lucide="box" class="w-4 h-4"></i>
                <span>Không Gian 3D</span>
            </p>
            <h2 class="text-3xl md:text-5xl font-black text-white tracking-wide">Tours Nổi Bật</h2>
        </div>

        <style>
            .scene-3d {
                perspective: 1200px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .stage-3d {
                transform-style: preserve-3d;
                will-change: transform;
                transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
            }

            .carousel-3d-card {
                position: absolute;
                left: 50%;
                top: 50%;
                margin-left: -140px;
                /* -half of width */
                margin-top: -190px;
                /* -half of height */
                width: 280px;
                height: 380px;
                transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.8s ease, border-color 0.8s ease, box-shadow 0.8s ease;
                transform-style: preserve-3d;
            }

            .tilt-card-inner {
                width: 100%;
                height: 100%;
                transform-style: preserve-3d;
                transition: transform 0.2s ease-out;
            }
        </style>

        <!-- 3D Carousel container with left/right arrows -->
        <div class="relative w-full max-w-4xl mx-auto h-[480px] flex items-center justify-center overflow-visible mb-6">
            <!-- Left Arrow Button -->
            <button onclick="prev3D()"
                class="absolute left-0 md:left-4 z-30 w-12 h-12 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-white flex items-center justify-center hover:scale-110 active:scale-95 transition-all cursor-pointer shadow-lg backdrop-blur-md">
                <i data-lucide="chevron-left" class="w-6 h-6"></i>
            </button>

            <!-- 3D Scene -->
            <div class="w-full h-full scene-3d overflow-visible">
                <!-- 3D Stage (rotates dynamically) -->
                <div id="stage-3d" class="w-[300px] h-[380px] stage-3d relative" data-tours-3d='<%- JSON.stringify(tour_noi_bat.map(t => {
                    let originalPrice = t.gia_nguoi_lon || 0;
                    let currentPrice = t.gia_khuyen_mai && t.gia_khuyen_mai > 0 ? t.gia_khuyen_mai : originalPrice;
                    let foundLoc = location.find(l => l.ma_dia_diem === t.ma_dia_diem) || {};
                    return {
                        id: t.ma_tour,
                        location: foundLoc.tinh_thanh || "Việt Nam",
                        title: t.ten_tour,
                        duration: t.thoi_gian,
                        price: currentPrice.toLocaleString("vi-VN") + " đ",
                        rating: "4.8",
                        image: t.hinh_anh_dai_dien
                    };
                })) %>'>
                    <!-- 4 Cards populated dynamically by JS -->
                    <% tour_noi_bat.forEach((tour, idx)=> {
                        let tourLoc = location.find(l => l.ma_dia_diem === tour.ma_dia_diem) || {};
                        let tourPrice = (tour.gia_khuyen_mai && tour.gia_khuyen_mai > 0 ? tour.gia_khuyen_mai :
                        (tour.gia_nguoi_lon || 0)).toLocaleString('vi-VN') + ' đ';
                        %>
                        <div id="card-3d-<%= idx %>" class="carousel-3d-card rounded-3xl cursor-pointer">
                            <div
                                class="tilt-card-inner w-full h-full bg-slate-900/80 border border-white/10 rounded-3xl p-4 flex flex-col justify-between shadow-xl">
                                <!-- Top Image with Rating overlay -->
                                <div class="relative w-full h-[180px] rounded-2xl overflow-hidden mb-4">
                                    <img src="<%= tour.hinh_anh_dai_dien %>" alt="<%= tour.ten_tour %>"
                                        class="w-full h-full object-cover" />
                                    <div
                                        class="absolute top-3 right-3 bg-black/50 backdrop-blur-md px-2.5 py-1 rounded-full flex items-center gap-1 border border-white/10 text-white text-[10px] font-bold">
                                        <i data-lucide="star" class="w-3 h-3 fill-yellow-500 text-yellow-500"></i>
                                        <span>4.8</span>
                                    </div>
                                </div>

                                <!-- Details -->
                                <div class="space-y-2 flex-1 flex flex-col justify-between">
                                    <div class="space-y-1 text-left">
                                        <div
                                            class="flex items-center gap-1 text-[10px] font-bold text-blue-400 uppercase">
                                            <i data-lucide="map-pin" class="w-3 h-3"></i>
                                            <span>
                                                <%= tourLoc.tinh_thanh %>
                                            </span>
                                        </div>
                                        <h4 class="text-sm font-black text-white leading-snug line-clamp-2">
                                            <%= tour.ten_tour %>
                                        </h4>
                                    </div>

                                    <div class="pt-3 border-t border-white/5 flex items-center justify-between">
                                        <div class="text-[10px] text-brand-muted flex items-center gap-1 font-bold">
                                            <i data-lucide="calendar" class="w-3 h-3"></i>
                                            <span>
                                                <%= tour.thoi_gian %>
                                            </span>
                                        </div>
                                        <div class="text-right">
                                            <p class="text-[8px] text-brand-muted uppercase">Từ</p>
                                            <p class="text-xs font-black text-blue-400">
                                                <%= tourPrice %>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>

            <!-- Right Arrow Button -->
            <button onclick="next3D()"
                class="absolute right-0 md:right-4 z-30 w-12 h-12 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-white flex items-center justify-center hover:scale-110 active:scale-95 transition-all cursor-pointer shadow-lg backdrop-blur-md">
                <i data-lucide="chevron-right" class="w-6 h-6"></i>
            </button>
        </div>

        <!-- Pagination indicators -->
        <div class="flex items-center justify-center gap-3 mt-10 mb-8">
            <div class="flex items-center gap-2" id="dots-3d-container">
                <!-- Dots populated by JS -->
            </div>
        </div>

        <!-- Bottom Showcase Box -->
        <div id="showcase-3d-panel"
            class="bg-white text-slate-800 rounded-3xl p-6 md:p-8 max-w-2xl mx-auto shadow-2xl transition-all duration-500 border border-slate-100">
        </div>

    </div>
</section>

