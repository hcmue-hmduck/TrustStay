<div class="w-full space-y-6">
    <!-- Premium Header Banner -->
    <div class="relative overflow-hidden rounded-3xl glass-card p-6 md:p-8 border border-white/5 shadow-2xl">
        <div class="absolute -right-10 -top-10 w-40 h-40 bg-brand-accent/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-brand-primary/10 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <a href="/admin/tours"
                    class="inline-flex items-center justify-center p-2.5 bg-slate-900 border border-white/10 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 transition-all">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                </a>
                <div>
                    <h1 class="text-2xl font-black text-white neon-text-glow">
                        <%= (data && data.ma_tour) ? 'Chỉnh Sửa Tour' : 'Tạo Tour Mới' %>
                    </h1>
                    <p class="text-xs text-brand-muted mt-1 font-semibold">
                        <%= (data && data.ma_tour) ? 'Cập nhật thông tin chi tiết cho Tour #' + data.ma_tour
                            : 'Nhập thông tin để thêm Tour mới vào hệ thống' %>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Section -->
    <form id="tour-form" class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
            <!-- Left Side: Main Form Fields (60% - lg:col-span-3) -->
            <div class="lg:col-span-3 space-y-6">
                <!-- General Info Card -->
                <div class="glass-card p-6 rounded-2xl space-y-4">
                    <h3
                        class="text-sm font-extrabold text-brand-accent uppercase tracking-wider flex items-center gap-2">
                        <i data-lucide="info" class="w-4.5 h-4.5"></i>
                        <span>Thông Tin Cơ Bản</span>
                    </h3>

                    <!-- Tour Name (ten_tour) -->
                    <div class="space-y-1.5">
                        <input type="text" name="ma_tour" hidden value="<%= data ? data.ma_tour : '' %>">
                        <input type="hidden" name="hinh_anh_dai_dien" id="hinh-anh-dai-dien-input"
                            value="<%= data ? data.hinh_anh_dai_dien : '' %>">
                        <label class="block text-xs font-bold text-slate-300">Tên Tour <span
                                class="text-red-500">*</span></label>
                        <input type="text" name="ten_tour" required placeholder="Ví dụ: Tour Sapa 3 Ngày 2 Đêm"
                            value="<%= data ? data.ten_tour : '' %>"
                            class="w-full px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr_auto_auto] gap-4">
                        <!-- Category Code (ma_danh_muc) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">Danh Mục <span
                                    class="text-red-500">*</span></label>
                            <select name="ma_danh_muc" required
                                class="w-full px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold">
                                <option value="" disabled <%=!data ? 'selected' : '' %>>-- Chọn danh mục --</option>
                                <% if (category && category.length> 0) { %>
                                    <% category.forEach(cat=> { %>
                                        <option value="<%= cat.ma_danh_muc %>" <%=(data &&
                                            data.ma_danh_muc===cat.ma_danh_muc ) ? 'selected' : '' %>> <%=
                                                cat.ten_danh_muc %>
                                        </option>
                                        <% }) %>
                                            <% } %>
                            </select>
                        </div>

                        <!-- Location Code (ma_dia_diem) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">Địa Điểm <span
                                    class="text-red-500">*</span></label>
                            <select name="ma_dia_diem" required
                                class="w-full px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold">
                                <option value="" disabled <%=!data ? 'selected' : '' %>>-- Chọn địa điểm --</option>
                                <% if (location && location.length> 0) { %>
                                    <% location.forEach(loc=> { %>
                                        <option value="<%= loc.ma_dia_diem %>" <%=(data &&
                                            data.ma_dia_diem===loc.ma_dia_diem ) ? 'selected' : '' %>> <%=
                                                loc.ten_dia_diem %>
                                        </option>
                                        <% }) %>
                                            <% } %>
                            </select>
                        </div>

                        <!-- Featured Toggle -->
                        <div class="space-y-1.5 flex flex-col justify-start">
                            <label class="block text-xs font-bold text-slate-300">Nổi Bật</label>
                            <div class="flex items-center gap-3 pt-2">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" name="la_noi_bat" value="true" class="sr-only peer" <%=(data
                                        && data.la_noi_bat) ? 'checked' : '' %> />
                                    <div
                                        class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-400 after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500 peer-checked:after:bg-slate-950">
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Status Toggle -->
                        <div class="space-y-1.5 flex flex-col justify-start">
                            <label class="block text-xs font-bold text-slate-300">Trạng Thái <span
                                    class="text-red-500">*</span></label>
                            <div class="flex items-center gap-3 pt-2">
                                <input type="hidden" name="trang_thai" id="trang_thai_input"
                                    value="<%= (data && data.trang_thai) ? data.trang_thai : 'active' %>" />
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" class="sr-only peer" <%=(!data || data.trang_thai==='active'
                                        ) ? 'checked' : '' %>
                                    onchange="
                                    document.getElementById('trang_thai_input').value = this.checked ? 'active' :
                                    'inactive';
                                    const textEl = document.getElementById('trang_thai_text');
                                    textEl.innerText = this.checked ? 'Hoạt Động' : 'Tạm Khóa';
                                    if(this.checked) { textEl.classList.add('text-emerald-400');
                                    textEl.classList.remove('text-slate-500'); }
                                    else { textEl.classList.remove('text-emerald-400');
                                    textEl.classList.add('text-slate-500'); }
                                    "
                                    />
                                    <div
                                        class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-400 after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-accent peer-checked:after:bg-slate-950">
                                    </div>
                                </label>
                                <span id="trang_thai_text"
                                    class="text-xs font-bold <%= (!data || data.trang_thai === 'active') ? 'text-emerald-400' : 'text-slate-500' %>">
                                    <%= (!data || data.trang_thai==='active' ) ? 'Hoạt Động' : 'Tạm Khóa' %>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Short Description -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-300">Mô Tả Ngắn</label>
                        <textarea name="mo_ta_ngan" rows="3" placeholder="Tóm tắt ngắn gọn nội dung nổi bật của tour..."
                            class="w-full px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold resize-none"><%= data ? data.mo_ta_ngan : '' %></textarea>
                    </div>

                    <!-- Detailed Description -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-300">Mô Tả Chi Tiết</label>
                        <textarea name="mo_ta_chi_tiet" rows="6"
                            placeholder="Thông tin lịch trình, các hoạt động cụ thể..."
                            class="w-full px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold resize-none"><%= data ? data.mo_ta_chi_tiet : '' %></textarea>
                    </div>
                </div>

                <!-- Display Settings -->
                <div class="glass-card p-6 rounded-2xl space-y-4">
                    <h3
                        class="text-sm font-extrabold text-brand-accent uppercase tracking-wider flex items-center gap-2">
                        <i data-lucide="image" class="w-4.5 h-4.5"></i>
                        <span>Hình Ảnh</span>
                    </h3>

                    <!-- Image File Upload -->
                    <div class="space-y-2">
                        <label class="block text-xs font-bold text-slate-300">Hình Đại Diện Tour</label>

                        <div class="flex items-center gap-3">
                            <input type="file" id="image-upload-input" accept="image/*" class="hidden" />
                            <button type="button" onclick="document.getElementById('image-upload-input').click()"
                                class="px-4 py-2.5 bg-slate-900 border border-white/10 text-slate-300 hover:text-white hover:bg-white/5 rounded-xl text-xs font-extrabold transition-all flex items-center gap-2 cursor-pointer">
                                <i data-lucide="upload-cloud" class="w-4.5 h-4.5"></i>
                                <span>Tải Ảnh Lên</span>
                            </button>
                            <span id="upload-file-name"
                                class="text-[10px] text-brand-muted font-semibold truncate max-w-[150px]">
                                <%= data && data.hinh_anh_dai_dien ? 'Đã có ảnh đại diện' : 'Chưa chọn file' %>
                            </span>
                        </div>
                    </div>

                    <!-- Image Preview area -->
                    <div class="space-y-1.5">
                        <div class="flex flex-col gap-1 mb-2">
                            <label class="block text-xs font-bold text-slate-300">Xem Trước Hình Ảnh</label>
                        </div>
                        <div
                            class="w-full aspect-[21/9] rounded-xl border border-white/5 bg-slate-950/80 overflow-hidden flex items-center justify-center relative shadow-inner">
                            <img id="image-preview"
                                src="<%= (data && data.hinh_anh_dai_dien) ? data.hinh_anh_dai_dien : 'https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80' %>"
                                alt="Preview image" class="w-full h-full object-cover" />
                        </div>
                    </div>
                </div>

                <!-- Schedule Builder (TourSchedule) -->
                <div class="glass-card p-6 rounded-2xl space-y-4">
                    <div class="flex items-center justify-between">
                        <h3
                            class="text-sm font-extrabold text-brand-accent uppercase tracking-wider flex items-center gap-2">
                            <i data-lucide="map" class="w-4.5 h-4.5"></i>
                            <span>Lịch Trình Chi Tiết</span>
                        </h3>
                        <button type="button" onclick="addScheduleDay()"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-primary/10 border border-brand-primary/30 rounded-lg text-[10px] font-bold text-brand-accent hover:bg-brand-primary/20 transition-all cursor-pointer">
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i>Thêm Ngày
                        </button>
                    </div>

                    <div id="schedule-container" class="space-y-4">
                        <!-- Dynamic Day Cards will be injected here via JS -->
                        <% if (tour_schedule && tour_schedule.length> 0) { %>
                            <% tour_schedule.forEach((sche, index)=> { %>
                                <div
                                    class="day-card bg-slate-950 border border-white/5 p-4 rounded-xl shadow-inner flex flex-col gap-4">
                                    <!-- Header Row -->
                                    <div class="flex items-center justify-between pb-3 border-b border-white/5">
                                        <h4 class="text-[11px] font-black text-white flex items-center gap-2"><span
                                                class="sched-ngay-thu px-2 py-0.5 bg-brand-accent/20 border border-brand-accent/30 text-brand-accent rounded text-[10px]">Ngày
                                                <%= sche.ngay_thu %></span></h4>
                                        <button type="button"
                                            onclick="this.closest('.day-card').remove(); syncScheduleToInput();"
                                            class="p-1.5 bg-red-500/10 text-red-400 hover:bg-red-500/20 rounded-lg transition-all"
                                            title="Xóa Ngày"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                                    </div>

                                    <!-- 2-Column Grid -->
                                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                                        <!-- Left Column: Basic Info -->
                                        <div class="space-y-3">
                                            <div>
                                                <input type="text" value="<%= sche.ma_lich_trinh %>"
                                                    class="sched-ma-lich-trinh" hidden />
                                            </div>
                                            <div>
                                                <label class="block text-[10px] font-bold text-slate-400 mb-1">Tiêu Đề
                                                    <span class="text-red-500">*</span></label>
                                                <input type="text" value="<%= sche.tieu_de %>"
                                                    oninput="syncScheduleToInput()"
                                                    placeholder="Ví dụ: Khởi hành Hà Nội - Sapa..."
                                                    class="sched-tieu-de w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white focus:border-brand-accent transition-all" />
                                            </div>

                                            <div>
                                                <label class="block text-[10px] font-bold text-slate-400 mb-1">Nội Dung
                                                    Chi Tiết</label>
                                                <textarea rows="3" oninput="syncScheduleToInput()"
                                                    placeholder="Mô tả chi tiết các hoạt động trong ngày..."
                                                    class="sched-noi-dung w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white focus:border-brand-accent transition-all resize-none"><%= sche.noi_dung %></textarea>
                                            </div>

                                            <div class="grid grid-cols-2 gap-3">
                                                <div>
                                                    <label class="block text-[10px] font-bold text-slate-400 mb-1">Bữa
                                                        Ăn</label>
                                                    <input type="text" value="<%= sche.bua_an %>"
                                                        oninput="syncScheduleToInput()" placeholder="Sáng, Trưa..."
                                                        class="sched-bua-an w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white" />
                                                </div>
                                                <div>
                                                    <label class="block text-[10px] font-bold text-slate-400 mb-1">Khách
                                                        Sạn</label>
                                                    <input type="text" value="<%= sche.khach_san %>"
                                                        oninput="syncScheduleToInput()" placeholder="Khách sạn 4 sao..."
                                                        class="sched-khach-san w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white" />
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Right Column: Địa điểm tham quan -->
                                        <div class="space-y-3 lg:border-l lg:border-white/5 lg:pl-6">
                                            <div class="flex items-center justify-between">
                                                <label class="block text-[10px] font-bold text-brand-emerald">Địa Điểm
                                                    Tham Quan</label>
                                                <button type="button" onclick="addScheduleLocation(this)"
                                                    class="inline-flex items-center gap-1.5 px-2 py-1 bg-brand-emerald/10 border border-brand-emerald/30 rounded-lg text-[9px] font-bold text-brand-emerald hover:bg-brand-emerald/20 transition-all cursor-pointer">
                                                    <i data-lucide="plus" class="w-3 h-3"></i>Thêm
                                                </button>
                                            </div>
                                            <div
                                                class="sched-loc-container space-y-2 max-h-[220px] overflow-y-auto pr-1">
                                                <% (sche.dia_diem_tham_quan && sche.dia_diem_tham_quan.length> 0 ?
                                                    sche.dia_diem_tham_quan : ['']).forEach((loc, locIndex)=> { %>
                                                    <div class="flex items-center gap-2">
                                                        <input type="text" value="<%=loc%>"
                                                            oninput="syncScheduleToInput()"
                                                            placeholder="Tên địa điểm..."
                                                            class="sched-loc flex-1 px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white focus:outline-none focus:border-brand-emerald transition-all font-semibold" />
                                                        <button type="button" onclick="removeScheduleLocation(this)"
                                                            class="p-2 bg-red-500/10 border border-red-500/20 rounded-lg text-red-400 hover:bg-red-500/20 transition-all cursor-pointer"><i
                                                                data-lucide="x" class="w-3 h-3"></i></button>
                                                    </div>
                                                    <% }) %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div
                                            class="text-center py-6 text-xs text-slate-500 italic border border-dashed border-white/10 rounded-xl">
                                            Chưa có lịch trình nào. Hãy bấm "Thêm Ngày" để bắt đầu.</div>
                                        <% } %>

                    </div>
                    <!-- Data storage for submission -->
                    <textarea name="lich_trinh_chi_tiet" id="lich-trinh-input" class="hidden"><%= tour_schedule.length > 0 ? JSON.stringify(tour_schedule) : '[]' %></textarea>
                </div>
            </div>

            <!-- Right Side: Details & Pricing / Image & Status (40% - lg:col-span-2) -->
            <div class="lg:col-span-2 space-y-6">
                <div class="grid grid-cols-2 gap-4">
                    <!-- Meta/Timing Settings -->
                    <div class="glass-card p-4 rounded-2xl space-y-4">
                        <h3
                            class="text-sm font-extrabold text-brand-accent uppercase tracking-wider flex items-center gap-2">
                            <i data-lucide="calendar-days" class="w-4.5 h-4.5"></i>
                            <span>Thiết Lập Lịch Trình</span>
                        </h3>

                        <!-- Duration (thoi_gian) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">Thời Gian</label>
                            <input type="text" name="thoi_gian" placeholder="Ví dụ: 3 ngày 2 đêm"
                                value="<%= data ? data.thoi_gian : '' %>"
                                class="w-full px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                        </div>

                        <!-- Departure Point (diem_khoi_hanh) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">Điểm Khởi Hành</label>
                            <input type="text" name="diem_khoi_hanh" placeholder="Ví dụ: Hà Nội"
                                value="<%= data ? data.diem_khoi_hanh : '' %>"
                                class="w-full px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                        </div>

                        <!-- Max Guests (so_nguoi_toi_da) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">Số Người Tối Đa</label>
                            <input type="number" name="so_nguoi_toi_da" min="1" placeholder="20"
                                value="<%= data ? data.so_nguoi_toi_da : 20 %>"
                                class="w-full px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                        </div>
                    </div>

                    <!-- Pricing Card -->
                    <div class="glass-card p-4 rounded-2xl space-y-4">
                        <h3
                            class="text-sm font-extrabold text-brand-accent uppercase tracking-wider flex items-center gap-2">
                            <i data-lucide="banknote" class="w-4.5 h-4.5"></i>
                            <span>Chi Phí & Giá Vé</span>
                        </h3>

                        <!-- Adult Price (gia_nguoi_lon) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">Giá Người Lớn <span
                                    class="text-red-500">*</span></label>
                            <div class="relative">
                                <input type="number" name="gia_nguoi_lon" required placeholder="0" min="0"
                                    value="<%= data ? data.gia_nguoi_lon : '' %>"
                                    class="w-full pl-4 pr-12 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                                <span
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-400 text-xs font-bold">đ</span>
                            </div>
                        </div>

                        <!-- Child Price (gia_tre_em) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">Giá Trẻ Em</label>
                            <div class="relative">
                                <input type="number" name="gia_tre_em" placeholder="0" min="0"
                                    value="<%= data ? data.gia_tre_em : 0 %>"
                                    class="w-full pl-4 pr-12 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                                <span
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-400 text-xs font-bold">đ</span>
                            </div>
                        </div>

                        <!-- Promo Price (gia_khuyen_mai) -->
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">Giá Khuyến Mãi</label>
                            <div class="relative">
                                <input type="number" name="gia_khuyen_mai" placeholder="0" min="0"
                                    value="<%= data ? data.gia_khuyen_mai : 0 %>"
                                    class="w-full pl-4 pr-12 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                                <span
                                    class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-slate-400 text-xs font-bold">đ</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Features & Services Lists (Dynamic Inputs) -->
                <div class="glass-card p-6 rounded-2xl space-y-6">
                    <!-- Diem Noi Bat -->
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <h3
                                class="text-sm font-extrabold text-brand-accent uppercase tracking-wider flex items-center gap-2">
                                <i data-lucide="sparkles" class="w-4.5 h-4.5 text-yellow-500 fill-yellow-500/20"></i>
                                <span>Điểm Nổi Bật</span>
                            </h3>
                            <button type="button" onclick="addListField('diem-noi-bat-container', 'diem_noi_bat')"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-primary/10 border border-brand-primary/30 rounded-lg text-[10px] font-bold text-brand-accent hover:bg-brand-primary/20 transition-all cursor-pointer">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i>Thêm
                            </button>
                        </div>
                        <div id="diem-noi-bat-container" class="space-y-2">
                            <% if (data && data.diem_noi_bat && data.diem_noi_bat.length> 0) { %>
                                <% data.diem_noi_bat.forEach((item, index)=> { %>
                                    <div class="flex items-center gap-2 list-item-row">
                                        <input type="text" name="diem_noi_bat[]" value="<%= item %>"
                                            placeholder="Điểm đặc sắc của tour..."
                                            class="flex-1 px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                                        <button type="button" onclick="removeListField(this)"
                                            class="p-2.5 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 hover:bg-red-500/20 transition-all cursor-pointer"><i
                                                data-lucide="x" class="w-4 h-4"></i></button>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="flex items-center gap-2 list-item-row">
                                                <input type="text" name="diem_noi_bat[]"
                                                    placeholder="Điểm đặc sắc của tour..."
                                                    class="flex-1 px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                                                <button type="button" onclick="removeListField(this)"
                                                    class="p-2.5 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 hover:bg-red-500/20 transition-all cursor-pointer"><i
                                                        data-lucide="x" class="w-4 h-4"></i></button>
                                            </div>
                                            <% } %>
                        </div>
                    </div>

                    <!-- Dich Vu Bao Gom -->
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <h3
                                class="text-sm font-extrabold text-brand-emerald uppercase tracking-wider flex items-center gap-2">
                                <i data-lucide="check-circle" class="w-4.5 h-4.5"></i>
                                <span>Dịch Vụ Bao Gồm</span>
                            </h3>
                            <button type="button" onclick="addListField('dich-vu-bao-gom-container', 'dich_vu_bao_gom')"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-emerald/10 border border-brand-emerald/30 rounded-lg text-[10px] font-bold text-brand-emerald hover:bg-brand-emerald/20 transition-all cursor-pointer">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i>Thêm dịch vụ
                            </button>
                        </div>
                        <div id="dich-vu-bao-gom-container" class="space-y-2">
                            <% if (data && data.dich_vu_bao_gom && data.dich_vu_bao_gom.length> 0) { %>
                                <% data.dich_vu_bao_gom.forEach((item, index)=> { %>
                                    <div class="flex items-center gap-2 list-item-row">
                                        <input type="text" name="dich_vu_bao_gom[]" value="<%= item %>"
                                            placeholder="Ví dụ: Xe đưa đón đời mới..."
                                            class="flex-1 px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-emerald transition-all font-semibold" />
                                        <button type="button" onclick="removeListField(this)"
                                            class="p-2.5 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 hover:bg-red-500/20 transition-all cursor-pointer"><i
                                                data-lucide="x" class="w-4 h-4"></i></button>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="flex items-center gap-2 list-item-row">
                                                <input type="text" name="dich_vu_bao_gom[]"
                                                    placeholder="Ví dụ: Xe đưa đón đời mới..."
                                                    class="flex-1 px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-emerald transition-all font-semibold" />
                                                <button type="button" onclick="removeListField(this)"
                                                    class="p-2.5 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 hover:bg-red-500/20 transition-all cursor-pointer"><i
                                                        data-lucide="x" class="w-4 h-4"></i></button>
                                            </div>
                                            <% } %>
                        </div>
                    </div>

                    <!-- Dich Vu Khong Bao Gom -->
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <h3
                                class="text-sm font-extrabold text-red-400 uppercase tracking-wider flex items-center gap-2">
                                <i data-lucide="x-circle" class="w-4.5 h-4.5"></i>
                                <span>Dịch Vụ KHÔNG Bao Gồm</span>
                            </h3>
                            <button type="button"
                                onclick="addListField('dich-vu-khong-bao-gom-container', 'dich_vu_khong_bao_gom')"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-red-500/10 border border-red-500/30 rounded-lg text-[10px] font-bold text-red-400 hover:bg-red-500/20 transition-all cursor-pointer">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i>Thêm dịch vụ
                            </button>
                        </div>
                        <div id="dich-vu-khong-bao-gom-container" class="space-y-2">
                            <% if (data && data.dich_vu_khong_bao_gom && data.dich_vu_khong_bao_gom.length> 0) { %>
                                <% data.dich_vu_khong_bao_gom.forEach((item, index)=> { %>
                                    <div class="flex items-center gap-2 list-item-row">
                                        <input type="text" name="dich_vu_khong_bao_gom[]" value="<%= item %>"
                                            placeholder="Ví dụ: Đồ uống trong các bữa ăn..."
                                            class="flex-1 px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-red-400 transition-all font-semibold" />
                                        <button type="button" onclick="removeListField(this)"
                                            class="p-2.5 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 hover:bg-red-500/20 transition-all cursor-pointer"><i
                                                data-lucide="x" class="w-4 h-4"></i></button>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="flex items-center gap-2 list-item-row">
                                                <input type="text" name="dich_vu_khong_bao_gom[]"
                                                    placeholder="Ví dụ: Đồ uống trong các bữa ăn..."
                                                    class="flex-1 px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-red-400 transition-all font-semibold" />
                                                <button type="button" onclick="removeListField(this)"
                                                    class="p-2.5 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 hover:bg-red-500/20 transition-all cursor-pointer"><i
                                                        data-lucide="x" class="w-4 h-4"></i></button>
                                            </div>
                                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Spacer for fixed footer -->
        <div class="h-24"></div>

        <!-- Pinned Footer Action Bar -->
        <div
            class="fixed bottom-0 left-0 md:left-64 right-0 z-40 bg-slate-950/90 backdrop-blur-md border-t border-white/10 px-6 py-4 md:px-10 flex items-center justify-end gap-3 shadow-2xl">
            <a href="/admin/tours"
                class="px-6 py-2.5 bg-transparent border border-white/10 hover:bg-white/5 text-slate-300 rounded-xl text-xs font-extrabold transition-all flex items-center gap-2 cursor-pointer">
                <i data-lucide="x" class="w-4 h-4"></i>
                <span>Hủy bỏ</span>
            </a>
            <button type="button" onclick="submitTourForm()"
                class="px-6 py-2.5 bg-brand-primary border border-brand-accent/30 text-white rounded-xl text-xs font-extrabold hover:bg-brand-primary/80 transition-all flex items-center gap-2 shadow-lg shadow-brand-primary/20 cursor-pointer">
                <i data-lucide="save" class="w-4 h-4"></i>
                <span>Lưu Thay Đổi</span>
            </button>
        </div>
    </form>
</div>

<script>
    // Live update image preview via file upload
    const fileInput = document.getElementById('image-upload-input');
    const fileNameSpan = document.getElementById('upload-file-name');
    const imgPreview = document.getElementById('image-preview');
    const hiddenHinhAnhInput = document.getElementById('hinh-anh-dai-dien-input');

    if (fileInput && imgPreview) {
        fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                // Update file name label
                if (fileNameSpan) fileNameSpan.innerText = file.name;

                // Read and set preview
                const reader = new FileReader();
                reader.onload = (event) => {
                    imgPreview.src = event.target.result;
                    if (hiddenHinhAnhInput) {
                        hiddenHinhAnhInput.value = event.target.result;
                    }
                };
                reader.readAsDataURL(file);
            }
        });

        imgPreview.addEventListener('error', () => {
            imgPreview.src = 'https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80';
        });
    }

    function syncScheduleToInput() {
        const cards = document.querySelectorAll('#schedule-container .day-card');
        const schedules = [];

        cards.forEach((card, index) => {
            const ma_lich_trinh = card.querySelector('.sched-ma-lich-trinh').value;
            const tieu_de = card.querySelector('.sched-tieu-de').value;
            const noi_dung = card.querySelector('.sched-noi-dung').value;
            const bua_an = card.querySelector('.sched-bua-an').value;
            const khach_san = card.querySelector('.sched-khach-san').value;

            const locInputs = card.querySelectorAll('.sched-loc');
            const dia_diem_tham_quan = Array.from(locInputs).map(inp => inp.value).filter(v => v.trim() !== '');

            schedules.push({
                ma_lich_trinh,
                ngay_thu: index + 1,
                tieu_de,
                noi_dung,
                bua_an,
                khach_san,
                dia_diem_tham_quan: dia_diem_tham_quan.length > 0 ? dia_diem_tham_quan : ['']
            });

            // Cập nhật lại số thứ tự Ngày trên thẻ
            const ngayThuEl = card.querySelector('.sched-ngay-thu');
            if (ngayThuEl) ngayThuEl.innerText = 'Ngày ' + (index + 1);
        });

        document.getElementById('lich-trinh-input').value = JSON.stringify(schedules);
    }

    function addScheduleDay() {
        const container = document.getElementById('schedule-container');

        // Ẩn thông báo "Chưa có lịch trình" nếu có
        const emptyMsg = container.querySelector('.text-center');
        if (emptyMsg) emptyMsg.style.display = 'none';

        const html = `
            <div class="day-card bg-slate-950 border border-white/5 p-4 rounded-xl shadow-inner flex flex-col gap-4">
                <div class="flex items-center justify-between pb-3 border-b border-white/5">
                    <h4 class="text-[11px] font-black text-white flex items-center gap-2"><span class="sched-ngay-thu px-2 py-0.5 bg-brand-accent/20 border border-brand-accent/30 text-brand-accent rounded text-[10px]">Ngày X</span></h4>
                    <button type="button" onclick="this.closest('.day-card').remove(); syncScheduleToInput();" class="p-1.5 bg-red-500/10 text-red-400 hover:bg-red-500/20 rounded-lg transition-all"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="space-y-3">
                        <div>
                            <input type="text" value=""
                                class="sched-ma-lich-trinh"
                                hidden/>
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 mb-1">Tiêu Đề <span class="text-red-500">*</span></label>
                            <input type="text" oninput="syncScheduleToInput()" placeholder="Ví dụ: Khởi hành Hà Nội - Sapa..." class="sched-tieu-de w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white focus:border-brand-accent transition-all" />
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 mb-1">Nội Dung Chi Tiết</label>
                            <textarea rows="3" oninput="syncScheduleToInput()" placeholder="Mô tả chi tiết các hoạt động trong ngày..." class="sched-noi-dung w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white focus:border-brand-accent transition-all resize-none"></textarea>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-400 mb-1">Bữa Ăn</label>
                                <input type="text" oninput="syncScheduleToInput()" placeholder="Sáng, Trưa..." class="sched-bua-an w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white" />
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-400 mb-1">Khách Sạn</label>
                                <input type="text" oninput="syncScheduleToInput()" placeholder="Khách sạn 4 sao..." class="sched-khach-san w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white" />
                            </div>
                        </div>
                    </div>
                    <div class="space-y-3 lg:border-l lg:border-white/5 lg:pl-6">
                        <div class="flex items-center justify-between">
                            <label class="block text-[10px] font-bold text-brand-emerald">Địa Điểm Tham Quan</label>
                            <button type="button" onclick="addScheduleLocation(this)" class="inline-flex items-center gap-1.5 px-2 py-1 bg-brand-emerald/10 border border-brand-emerald/30 rounded-lg text-[9px] font-bold text-brand-emerald hover:bg-brand-emerald/20 transition-all cursor-pointer"><i data-lucide="plus" class="w-3 h-3"></i>Thêm</button>
                        </div>
                        <div class="sched-loc-container space-y-2 max-h-[220px] overflow-y-auto pr-1">
                            <div class="flex items-center gap-2">
                                <input type="text" oninput="syncScheduleToInput()" placeholder="Tên địa điểm..." class="sched-loc flex-1 px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white focus:outline-none focus:border-brand-emerald transition-all font-semibold" />
                                <button type="button" onclick="removeScheduleLocation(this)" class="p-2 bg-red-500/10 border border-red-500/20 rounded-lg text-red-400 hover:bg-red-500/20 transition-all cursor-pointer"><i data-lucide="x" class="w-3 h-3"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', html);
        lucide.createIcons();
        syncScheduleToInput();
    }

    function addScheduleLocation(btn) {
        const container = btn.closest('.space-y-3').querySelector('.sched-loc-container');
        const html = `
            <div class="flex items-center gap-2">
                <input type="text" oninput="syncScheduleToInput()" placeholder="Tên địa điểm..." class="sched-loc flex-1 px-3 py-2 bg-slate-900 border border-white/10 rounded-lg text-xs text-white focus:outline-none focus:border-brand-emerald transition-all font-semibold" />
                <button type="button" onclick="removeScheduleLocation(this)" class="p-2 bg-red-500/10 border border-red-500/20 rounded-lg text-red-400 hover:bg-red-500/20 transition-all cursor-pointer"><i data-lucide="x" class="w-3 h-3"></i></button>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', html);
        lucide.createIcons();
        syncScheduleToInput();
    }

    function removeScheduleLocation(btn) {
        const container = btn.closest('.sched-loc-container');
        btn.closest('.flex').remove();
        if (container.children.length === 0) {
            addScheduleLocation(container.parentElement.querySelector('button'));
        } else {
            syncScheduleToInput();
        }
    }


    // Dynamic field list additions
    function addListField(containerId, fieldName) {
        const container = document.getElementById(containerId);
        if (!container) return;

        const row = document.createElement('div');
        row.className = 'flex items-center gap-2 list-item-row';
        row.innerHTML = `
            <input type="text" name="${fieldName}[]" placeholder="Nhập thêm nội dung..." class="flex-1 px-4 py-2.5 bg-slate-950 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
            <button type="button" onclick="removeListField(this)" class="p-2.5 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 hover:bg-red-500/20 transition-all cursor-pointer">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        `;
        container.appendChild(row);
        lucide.createIcons();
    }

    function removeListField(button) {
        const row = button.closest('.list-item-row');
        if (row) {
            const container = row.parentNode;
            if (container.querySelectorAll('.list-item-row').length > 1) {
                row.remove();
            } else {
                // If last one, just clear input value instead of deleting row
                const input = row.querySelector('input');
                if (input) input.value = '';
            }
        }
    }

    const submitTourForm = async () => {
        const form = document.getElementById('tour-form');
        if (!form) return;

        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const data = getFormData(form);

        // Clean up empty schedule locations before sending
        if (data.lich_trinh_chi_tiet) {
            try {
                let schedules = JSON.parse(data.lich_trinh_chi_tiet);
                if (Array.isArray(schedules)) {
                    schedules = schedules.map(day => ({
                        ...day,
                        dia_diem_tham_quan: (day.dia_diem_tham_quan || []).filter(loc => loc && loc.trim() !== '')
                    }));
                    data.lich_trinh_chi_tiet = schedules; // Send as true JSON array
                }
            } catch (e) { }
        }

        const fileInput = document.getElementById('image-upload-input');
        const file = fileInput ? fileInput.files[0] : null;

        if (file && data.hinh_anh_dai_dien) {
            // Xóa base64 khỏi data để không bị gửi kèm lúc lưu tour
            data.hinh_anh_dai_dien = '';

            // Reset DOM TRƯỚC khi await → tránh cộng dồn base64 trong lúc chờ async
            if (hiddenHinhAnhInput) hiddenHinhAnhInput.value = '';
            if (fileInput) fileInput.value = '';

            try {
                const uploadFormData = new FormData();
                uploadFormData.append('file', file);

                const response = await fetch('/api/upload-file', {
                    method: 'POST',
                    body: uploadFormData
                    // KHÔNG set Content-Type, trình duyệt tự sinh boundary cho multipart/form-data
                });
                const result = await response.json();
                console.log(result);
                if (result.success && result.data) {
                    data.hinh_anh_dai_dien = result.data[0].link;
                }
            } catch (error) {
                console.error("Lỗi upload ảnh:", error);
            }
        }

        console.log(data);

        const isEdit = !!data.ma_tour;
        const method = isEdit ? 'PUT' : 'POST';
        const url = isEdit ? `/api/tours/update/${data.ma_tour}` : '/api/tours/create';

        try {
            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (result.success && result.data) {
                if (method === "POST") {
                    showAdminToast("Tạo tour thành công!");
                }
                else {
                    showAdminToast("Cập nhật tour thành công!");
                }

                const updatedData = result.data;
                const createdSchedule = result.createdSchedule;

                for (let [key, value] of Object.entries(updatedData)) {
                    const input = form.elements[key];
                    if (input) {
                        if (input.type === 'checkbox') {
                            input.checked = !!value;
                        } else {
                            input.value = value;
                        }
                    }

                    const arrayInputs = form.querySelectorAll(`[name="${key}[]"]`);
                    if (arrayInputs.length > 0 && Array.isArray(value)) {
                        arrayInputs.forEach((input, index) => {
                            if (value[index] !== undefined) {
                                input.value = value[index];
                            }
                        });
                    }
                }

                // Cập nhật ma_lich_trinh cho các thẻ Lịch trình vừa tạo mới
                if (createdSchedule && Array.isArray(createdSchedule)) {
                    const scheduleInputs = document.querySelectorAll('.sched-ma-lich-trinh');
                    // Lọc ra các ô input đang bị rỗng (tức là ngày mới thêm)
                    const emptyInputs = Array.from(scheduleInputs).filter(input => input.value === '');
                    
                    emptyInputs.forEach((input, index) => {
                        if (createdSchedule[index]) {
                            input.value = createdSchedule[index].ma_lich_trinh;
                        }
                    });
                    
                    // Cập nhật lại chuỗi JSON ẩn
                    syncScheduleToInput();
                }

            } else {
                showAdminToast("Lỗi: " + result.message, false);
            }
        } catch (error) {
            console.error(error);
            alert("Không thể gửi dữ liệu do lỗi kết nối.");
        }

    };
</script>