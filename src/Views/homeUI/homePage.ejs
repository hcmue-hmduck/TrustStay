        const statusBadge = document.getElementById('search-status-badge');

        if (filteredTours.length === 0) {
            statusBadge.classList.add('hidden');
            container.innerHTML = `
                <div class="col-span-full glass-panel p-12 text-center rounded-3xl border border-white/5 my-8">
                  <i data-lucide="compass" class="w-12 h-12 text-brand-accent mx-auto mb-4 animate-bounce"></i>
                  <h3 class="text-lg font-bold text-white">Không tìm thấy tour phù hợp</h3>
                  <p class="text-xs text-brand-muted mt-2 max-w-sm mx-auto">Vui lòng thử tìm kiếm bằng từ khoá khác hoặc chọn "Đặt lại bộ lọc" để xem danh sách toàn bộ các tours nổi bật.</p>
                  <button 
                    onclick="resetFilters()"
                    class="mt-5 px-6 py-2.5 bg-brand-accent text-brand-dark text-xs font-extrabold rounded-full cursor-pointer"
                  >
                    Xem tất cả tours
                  </button>
                </div>
            `;
