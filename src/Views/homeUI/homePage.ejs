    // Open Booking modal
    function openBookingModal(id) {
        selectedTour = tourPackages.find(p => p.id === id);
        if (!selectedTour) return;

        // Reset elements
        document.getElementById('modal-tour-img').src = selectedTour.image;
        document.getElementById('modal-tour-duration').innerText = selectedTour.duration;
        document.getElementById('modal-tour-title').innerText = selectedTour.title;
        document.getElementById('modal-tour-location').innerText = selectedTour.location;
        document.getElementById('modal-tour-description').innerText = selectedTour.description;

        // Highlights list
        const highlightsContainer = document.getElementById('modal-tour-highlights');
        highlightsContainer.innerHTML = selectedTour.highlights.map(h => `
            <li class="flex gap-2 text-brand-muted leading-relaxed">
              <span class="text-brand-accent font-bold">•</span>
              <span>${h}</span>
            </li>
        `).join('');

        // Itinerary timeline
        const itineraryContainer = document.getElementById('modal-tour-itinerary');
        itineraryContainer.innerHTML = selectedTour.itinerary.map((it, idx) => `
            <div class="p-2.5 bg-black/30 rounded border border-white/5 text-left">
              <p class="text-brand-accent font-bold uppercase mb-1">CỘT MỐC ${idx + 1}</p>
              <span>${it}</span>
            </div>
        `).join('');

        // Initialize form
        currentGuestsCount = Number(document.getElementById('search-guests-input').value) || 2;
        if (currentGuestsCount > selectedTour.maxGuests) currentGuestsCount = selectedTour.maxGuests;

        document.getElementById('booking-fullname-field').value = "Huong";
        document.getElementById('booking-phone-field').value = "0912345678";
        document.getElementById('booking-email-field').value = "huynhmyduc2005@gmail.com";

        const nextWeek = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
        document.getElementById('booking-startdate-field').value = document.getElementById('search-date-input').value || nextWeek;

        updateCalculationUI();

        // Show Modal
        const overlay = document.getElementById('booking-modal-overlay');
        overlay.classList.remove('hidden');
        document.getElementById('booking-form-screen').classList.remove('hidden');
        document.getElementById('booking-success-screen').classList.add('hidden');

        lucide.createIcons();
    }

    // Close Booking modal
    function closeBookingModal() {
        document.getElementById('booking-modal-overlay').classList.add('hidden');
    }

    // Adjust guests count
    function adjustGuests(amount) {
        if (!selectedTour) return;
        const newCount = currentGuestsCount + amount;
        if (newCount >= 1 && newCount <= selectedTour.maxGuests) {
            currentGuestsCount = newCount;
            updateCalculationUI();
        }
    }

    // Update calculation block
    function updateCalculationUI() {
        if (!selectedTour) return;
        document.getElementById('booking-guests-display').innerText = currentGuestsCount;
        document.getElementById('booking-price-display').innerText = selectedTour.currentPrice.toLocaleString('vi-VN') + ' đ';
        document.getElementById('booking-count-display').innerText = 'x ' + currentGuestsCount;
        document.getElementById('booking-total-display').innerText = (selectedTour.currentPrice * currentGuestsCount).toLocaleString('vi-VN') + ' đ';
    }

    // Search trigger action
    function filterTours() {
        filteredTours = tourPackages.filter(pkg => {
            const matchDest = !searchDest ||
                pkg.title.toLowerCase().includes(searchDest.toLowerCase()) ||
                pkg.location.toLowerCase().includes(searchDest.toLowerCase());

            const matchGuests = !searchGuests || pkg.maxGuests >= Number(searchGuests);

            return matchDest && matchGuests;
        });

        renderToursGrid();

        // Show status badge details
        const resetBtn = document.getElementById('reset-filter-btn');
        if (searchDest || searchDate || searchGuests) {
            resetBtn.classList.remove('hidden');
        } else {
            resetBtn.classList.add('hidden');
        }
    }

    // Reset all search filters
    function resetFilters() {
        searchDest = '';
        searchDate = '';
        searchGuests = '';

        document.getElementById('search-destination-input').value = '';
        document.getElementById('search-date-input').value = '';
        document.getElementById('search-guests-input').value = '';
        document.getElementById('clear-dest-btn').classList.add('hidden');
        document.getElementById('reset-filter-btn').classList.add('hidden');

        filteredTours = [...tourPackages];
        renderToursGrid();
        showToast("Đã khôi phục toàn bộ danh sách tours du lịch!");
    }

    // Init listeners for search inputs
    document.getElementById('search-destination-input').addEventListener('input', (e) => {
        searchDest = e.target.value;
        const clearBtn = document.getElementById('clear-dest-btn');
        if (searchDest) {
            clearBtn.classList.remove('hidden');
        } else {
            clearBtn.classList.add('hidden');
        }
    });

    document.getElementById('clear-dest-btn').addEventListener('click', () => {
        document.getElementById('search-destination-input').value = '';
        searchDest = '';
        document.getElementById('clear-dest-btn').classList.add('hidden');
    });

    document.getElementById('search-date-input').addEventListener('change', (e) => {
        searchDate = e.target.value;
    });

    document.getElementById('search-guests-input').addEventListener('input', (e) => {
        searchGuests = e.target.value;
    });

    // Form search submit
    document.getElementById('search-form').addEventListener('submit', (e) => {
        e.preventDefault();
        filterTours();

        const resultsEl = document.getElementById('tour-results');
        if (resultsEl) {
            resultsEl.scrollIntoView({ behavior: 'smooth' });
        }
        showToast(`Tìm thấy ${filteredTours.length} tour phù hợp với yêu cầu của bạn!`);
    });

    // Checkout Form Submit
    document.getElementById('booking-form').addEventListener('submit', (e) => {
        e.preventDefault();
        if (!selectedTour) return;

        const submitBtn = document.getElementById('submit-checkout-btn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
            <span class="flex items-center justify-center gap-2">
                <span class="w-4 h-4 border-2 border-brand-dark border-t-transparent rounded-full animate-spin"></span>
                <span>Đang kết nối hệ thống giữ vé...</span>
            </span>
        `;

        setTimeout(() => {
            const totalPrice = selectedTour.currentPrice * currentGuestsCount;
            const bookingId = `B-${Math.floor(1000 + Math.random() * 9000)}`;
            const bookingDate = new Date().toISOString().split('T')[0];
            const fullName = document.getElementById('booking-fullname-field').value;
            const phone = document.getElementById('booking-phone-field').value;
            const email = document.getElementById('booking-email-field').value;
            const startDate = document.getElementById('booking-startdate-field').value;

            const newBooking = {
                id: bookingId,
                tourId: selectedTour.id,
                tourTitle: selectedTour.title,
                fullName: fullName,
                phone: phone,
                email: email,
                startDate: startDate,
                guestsCount: currentGuestsCount,
                totalPrice: totalPrice,
                status: 'confirmed',
                bookingDate: bookingDate
            };

            myBookings.unshift(newBooking);
            updateBookingsDropdown();
            showToast('Đặt tour thành công! Hẹn gặp lại bạn trong chuyến đi.');

            // Success View population
            document.getElementById('success-username').innerText = fullName;
            document.getElementById('success-tour-title').innerText = selectedTour.title;

            document.getElementById('success-ticket-card').innerHTML = `
                <p class="text-brand-accent font-black text-sm pb-1.5 border-b border-white/10 flex justify-between">
                  <span>MÃ VÉ KHÁCH HÀNG</span>
                  <span>${bookingId}</span>
                </p>
                <p class="flex justify-between"><span>Tour du lịch:</span> <span class="text-white font-bold">${selectedTour.title}</span></p>
                <p class="flex justify-between"><span>Ngày khởi hành:</span> <span class="text-white font-bold">${startDate}</span></p>
                <p class="flex justify-between"><span>Số hành khách:</span> <span class="text-white font-bold">${currentGuestsCount} Vé</span></p>
                <p class="flex justify-between"><span>Họ và tên:</span> <span class="text-white font-bold">${fullName}</span></p>
                <p class="flex justify-between pt-2 border-t border-white/10 text-brand-accent text-sm font-black">
                  <span>Tổng chi phí:</span>
                  <span>${totalPrice.toLocaleString('vi-VN')} đ</span>
                </p>
            `;

            document.getElementById('booking-form-screen').classList.add('hidden');
            document.getElementById('booking-success-screen').classList.remove('hidden');

            submitBtn.disabled = false;
            submitBtn.innerHTML = "Thanh toán &amp; Giữ vé ngay";

            lucide.createIcons();
        }, 1500);
    });

    // 3D Tours Carousel Logic
    const tours3DData = [
        {
            id: 'pkg-dalat',
            location: 'Đà Lạt',
            title: 'Đà Lạt Thành Phố Ngàn Hoa',
            duration: '3 ngày 2 đêm',
            price: '2.800.000 đ',
