<!-- Dynamic Toast Message -->
<div id="toast-notification"
    class="fixed top-24 left-1/2 -translate-x-1/2 z-50 px-6 py-3 rounded-full bg-brand-accent/95 text-brand-dark font-extrabold shadow-xl flex items-center gap-2 border border-white/20 backdrop-blur-md hidden transition-all duration-300 transform -translate-y-4 opacity-0">
    <i data-lucide="sparkles" class="w-5 h-5 animate-pulse text-brand-dark"></i>
    <span id="toast-text"></span>
</div>

<!-- Hero Container Section -->
<section class="relative min-h-[calc(100vh-65px)] flex flex-col justify-center py-12">
    <!-- Cinematic Backdrop Image -->
    <div class="absolute inset-0 z-0">
        <img alt="Hero da nang golden bridge" class="w-full h-full object-cover brightness-[0.35]"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDKFu6RpvjNNyJ0gKDj2oyYCYnQLy8Zl65nngEBjviN35mFSMx129dSHDIRuk1V-dds1bFg72ejzS0YlOVTdaybTMXPBVimICm3xtTsFP5XRWCU2S_BhChy2fO9fJtNlqdKyz5g-UBrtvZc6cVTZ64Ybu_oSpLeZb6ZSqlJJuP31iy2xGHpr2JFcwOmCOHVetwE-GcpXY4COLChfdIaMn0pIeLf8neoLLBFwS_n_n0nfeYThkKTvAZqSW3MSoDonVHGwWxtZ0Eh9B8"
            referrerpolicy="no-referrer" />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/30 via-transparent to-brand-dark"></div>
    </div>

    <!-- Outer Alignment Container -->
    <div class="max-w-screen-2xl mx-auto w-full px-4 md:px-8 z-10 flex flex-col items-center">
        <!-- Content Panel -->
        <div class="w-full max-w-5xl text-center">
            <!-- Satisfied Clients Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 glass-panel rounded-full animate-fade-in"
                id="highlight-badge-customer">
                <span class="w-2.5 h-2.5 bg-brand-accent rounded-full shadow-[0_0_8px_#a4e6ff] animate-pulse"></span>
                <span class="text-xs font-bold text-brand-accent uppercase tracking-widest">Hơn 50,000 khách hàng hài
                    lòng</span>
            </div>

            <!-- Slogan -->
            <h1 class="text-4xl md:text-7xl font-black text-white leading-tight tracking-tight mb-4 animate-fade-in-up">
                Trải Nghiệm <br class="md:hidden" />
                <span class="hero-gradient-text">Lời Nói Đi Đôi Hành Động</span>
            </h1>

            <p
                class="text-base md:text-xl text-brand-muted font-medium mb-10 max-w-2xl mx-auto opacity-90 animate-fade-in-up-delay">
                Mỗi chuyến đi là một câu chuyện độc sắc đầy cảm hứng và kỉ niệm khó phai.
            </p>

            <!-- Interactive Search Bar Form -->
            <div class="max-w-4xl mx-auto mb-16 animate-fade-in-up-more">
                <form id="search-form"
                    class="glass-panel p-4 rounded-3xl md:rounded-full flex flex-col md:flex-row items-center gap-2 shadow-2xl border border-white/10">
                    <!-- Destination Input -->
                    <div
                        class="flex-1 w-full flex items-center gap-3 px-5 py-3 border-b md:border-b-0 md:border-r border-white/10 group">
                        <i data-lucide="map-pin"
                            class="w-5 h-5 text-brand-accent group-hover:scale-110 transition-transform"></i>
                        <div class="text-left w-full">
                            <span class="block text-[10px] uppercase font-bold tracking-wider text-brand-muted/70">Địa
                                điểm</span>
                            <input type="text" id="search-destination-input" placeholder="Bạn muốn đi đâu?"
                                class="bg-transparent border-none p-0 text-white placeholder:text-brand-muted/50 focus:outline-none focus:ring-0 text-sm font-bold w-full mt-0.5" />
                        </div>
                        <button type="button" id="clear-dest-btn"
                            class="p-1 hover:text-brand-accent text-brand-muted hidden">
                            <i data-lucide="x" class="w-3 h-3"></i>
                        </button>
                    </div>

                    <!-- Date Input -->
                    <div
                        class="flex-1 w-full flex items-center gap-3 px-5 py-3 border-b md:border-b-0 md:border-r border-white/10 group">
                        <i data-lucide="calendar"
                            class="w-5 h-5 text-brand-accent group-hover:scale-110 transition-transform"></i>
                        <div class="text-left w-full">
                            <span class="block text-[10px] uppercase font-bold tracking-wider text-brand-muted/70">Ngày
                                khởi
                                hành</span>
                            <input type="date" id="search-date-input"
                                class="bg-transparent border-none p-0 text-white focus:outline-none focus:ring-0 text-sm font-bold w-full mt-0.5 [color-scheme:dark]" />
                        </div>
                    </div>

                    <!-- Guests Input -->
                    <div class="flex-1 w-full flex items-center gap-3 px-5 py-3">
                        <i data-lucide="users"
                            class="w-5 h-5 text-brand-accent group-hover:scale-110 transition-transform"></i>
                        <div class="text-left w-full">
                            <span class="block text-[10px] uppercase font-bold tracking-wider text-brand-muted/70">Số
                                khách</span>
                            <input type="number" id="search-guests-input" min="1" max="50"
                                placeholder="Thêm số lượng khách"
                                class="bg-transparent border-none p-0 text-white placeholder:text-brand-muted/50 focus:outline-none focus:ring-0 text-sm font-bold w-full mt-0.5" />
                        </div>
                    </div>

                    <div class="w-full md:w-auto flex items-center gap-2">
                        <button type="button" id="reset-filter-btn"
                            class="px-4 py-3.5 rounded-full border border-white/10 hover:bg-white/5 text-xs font-bold text-white transition-all whitespace-nowrap hidden">
                            Xoá lọc
                        </button>
                        <button type="submit"
                            class="w-full md:w-auto px-8 py-3.5 bg-brand-accent text-brand-dark rounded-full font-bold flex items-center justify-center gap-2 hover:bg-brand-primary active:scale-95 transition-all shadow-lg shadow-brand-accent/20 cursor-pointer"
                            id="search-submit-btn">
                            <i data-lucide="search" class="w-4 h-4"></i>
                            <span>Tìm kiếm</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Social Proof Stats Bar -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto pt-8 border-t border-white/10"
                id="stats-container">
                <!-- Rendered by JS -->
            </div>
        </div>
    </div>

    <!-- Scroll Down Indicator -->
    <style>
        @keyframes arrowScrollDown {
            0% {
                opacity: 0;
                transform: translateY(-8px) scale(0.85);
            }

            50% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

            100% {
                opacity: 0;
                transform: translateY(8px) scale(0.85);
            }
        }

        @keyframes textShimmerFlow {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .scroll-arrow-animate {
            animation: arrowScrollDown 1.8s infinite ease-in-out;
        }

        .delay-arrow-1 {
            animation-delay: 0.3s;
        }

        .delay-arrow-2 {
            animation-delay: 0.6s;
        }

        .shimmer-text-glow {
            background: linear-gradient(90deg, #00d2ff 0%, #a4e6ff 50%, #00d2ff 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: textShimmerFlow 3s infinite linear;
            filter: drop-shadow(0 0 8px rgba(164, 230, 255, 0.3));
            /* Fix Vietnamese uppercase/gradient text diacritics clipping */
            display: inline-block;
            line-height: 1.4;
            padding-top: 0.15em;
            padding-bottom: 0.15em;
        }
    </style>
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3.5 cursor-pointer z-10 group"
        onclick="document.getElementById('bento-destinations').scrollIntoView({ behavior: 'smooth' })">
        <span
            class="text-sm md:text-base tracking-[0.35em] font-black shimmer-text-glow transition-all duration-300 group-hover:scale-105">
            Khám Phá Thêm
        </span>
        <div class="flex flex-col items-center -space-y-3.5 mt-1.5">
            <i data-lucide="chevrons-down" class="w-7 h-7 stroke-[3] text-brand-accent scroll-arrow-animate"></i>
            <i data-lucide="chevron-down"
                class="w-7 h-7 stroke-[3] text-brand-accent scroll-arrow-animate delay-arrow-1"></i>
            <i data-lucide="chevron-down"
                class="w-7 h-7 stroke-[2.5] text-brand-accent/60 scroll-arrow-animate delay-arrow-2"></i>
        </div>
    </div>
</section>

<!-- Bento Grid Destinations Section -->
<section class="pt-0 pb-24 bg-brand-dark/60 scroll-mt-24" id="bento-destinations">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8">

        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
            <div>
                <p
                    class="text-brand-accent font-extrabold text-xs md:text-sm tracking-wider mb-2 flex items-center gap-1.5">
                    <i data-lucide="compass" class="w-4 h-4 animate-spin-slow"></i>
                    <span>Điểm Đến Phổ Biến</span>
                </p>
                <h2 class="text-3xl md:text-5xl font-black text-white">Khám Phá <span class="text-brand-accent">Việt Nam
                        hùng vĩ</span></h2>
            </div>
            <button
                onclick="document.getElementById('tour-results').scrollIntoView({ behavior: 'smooth' }); showToast('Hiển thị đầy đủ hành trình');"
                class="text-xs font-bold text-brand-muted hover:text-brand-accent transition-colors flex items-center gap-1.5 uppercase tracking-wider">
                <span>Xem tất cả điểm đến</span>
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </button>
        </div>

        <div class="flex flex-col lg:flex-row gap-4 h-auto lg:h-[600px] w-full" id="bento-destinations-wrapper"
            data-locations='<%- JSON.stringify(location.map(l => l.ma_dia_diem)) %>'>
            <% location.forEach((loc, idx)=> { %>
                <% if (loc.trang_thai==='active' ) { %>
                    <div id="bento-card-<%=loc.ma_dia_diem%>" onclick="toggleBentoView('<%=loc.ma_dia_diem%>')"
                        class="relative <%= idx === 0 ? 'lg:flex-[4.5] h-[350px] shadow-2xl' : 'flex-1 h-[120px] shadow-xl' %> lg:h-full rounded-3xl overflow-hidden group cursor-pointer border border-white/5 transition-all duration-500 ease-in-out">
                        <img alt="<%=loc.ten_dia_diem%>"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1000ms] brightness-[0.6] group-hover:brightness-[0.7]"
                            src="<%=loc.hinh_anh%>" referrerPolicy="no-referrer" />
                        <div
                            class="absolute inset-0 bg-gradient-to-t from-brand-dark/95 via-brand-dark/40 to-transparent">
                        </div>

                        <!-- Inactive rotated label -->
                        <div id="bento-label-<%=loc.ma_dia_diem%>"
                            class="absolute inset-0 flex items-center justify-center transition-opacity duration-300 <%= idx === 0 ? 'opacity-0' : 'opacity-100' %>">
                            <div
                                class="transform lg:-rotate-90 font-bold text-center tracking-widest text-xs md:text-sm uppercase text-white transition-all group-hover:text-brand-accent whitespace-nowrap">
                                <%=loc.ten_dia_diem%>
                            </div>
                        </div>

                        <!-- Active state panel -->
                        <div id="bento-info-<%=loc.ma_dia_diem%>"
                            class="absolute inset-0 p-6 md:p-8 lg:p-12 flex flex-col justify-between text-left <%= idx === 0 ? 'opacity-100 pointer-events-auto' : 'hidden opacity-0 pointer-events-none' %> transition-opacity duration-500">
                            <!-- Top content -->
                            <div class="flex justify-between items-start">
                                <div class="glass-panel px-4 py-2 rounded-full flex items-center gap-2">
                                    <span class="w-2 h-2 bg-brand-accent rounded-full animate-ping"></span>
                                    <span class="text-[10px] font-black uppercase tracking-widest text-white">Xu
                                        hướng</span>
                                </div>
                                <div
                                    class="flex items-center gap-1 bg-black/40 backdrop-blur-md px-3 py-1 rounded-full text-white text-xs font-bold border border-white/10">
                                    <i data-lucide="star" class="w-3.5 h-3.5 fill-brand-accent text-brand-accent"></i>
                                    <span>4.8</span>
                                </div>
                            </div>

                            <!-- Bottom content -->
                            <div class="space-y-3 lg:space-y-4 max-w-xl">
                                <p class="text-brand-accent text-xs font-black tracking-wider">
                                    <%=loc.tinh_thanh%> - <%=loc.quoc_gia%>
                                </p>
                                <h3 class="text-2xl md:text-3xl lg:text-5xl font-black text-white leading-tight">
                                    <%=loc.ten_dia_diem%>
                                </h3>
                                <p class="text-brand-muted text-xs md:text-sm lg:text-base leading-relaxed opacity-95">
                                    <%=loc.mo_ta%>
                                </p>

                                <div class="pt-2 flex items-center gap-4">
                                    <button
                                        onclick="event.stopPropagation(); showToast('Tính năng đang được cập nhật!')"
                                        class="px-6 py-3 bg-brand-accent text-brand-dark rounded-full text-xs font-black hover:bg-brand-primary active:scale-95 transition-all flex items-center gap-2 cursor-pointer shadow-lg shadow-brand-accent/10 pointer-events-auto">
                                        <span>Đặt hành trình ngay</span>
                                        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
                        <% }) %>
        </div>

    </div>
</section>

<!-- Featured Packs Grid Section -->
<section class="py-28 bg-brand-dark/40 border-t border-white/5 scroll-mt-24" id="tour-results">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8">

        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
            <div>
                <p
                    class="text-brand-accent font-extrabold text-xs md:text-sm tracking-wider mb-2 flex items-center gap-1.5">
                    <i data-lucide="sparkles" class="w-4 h-4 text-brand-accent"></i>
                    <span>Lựa Chọn Phù Hợp Nhất</span>
                </p>
                <h2 class="text-3xl md:text-5xl font-black text-white">Được <span class="text-brand-accent">Yêu Thích
                        Nhất</span></h2>
            </div>

            <div class="flex items-center gap-3">
                <span id="search-status-badge"
                    class="text-xs text-brand-muted bg-white/5 px-3 py-1 rounded-full border border-white/5 hidden">
                    <!-- Text by JS -->
                </span>
                <button onclick="resetFilters()"
                    class="text-xs font-bold text-brand-muted hover:text-brand-accent transition-all uppercase tracking-wider">
                    Đặt lại bộ lọc
                </button>
            </div>
        </div>

        <div id="tours-grid-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% tour_noi_bat.forEach(tour=> { %>
                <div
                    class="glass-panel rounded-2xl overflow-hidden flex flex-col hover:border-brand-accent/50 hover:shadow-2xl transition-all duration-300 border border-white/10 group">
                    <!-- Card Banner -->
                    <div class="relative h-48 overflow-hidden">
                        <img alt="<%= tour.ten_tour %>"
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 brightness-95"
                            src="<%= tour.hinh_anh_dai_dien %>" referrerPolicy="no-referrer" />

                        <!-- Discount Tag -->
                        <% let originalPrice=tour.gia_nguoi_lon || 0; let currentPrice=tour.gia_khuyen_mai &&
                            tour.gia_khuyen_mai> 0 ? tour.gia_khuyen_mai : originalPrice;
                            let discountPercent = originalPrice > 0 ? Math.round((1 - (currentPrice / originalPrice)) *
                            100) : 0;
                            %>
                            <% if (discountPercent> 0) { %>
                                <div class="absolute top-4 left-4">
                                    <span class="px-2.5 py-1 bg-red-600 text-white text-[10px] font-black rounded-lg">
                                        -<%= discountPercent %>%
                                    </span>
                                </div>
                                <% } %>

                                    <!-- Favorite button toggle -->
                                    <button onclick="toggleFavorite('<%= tour.ma_tour %>')"
                                        class="absolute top-4 right-4 w-9 h-9 rounded-full bg-brand-dark/50 backdrop-blur-md flex items-center justify-center text-white hover:text-brand-accent transition-all active:scale-90"
                                        title="Yêu thích">
                                        <i data-lucide="heart" class="w-4 h-4 text-white"
                                            id="fav-icon-<%= tour.ma_tour %>"></i>
                                    </button>
                    </div>

                    <!-- Card Details -->
                    <div class="p-5 flex-1 flex flex-col justify-between text-left">
                        <div>
                            <!-- Map Location -->
                            <div
                                class="flex items-center gap-1 text-brand-muted/90 text-[10px] font-black uppercase mb-1.5 tracking-wider">
                                <i data-lucide="map-pin" class="w-3 h-3 text-brand-accent"></i>
                                <% let foundLoc=location.find(loc=> loc.ma_dia_diem === tour.ma_dia_diem);
                                    %>
                                    <span>
                                        <%=foundLoc.tinh_thanh%> - <%=foundLoc.quoc_gia%>
                                    </span>
                            </div>

                            <!-- Title -->
                            <h4
                                class="text-white font-extrabold text-sm md:text-base group-hover:text-brand-accent transition-colors line-clamp-1">
                                <%= tour.ten_tour %>
                            </h4>

                            <!-- Specs -->
                            <div
                                class="flex items-center justify-between text-brand-muted text-[11px] font-semibold mt-3.5 mb-4 pb-3.5 border-b border-white/5">
                                <div class="flex items-center gap-3">
                                    <span class="flex items-center gap-1">
                                        <i data-lucide="clock" class="w-3.5 h-3.5 text-brand-accent"></i>
                                        <span>
                                            <%= tour.thoi_gian %>
                                        </span>
                                    </span>
                                    <span class="flex items-center gap-1">
                                        <i data-lucide="users" class="w-3.5 h-3.5 text-brand-accent"></i>
                                        <span>Tối đa <%= tour.so_nguoi_toi_da %> khách</span>
                                    </span>
                                </div>
                                <div class="flex items-center gap-1 text-xs">
                                    <i data-lucide="star" class="w-3.5 h-3.5 text-yellow-400 fill-yellow-400"></i>
                                    <span class="text-white font-black">4.8</span>
                                    <span class="text-brand-muted">(120)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing and Action -->
                        <div>
                            <div class="flex items-baseline gap-2 mb-4">
                                <span class="text-brand-accent font-black text-lg">
                                    <%= currentPrice.toLocaleString('vi-VN') %> đ
                                </span>
                                <% if (tour.gia_khuyen_mai && tour.gia_khuyen_mai> 0) { %>
                                    <span
                                        class="text-brand-muted font-medium text-[11px] line-through decoration-red-500/50">
                                        <%= originalPrice.toLocaleString('vi-VN') %> đ
                                    </span>
                                    <% } %>
                            </div>

                            <a href="/tour-details/<%= tour.ma_tour %>" target="_blank" rel="noopener noreferrer"
                                class="w-full py-2.5 bg-brand-accent/10 border border-brand-accent/20 text-brand-accent rounded-full text-xs font-black group-hover:bg-brand-accent group-hover:text-brand-dark transition-all flex items-center justify-center gap-1.5 active:scale-95 cursor-pointer">
                                <span>Xem chi tiết</span>
                                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <% }) %>
        </div>
    </div>
</section>

<!-- Hành Trình Của Bạn Section -->
<section class="py-28 bg-brand-dark" id="categories-section">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8">

        <div class="text-center mb-20">
            <div
                class="inline-flex items-center gap-1.5 px-3 py-1 bg-brand-accent/10 border border-brand-accent/20 rounded-full mb-3">
                <i data-lucide="sparkles" class="w-4 h-4 text-brand-accent animate-pulse"></i>
                <span class="text-xs uppercase font-extrabold tracking-widest text-brand-accent">Hành Trình Đa
                    Dạng</span>
            </div>
            <h2 class="text-3xl md:text-6xl font-black text-white leading-tight">
                Hành Trình <span class="hero-gradient-text">Của Bạn</span>
            </h2>
            <p class="text-brand-muted max-w-2xl mx-auto mt-4 text-sm md:text-base">
                Khám phá các phong cách du lịch đặc sắc, được thiết kế tinh xảo để mang lại trọn vẹn niềm vui và dấu ấn
                đáng quý cho chuyến đi của bạn.
            </p>
        </div>

        <div class="space-y-28" id="categories-list-container">
            <% category.forEach((cat, idx)=> { %>
                <% if (cat.trang_thai==='active' ) { %>
                    <% let isEven=idx % 2===0; %>
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                            <!-- Image showcase wrapper -->
                            <div
                                class="lg:col-span-6 w-full h-[250px] sm:h-[350px] lg:h-[400px] relative rounded-3xl overflow-hidden shadow-2xl border border-white/5 group <%= isEven ? 'order-1 lg:order-1' : 'order-1 lg:order-2' %>">
                                <img alt="<%= cat.ten_danh_muc %>"
                                    class="w-full h-full object-cover transition-transform duration-[1000ms] group-hover:scale-105"
                                    src="<%= cat.hinh_anh %>" referrerPolicy="no-referrer" />
                                <div
                                    class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-transparent to-transparent">
                                </div>

                                <!-- Badge -->
                                <div
                                    class="absolute top-6 left-6 px-4 py-2 glass-panel rounded-full flex items-center gap-2">
                                    <span class="w-2 h-2 bg-brand-accent rounded-full animate-ping"></span>
                                    <span class="text-[10px] font-black uppercase tracking-widest text-white">
                                        <%= cat.ten_danh_muc %>
                                    </span>
                                </div>
                            </div>

                            <!-- Info details wrapper -->
                            <div
                                class="lg:col-span-6 text-left <%= isEven ? 'order-2 lg:order-2' : 'order-2 lg:order-1' %> p-8 lg:p-12 border border-brand-accent/20 rounded-[2rem] bg-white/[0.02] shadow-[0_0_30px_rgba(0,210,255,0.05)] relative group-hover:border-brand-accent/40 transition-all duration-500">
                                <p
                                    class="text-brand-accent font-extrabold text-xs tracking-widest mb-3 uppercase flex items-center gap-1.5">
                                    <i data-lucide="milestone" class="w-4 h-4"></i>
                                    <span>
                                        <%= (idx + 1).toString().padStart(2, '0' ) %>
                                    </span>
                                </p>
