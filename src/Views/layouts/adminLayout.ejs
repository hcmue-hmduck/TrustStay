<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title || 'TrustStay Admin - Quản Lý Phòng Trọ' %>
  </title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;600;700&display=swap"
    rel="stylesheet">

  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            mono: ['Space Grotesk', 'monospace'],
          },
          colors: {
            'brand-dark': '#f8fafc',
            'brand-card': '#ffffff',
            'brand-accent': '#0284c7',
            'brand-primary': '#0284c7',
            'brand-emerald': '#059669',
            'brand-muted': '#64748b',
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Custom Styles -->
  <style>
    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(226, 232, 240, 0.9);
      box-shadow: 0 10px 30px -10px rgba(15, 23, 42, 0.05);
    }

    .gradient-brand-text {
      background: linear-gradient(135deg, #0284c7 0%, #2563eb 50%, #4f46e5 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }

    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }

    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 6px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 h-screen flex flex-col md:flex-row antialiased overflow-hidden text-base">

  <!-- Sidebar Component -->
  <aside
    class="w-full md:w-72 md:h-screen bg-white border-r border-slate-200 flex flex-col justify-between shrink-0 z-40 overflow-y-auto transition-all duration-300 shadow-sm">
    <div>
      <!-- Sidebar Header -->
      <div class="h-20 flex items-center justify-between px-6 border-b border-slate-200">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-sky-100 border border-sky-300 flex items-center justify-center text-brand-accent shadow-sm">
            <i data-lucide="home" class="w-6 h-6"></i>
          </div>
          <span class="font-mono text-xl font-black tracking-tight text-slate-900 uppercase">Trust<span
              class="text-brand-accent">Stay</span></span>
        </a>
        <div
          class="text-[10px] bg-sky-100 text-brand-accent px-2.5 py-1 rounded-full font-extrabold uppercase tracking-wider border border-sky-300">
          Admin
        </div>
      </div>

      <!-- Navigation links -->
      <nav class="mt-6 px-4 space-y-2">
        <a href="/admin/dashboard"
          class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl text-sm font-bold transition-all group <%= page === 'admin_dashboard' ? 'bg-sky-50 border border-sky-200 text-brand-accent shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 border border-transparent' %>">
          <i data-lucide="layout-dashboard"
            class="w-5 h-5 text-brand-accent transition-transform group-hover:scale-110"></i>
          <span>Bảng Điều Khiển</span>
        </a>

        <a href="/admin/rooms"
          class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl text-sm font-bold transition-all group <%= page === 'admin_rooms' ? 'bg-sky-50 border border-sky-200 text-brand-accent shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 border border-transparent' %>">
          <i data-lucide="home" class="w-5 h-5 text-brand-accent transition-transform group-hover:scale-110"></i>
          <span>Quản Lý Phòng Trọ</span>
        </a>

        <a href="/admin/categories"
          class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl text-sm font-bold transition-all group <%= page === 'admin_categories' ? 'bg-sky-50 border border-sky-200 text-brand-accent shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 border border-transparent' %>">
          <i data-lucide="layers" class="w-5 h-5 text-brand-accent transition-transform group-hover:scale-110"></i>
          <span>Danh Mục Phòng</span>
        </a>

        <a href="/admin/locations"
          class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl text-sm font-bold transition-all group <%= page === 'admin_locations' ? 'bg-sky-50 border border-sky-200 text-brand-accent shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 border border-transparent' %>">
          <i data-lucide="map-pin" class="w-5 h-5 text-brand-accent transition-transform group-hover:scale-110"></i>
          <span>Khu Vực / Địa Điểm</span>
        </a>

        <a href="/admin/requests"
          class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl text-sm font-bold transition-all group <%= page === 'admin_requests' ? 'bg-sky-50 border border-sky-200 text-brand-accent shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 border border-transparent' %>">
          <i data-lucide="calendar" class="w-5 h-5 text-brand-accent transition-transform group-hover:scale-110"></i>
          <span>Yêu Cầu Hẹn Xem</span>
        </a>

        <a href="/admin/reviews"
          class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl text-sm font-bold transition-all group <%= page === 'admin_reviews' ? 'bg-sky-50 border border-sky-200 text-brand-accent shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 border border-transparent' %>">
          <i data-lucide="star" class="w-5 h-5 text-brand-accent transition-transform group-hover:scale-110"></i>
          <span>Đánh Giá Khách Hàng</span>
        </a>

        <a href="/admin/blogs"
          class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl text-sm font-bold transition-all group <%= page === 'admin_blogs' ? 'bg-sky-50 border border-sky-200 text-brand-accent shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 border border-transparent' %>">
          <i data-lucide="book-open" class="w-5 h-5 text-brand-accent transition-transform group-hover:scale-110"></i>
          <span>Bài Viết Kinh Nghiệm</span>
        </a>
      </nav>
    </div>

    <!-- Sidebar Footer user profile card -->
    <div class="p-4 border-t border-slate-200">
      <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-2xl border border-slate-200">
        <div
          class="w-10 h-10 rounded-xl bg-sky-100 border border-sky-300 flex items-center justify-center text-brand-accent font-black text-sm">
          AD
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-xs font-black text-slate-900 truncate">Administrator</p>
          <p class="text-[11px] text-slate-500 truncate">admin@truststay.vn</p>
        </div>
        <a href="/" title="Về trang chủ"
          class="p-2 text-slate-500 hover:text-slate-900 hover:bg-slate-200 rounded-xl transition-colors">
          <i data-lucide="log-out" class="w-4 h-4"></i>
        </a>
      </div>
    </div>
  </aside>

  <!-- Main view wrapper -->
  <main class="flex-1 flex flex-col h-screen overflow-y-auto bg-slate-50 relative min-w-0">

    <!-- Toast notifications -->
    <div id="admin-toast"
      class="fixed top-5 right-5 z-50 flex items-center gap-3 px-6 py-3.5 rounded-2xl bg-white border border-sky-300 shadow-2xl transition-all duration-300 transform -translate-y-4 opacity-0 hidden">
      <div class="w-9 h-9 rounded-full bg-sky-100 flex items-center justify-center text-brand-accent">
        <i data-lucide="bell" class="w-4 h-4"></i>
      </div>
      <p id="admin-toast-text" class="text-xs font-bold text-slate-800"></p>
    </div>

    <!-- Content Area -->
    <div class="flex-1 p-6 md:p-10 lg:p-12 overflow-y-auto max-w-full w-full">
      <%- body %>
    </div>
  </main>

  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    window.showAdminToast = (message, isSuccess = true) => {
      const toast = document.getElementById('admin-toast');
      const text = document.getElementById('admin-toast-text');
      if (!toast || !text) return;

      text.innerText = message;
      toast.classList.remove('hidden');

      setTimeout(() => {
        toast.classList.remove('opacity-0', '-translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');
      }, 50);

      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', '-translate-y-4');
        setTimeout(() => toast.classList.add('hidden'), 300);
      }, 3500);
    };

    window.getFormData = (formElement) => {
      const formData = new FormData(formElement);
      const data = {};
      for (let [key, value] of formData.entries()) {
        if (key.endsWith('[]')) {
          const cleanKey = key.slice(0, -2);
          if (!data[cleanKey]) data[cleanKey] = [];
          data[cleanKey].push(value);
        } else {
          data[key] = value;
        }
      }
      return data;
    };
  </script>
</body>

</html>