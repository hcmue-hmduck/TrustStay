<div class="space-y-6 text-left">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-slate-900">
    <div>
      <h1 class="text-2xl font-mono font-black text-white uppercase tracking-tight flex items-center gap-2">
        <i data-lucide="layers" class="w-6 h-6 text-brand-accent"></i>
        <span>Quản Lý Danh Mục Phòng Trọ</span>
      </h1>
      <p class="text-xs text-brand-muted mt-1">Phân loại các hình thức phòng trọ (Studio, Ký túc xá, Phòng trọ giá rẻ, Căn hộ nguyên căn)</p>
    </div>

    <button onclick="openAddCategoryModal()" class="px-5 py-2.5 bg-brand-primary hover:bg-brand-accent text-slate-950 font-bold text-xs rounded-xl transition-all shadow-lg flex items-center gap-2 cursor-pointer">
      <i data-lucide="plus-circle" class="w-4 h-4"></i>
      <span>Thêm Danh Mục Mới</span>
    </button>
  </div>

  <!-- Category List Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (data && data.length > 0) { %>
      <% data.forEach(cat => { %>
        <div class="glass-card rounded-2xl border border-white/5 p-6 flex flex-col justify-between space-y-4 hover:border-brand-accent/30 transition-all">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 bg-brand-accent/10 border border-brand-accent/20 text-brand-accent font-mono text-[10px] font-bold rounded-lg uppercase">
                <%= cat.ma_danh_muc %>
              </span>
              <div class="flex items-center gap-1">
                <button onclick="editCategory('<%= cat.ma_danh_muc %>', '<%= cat.ten_danh_muc %>', '<%= (cat.mo_ta || '').replace(/'/g, '\\\'') %>', '<%= cat.hinh_anh || '' %>')" class="p-1.5 text-brand-accent hover:bg-brand-accent/10 rounded-lg transition-colors cursor-pointer" title="Sửa">
                  <i data-lucide="edit-3" class="w-4 h-4"></i>
                </button>
                <button onclick="deleteCategory('<%= cat.ma_danh_muc %>')" class="p-1.5 text-red-400 hover:bg-red-500/10 rounded-lg transition-colors cursor-pointer" title="Xóa">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <% if (cat.hinh_anh) { %>
                <img src="<%= cat.hinh_anh %>" alt="<%= cat.ten_danh_muc %>" class="w-12 h-12 rounded-xl object-cover border border-white/10 shrink-0" />
              <% } else { %>
                <div class="w-12 h-12 rounded-xl bg-slate-900 border border-white/10 flex items-center justify-center text-brand-accent shrink-0 font-mono font-black text-sm">
                  CAT
                </div>
              <% } %>
              <div>
                <h3 class="font-bold text-white text-sm"><%= cat.ten_danh_muc %></h3>
                <span class="text-[10px] text-brand-muted font-mono"><%= cat.slug %></span>
              </div>
            </div>

            <p class="text-xs text-brand-muted leading-relaxed line-clamp-2"><%= cat.mo_ta || 'Chưa có mô tả chi tiết.' %></p>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-span-full py-12 text-center text-brand-muted glass-card rounded-2xl border border-white/5">
        Chưa có danh mục phòng trọ nào.
      </div>
    <% } %>
  </div>

</div>

<!-- Add/Edit Category Modal -->
<div id="categoryModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden">
  <div class="glass-card bg-slate-950 max-w-md w-full rounded-2xl p-6 border border-white/10 shadow-2xl relative space-y-4">
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <h3 id="catModalTitle" class="text-sm font-bold text-white uppercase tracking-wider">Thêm Danh Mục Mới</h3>
      <button onclick="closeCategoryModal()" class="text-slate-400 hover:text-white p-1">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form id="categoryAdminForm" onsubmit="saveCategory(event)" class="space-y-4 text-xs">
      <input type="hidden" name="ma_danh_muc" id="catMaDanhMuc" />

      <div class="space-y-1">
        <label class="block font-bold text-slate-300">Tên Danh Mục *</label>
        <input type="text" name="ten_danh_muc" id="catTen" required placeholder="Ví dụ: Căn Hộ Studio Mini..." class="w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-xl text-white focus:outline-none focus:border-brand-accent" />
      </div>

      <div class="space-y-1">
        <label class="block font-bold text-slate-300">Link Ảnh Đại Diện (tùy chọn)</label>
        <input type="url" name="hinh_anh" id="catHinhAnh" placeholder="https://images.unsplash.com/..." class="w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-xl text-white focus:outline-none focus:border-brand-accent" />
      </div>

      <div class="space-y-1">
        <label class="block font-bold text-slate-300">Mô Tả Danh Mục</label>
        <textarea name="mo_ta" id="catMoTa" rows="3" placeholder="Mô tả đặc điểm loại hình phòng trọ..." class="w-full px-3 py-2 bg-slate-900 border border-white/10 rounded-xl text-white focus:outline-none focus:border-brand-accent resize-none"></textarea>
      </div>

      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="closeCategoryModal()" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl">Hủy</button>
        <button type="submit" class="px-5 py-2 bg-brand-primary hover:bg-brand-accent text-slate-950 font-bold rounded-xl">Lưu Danh Mục</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAddCategoryModal() {
    document.getElementById('catModalTitle').innerText = 'Thêm Danh Mục Mới';
    document.getElementById('catMaDanhMuc').value = '';
    document.getElementById('catTen').value = '';
    document.getElementById('catHinhAnh').value = '';
    document.getElementById('catMoTa').value = '';
    document.getElementById('categoryModal').classList.remove('hidden');
  }

  function editCategory(ma, ten, moTa, hinhAnh) {
    document.getElementById('catModalTitle').innerText = 'Chỉnh Sửa Danh Mục (' + ma + ')';
    document.getElementById('catMaDanhMuc').value = ma;
    document.getElementById('catTen').value = ten;
    document.getElementById('catMoTa').value = moTa;
    document.getElementById('catHinhAnh').value = hinhAnh;
    document.getElementById('categoryModal').classList.remove('hidden');
  }

  function closeCategoryModal() {
    document.getElementById('categoryModal').classList.add('hidden');
  }

  async function saveCategory(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const ma_danh_muc = data.ma_danh_muc;

    const url = ma_danh_muc ? ('/api/category/' + ma_danh_muc) : '/api/category';
    const method = ma_danh_muc ? 'PUT' : 'POST';

    try {
      const res = await fetch(url, {
        method: method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        window.showAdminToast('Lưu thông tin danh mục thành công!');
        closeCategoryModal();
        setTimeout(() => location.reload(), 600);
      } else {
        alert('Lưu thất bại: ' + result.message);
      }
    } catch(err) {
      alert('Lỗi kết nối máy chủ!');
    }
  }

  async function deleteCategory(ma) {
    if (!confirm('Bạn có chắc chắn muốn xóa danh mục này?')) return;
    try {
      const res = await fetch('/api/category/' + ma, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) {
        window.showAdminToast('Đã xóa danh mục thành công!');
        setTimeout(() => location.reload(), 600);
      } else {
        alert('Xóa thất bại: ' + result.message);
      }
    } catch(err) {
      alert('Lỗi kết nối máy chủ!');
    }
  }
</script>
