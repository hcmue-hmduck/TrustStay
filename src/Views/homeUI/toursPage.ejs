<!-- Scripts for Search, Filtering & State Management -->
<script>
    // 1. Lấy dữ liệu thô được truyền trực tiếp từ Controller (qua thẻ Script JSON) để phục vụ việc mở Modal và Tính toán
    const dbTours = JSON.parse(document.getElementById('tours-raw-data').textContent);
    
    // Thêm các thuộc tính tính toán động cho client
    const toursData = dbTours.map(tour => {
        const discountPercent = tour.gia_khuyen_mai > 0 
            ? Math.round(((tour.gia_nguoi_lon - tour.gia_khuyen_mai) / tour.gia_nguoi_lon) * 100)
            : 0;
            
        const rating = (4.5 + (tour.ten_tour.length % 5) * 0.1).toFixed(1);
        const reviewCount = 80 + (tour.ten_tour.length % 10) * 25;

        return {
            ...tour,
            discountPercent,
            rating,
            reviewCount,
            currentPrice: tour.gia_khuyen_mai > 0 ? tour.gia_khuyen_mai : tour.gia_nguoi_lon
        };
    });

    // 2. Đồng bộ danh sách yêu thích và vé đặt qua localStorage
    let favorites = JSON.parse(localStorage.getItem('tpv_favorites')) || ['pkg-hoian'];
    let myBookings = JSON.parse(localStorage.getItem('tpv_bookings')) || [
        {
            id: 'B-1004',
            tourId: 'pkg-halong',
            tourTitle: 'Vịnh Hạ Long 2 Ngày 1 Đêm',
            fullName: 'Huong',
            phone: '0912345678',
            email: 'huynhmyduc2005@gmail.com',
            startDate: '2026-06-15',
            guestsCount: 2,
            totalPrice: 7600000,
            status: 'confirmed',
            bookingDate: '2026-06-01'
        }
    ];

    // State Filter Variables
    let currentSearch = '';
    let currentDeparture = '';
    let selectedCategories = [];
    let maxPriceLimit = 8000000;
    let selectedDurations = [];
    let showHighlightsOnly = false;
    let currentSort = 'default';


    // Save states helper
    function saveState(key, val) {
        localStorage.setItem(key, JSON.stringify(val));
    }

    // Toast notifications
    function showToast(message) {
        const toast = document.getElementById('toast-notification');
        const text = document.getElementById('toast-text');
        if (!toast || !text) return;
        text.innerText = message;
        toast.classList.remove('hidden');
        setTimeout(() => {
            toast.classList.remove('opacity-0', '-translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');
        }, 50);

        setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', '-translate-y-4');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 300);
        }, 3000);
    }

    // Render Filters Elements on Startup
    function initFiltersUI() {

        // 3. Translate EJS Categories to human-readable names on initial page load
        document.querySelectorAll('.category-badge').forEach(badge => {
            const catId = badge.getAttribute('data-cat-id');
            badge.innerText = 'Hành trình';
        });
    }

    // Toggle Category in filters
    function toggleCategoryFilter(id, checked) {
        if (checked) {
            selectedCategories.push(id);
        } else {
            selectedCategories = selectedCategories.filter(c => c !== id);
        }
        applyFilters();
    }

    // Apply client-side filters by toggling visibility of EJS elements
    function applyFilters() {
        const cards = Array.from(document.querySelectorAll('.tour-card-item'));
        let visibleCount = 0;

        cards.forEach(card => {
            const category = card.getAttribute('data-category');
            const price = parseInt(card.getAttribute('data-price'));
            const departure = card.getAttribute('data-departure');
            const durationDays = parseInt(card.getAttribute('data-duration-days'));
            const featured = card.getAttribute('data-featured') === 'true';
            const searchContent = card.getAttribute('data-search-content');

            // Keyword match
            const matchSearch = !currentSearch || searchContent.includes(currentSearch.toLowerCase());

            // Departure match
            const matchDep = !currentDeparture || departure === currentDeparture;

            // Categories match
            const matchCat = selectedCategories.length === 0 || selectedCategories.includes(category);

            // Price match
            const matchPrice = price <= maxPriceLimit;

            // Duration match
            let matchDur = true;
            if (selectedDurations.length > 0) {
                matchDur = false;
                if (selectedDurations.includes('short') && durationDays < 3) matchDur = true;
                if (selectedDurations.includes('medium') && durationDays >= 3 && durationDays <= 4) matchDur = true;
                if (selectedDurations.includes('long') && durationDays > 4) matchDur = true;
            }

            // Highlights
            const matchHighlight = !showHighlightsOnly || featured === true;

            const isVisible = matchSearch && matchDep && matchCat && matchPrice && matchDur && matchHighlight;
            
            if (isVisible) {
                card.classList.remove('hidden');
                visibleCount++;
            } else {
                card.classList.add('hidden');
            }
        });

        // Toggle Empty state view
        const noResults = document.getElementById('no-results-panel');
        if (visibleCount === 0) {
            noResults.classList.remove('hidden');
        } else {
            noResults.classList.add('hidden');
        }

        // Apply Sorting
        applySorting();

        // Update counts
        const countBadge = document.getElementById('results-count-badge');
        countBadge.innerText = `Tìm thấy ${visibleCount} tours`;

        // Active filters notification
        const activeFilterBadge = document.getElementById('active-filter-badge');
        const filtersActive = currentSearch || currentDeparture || selectedCategories.length > 0 || maxPriceLimit < 8000000 || selectedDurations.length > 0 || showHighlightsOnly;
        if (filtersActive) {
            activeFilterBadge.classList.remove('hidden');
        } else {
            activeFilterBadge.classList.add('hidden');
        }
    }

    // Sort pre-rendered HTML DOM children
    function applySorting() {
        const grid = document.getElementById('tours-listing-grid');
        if (!grid) return;
        const cards = Array.from(grid.querySelectorAll('.tour-card-item'));
        
        cards.sort((a, b) => {
            if (currentSort === 'price-asc') {
                return parseInt(a.getAttribute('data-price')) - parseInt(b.getAttribute('data-price'));
            } else if (currentSort === 'price-desc') {
                return parseInt(b.getAttribute('data-price')) - parseInt(a.getAttribute('data-price'));
            } else if (currentSort === 'rating-desc') {
                return parseFloat(b.getAttribute('data-rating')) - parseFloat(a.getAttribute('data-rating'));
            } else if (currentSort === 'name-asc') {
                return a.getAttribute('data-title').localeCompare(b.getAttribute('data-title'));
            } else {
                // Default: features/la_noi_bat first
                const featA = a.getAttribute('data-featured') === 'true' ? 1 : 0;
                const featB = b.getAttribute('data-featured') === 'true' ? 1 : 0;
                return featB - featA;
            }
        });

        // Re-append cards in sorted order
        cards.forEach(card => grid.appendChild(card));
    }

    // Reset all filters
    function resetFilters() {
        document.getElementById('filter-search-input').value = '';
        document.getElementById('filter-departure-select').value = '';
        document.getElementById('filter-price-slider').value = 8000000;
        document.getElementById('price-limit-display').innerText = '8,000,000 đ';
        document.getElementById('filter-highlight-check').checked = false;
        
        document.querySelectorAll('.category-checkbox').forEach(cb => cb.checked = false);
        document.querySelectorAll('input[name="duration"]').forEach(cb => cb.checked = false);

        currentSearch = '';
        currentDeparture = '';
        selectedCategories = [];
        maxPriceLimit = 8000000;
        selectedDurations = [];
        showHighlightsOnly = false;
        currentSort = 'default';
        document.getElementById('sort-select').value = 'default';

        applyFilters();
        showToast("Đã khôi phục toàn bộ danh sách tours!");
    }

    // Toggle favorite and save
    function toggleFavorite(id) {
        if (favorites.includes(id)) {
            favorites = favorites.filter(favId => favId !== id);
            showToast(`Đã xóa khỏi danh sách yêu thích!`);
        } else {
            favorites.push(id);
            showToast(`Đã lưu vào danh sách yêu thích! ❤️`);
        }
        saveState('tpv_favorites', favorites);
        
        // Update all hearts in DOM immediately
        updateHeartIcons();

        // Update header dropdown (synchronized)
        if (window.updateFavoritesDropdown) {
            window.updateFavoritesDropdown();
        }
    }

    // Update Favorite heart icons in UI
    function updateHeartIcons() {
        document.querySelectorAll('.favorite-heart-icon').forEach(icon => {
            const favId = icon.getAttribute('data-fav-id');
            if (favorites.includes(favId)) {
                icon.classList.add('fill-red-500', 'text-red-500');
                icon.classList.remove('text-white');
            } else {
                icon.classList.remove('fill-red-500', 'text-red-500');
                icon.classList.add('text-white');
            }
        });
    }



    // Setup listeners
    document.addEventListener('DOMContentLoaded', () => {
        initFiltersUI();
        updateHeartIcons();
        applyFilters();

        // 1. Search keyword input event
        document.getElementById('filter-search-input').addEventListener('input', (e) => {
            currentSearch = e.target.value;
            applyFilters();
        });

        // 2. Departure select event
        document.getElementById('filter-departure-select').addEventListener('change', (e) => {
            currentDeparture = e.target.value;
            applyFilters();
        });

        // 3. Price slider event
        const slider = document.getElementById('filter-price-slider');
        const priceDisplay = document.getElementById('price-limit-display');
        slider.addEventListener('input', (e) => {
            maxPriceLimit = parseInt(e.target.value);
            priceDisplay.innerText = maxPriceLimit.toLocaleString('vi-VN') + ' đ';
            applyFilters();
        });

        // 4. Duration checkbox events
        document.querySelectorAll('input[name="duration"]').forEach(cb => {
            cb.addEventListener('change', () => {
                selectedDurations = Array.from(document.querySelectorAll('input[name="duration"]:checked')).map(el => el.value);
                applyFilters();
            });
        });

        // 5. Highlight checking event
        document.getElementById('filter-highlight-check').addEventListener('change', (e) => {
            showHighlightsOnly = e.target.checked;
            applyFilters();
        });

        // 6. Sorting event
        document.getElementById('sort-select').addEventListener('change', (e) => {
            currentSort = e.target.value;
            applyFilters();
        });



        // 8. Custom override for dropdown synchronizers in homeLayout.ejs
        window.updateFavoritesDropdown = () => {
            const listContainer = document.querySelector('#favorites-dropdown .space-y-3');
            const badge = document.querySelector('#favorites-toggle-btn span');
            const icon = document.querySelector('#favorites-toggle-btn i');
            if (!listContainer) return;
            listContainer.innerHTML = '';

            if (favorites.length === 0) {
                listContainer.innerHTML = `
                    <div class="text-center py-6 text-brand-muted text-xs">
                        <p class="mb-2">Danh sách yêu thích trống.</p>
                        <p class="text-[10px]">Nhấn ❤️ tại các tour để lưu trữ tiện lợi.</p>
                    </div>
                `;
                if (badge) badge.classList.add('hidden');
                if (icon) icon.classList.remove('fill-brand-accent');
            } else {
                if (badge) {
                    badge.classList.remove('hidden');
                    badge.textContent = favorites.length;
                }
                if (icon) icon.classList.add('fill-brand-accent');

                favorites.forEach(favId => {
                    const tour = toursData.find(t => t.ma_tour === favId);
                    if (!tour) return;
                    const item = document.createElement('div');
                    item.className = 'flex items-center gap-3 p-1.5 rounded-xl hover:bg-white/5 transition-colors cursor-pointer group';
                    item.onclick = () => {
                        window.location.href = `/tour-details/${tour._id}`;
                    };
                    item.innerHTML = `
                        <img src="${tour.hinh_anh_dai_dien}" alt="${tour.ten_tour}" class="w-12 h-12 rounded-lg object-cover" />
                        <div class="flex-1 min-w-0 text-left">
                            <p class="text-xs font-bold text-white group-hover:text-brand-primary transition-colors truncate">${tour.ten_tour}</p>
                            <p class="text-[10px] text-brand-muted flex items-center gap-1 mt-0.5">
                                <i data-lucide="map-pin" class="w-3 h-3 text-brand-accent"></i>
                                <span class="truncate">${tour.diem_khoi_hanh} khởi hành</span>
                            </p>
                            <p class="text-xs font-black text-brand-accent mt-0.5">${tour.currentPrice.toLocaleString('vi-VN')} đ</p>
                        </div>
                        <button 
                            onclick="event.stopPropagation(); toggleFavorite('${tour.ma_tour}');"
                            class="p-1 text-red-400 hover:text-red-300 hover:bg-white/5 rounded"
                            title="Xóa khỏi yêu thích"
                        >
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    `;
                    listContainer.appendChild(item);
                });
                lucide.createIcons();
            }
        };



        window.updateFavoritesDropdown();
        window.updateBookingsDropdown();
    });
</script>
