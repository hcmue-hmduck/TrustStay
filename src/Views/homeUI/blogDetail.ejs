<% if (data) { %>

<div class="max-w-screen-xl mx-auto px-4 md:px-8 py-8 text-left space-y-8">

  <!-- Breadcrumb -->
  <div class="flex flex-wrap items-center gap-2 text-xs text-brand-muted">
    <a href="/" class="hover:text-brand-accent transition-colors flex items-center gap-1">
      <i data-lucide="home" class="w-3.5 h-3.5"></i>
      <span>Trang chủ</span>
    </a>
    <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-white/20"></i>
    <a href="/blogs" class="hover:text-brand-accent transition-colors">Góc Chia Sẻ & Review</a>
    <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-white/20"></i>
    <span class="text-brand-accent font-bold truncate max-w-xs"><%= data.tieu_de %></span>
  </div>

  <!-- Main Article Container -->
  <article class="glass-panel p-6 md:p-10 rounded-3xl border border-white/10 space-y-8 shadow-2xl relative overflow-hidden">
    
    <!-- Decorative Glow -->
    <div class="absolute -top-32 -right-32 w-80 h-80 bg-brand-accent/10 blur-[120px] rounded-full pointer-events-none"></div>

    <!-- Article Header -->
    <div class="space-y-4 border-b border-white/10 pb-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="px-3.5 py-1.5 bg-brand-accent/15 border border-brand-accent/30 text-brand-accent text-xs font-bold rounded-full flex items-center gap-1.5">
          <i data-lucide="user-check" class="w-3.5 h-3.5"></i>
          <span>Chia sẻ từ Người Thuê</span>
        </span>
        <span class="text-xs text-brand-muted flex items-center gap-1.5">
          <i data-lucide="calendar" class="w-3.5 h-3.5 text-brand-accent"></i>
          <span><%= new Date(data.createdAt || Date.now()).toLocaleDateString('vi-VN') %></span>
        </span>
      </div>

      <h1 class="text-2xl md:text-4xl font-black text-white leading-tight"><%= data.tieu_de %></h1>
    </div>

    <!-- Cover Image -->
    <% if (data.hinh_anh_dai_dien) { %>
      <div class="relative aspect-[16/9] md:aspect-[21/9] rounded-3xl overflow-hidden glass-panel border border-white/10 shadow-2xl">
        <img src="<%= data.hinh_anh_dai_dien %>" alt="<%= data.tieu_de %>" class="w-full h-full object-cover" />
      </div>
    <% } %>

    <!-- Summary Box -->
    <% if (data.tom_tat) { %>
      <div class="p-5 rounded-2xl bg-brand-accent/10 border border-brand-accent/20 text-xs md:text-sm text-brand-accent leading-relaxed font-semibold">
        <i data-lucide="quote" class="w-5 h-5 text-brand-accent mb-2 inline-block"></i>
        <span><%= data.tom_tat %></span>
      </div>
    <% } %>

    <!-- Body Content -->
    <div class="text-sm md:text-base text-white/90 leading-relaxed whitespace-pre-line space-y-4 font-normal">
      <%= (data.noi_dung || data.tom_tat || '').trim() %>
    </div>

    <!-- Article Footer / Share Banner -->
    <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-white/10 text-xs text-brand-muted">
      <a href="/blogs" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/10 text-white font-bold hover:border-brand-accent hover:text-brand-accent transition-all">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Quay lại danh sách bài viết</span>
      </a>

      <div class="flex items-center gap-2">
        <i data-lucide="shield-check" class="w-4 h-4 text-green-400"></i>
        <span>Bài viết chia sẻ kinh nghiệm được duyệt bởi TrustStay</span>
      </div>
    </div>

  </article>

  <!-- Related Articles Section -->
  <% if (relatedBlogs && relatedBlogs.length > 0) { %>
    <div class="space-y-6 pt-6">
      <div class="flex items-center justify-between">
        <h3 class="text-xl font-black text-white flex items-center gap-2">
          <i data-lucide="sparkles" class="w-5 h-5 text-brand-accent"></i>
          <span>Bài Chia Sẻ Liên Quan</span>
        </h3>
        <a href="/blogs" class="text-xs font-bold text-brand-accent hover:underline flex items-center gap-1">
          Xem tất cả <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% relatedBlogs.forEach(blog => { %>
          <div class="glass-panel rounded-2xl overflow-hidden border border-white/10 flex flex-col group hover:-translate-y-1 hover:border-brand-accent/30 transition-all duration-300">
            <div class="relative h-44 overflow-hidden">
              <img src="<%= blog.hinh_anh_dai_dien || 'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=800&q=80' %>" 
                   alt="<%= blog.tieu_de %>" 
                   class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div class="space-y-2">
                <span class="text-[10px] font-bold text-brand-accent uppercase tracking-wider block">
                  <%= new Date(blog.createdAt || Date.now()).toLocaleDateString('vi-VN') %>
                </span>
                <h4 class="text-sm font-bold text-white line-clamp-2 group-hover:text-brand-accent transition-colors">
                  <a href="/blogs/<%= blog.ma_bai_viet %>"><%= blog.tieu_de %></a>
                </h4>
              </div>

              <div class="pt-4 mt-2 border-t border-white/5">
                <a href="/blogs/<%= blog.ma_bai_viet %>" class="text-xs text-brand-accent font-bold hover:underline flex items-center gap-1">
                  Đọc tiếp <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

</div>

<% } else { %>
  <div class="max-w-md mx-auto py-20 text-center space-y-4">
    <h2 class="text-2xl font-bold text-white">Không tìm thấy bài viết</h2>
    <a href="/blogs" class="inline-block px-6 py-2.5 bg-brand-accent text-brand-dark font-bold text-xs rounded-xl">Quay lại góc chia sẻ</a>
  </div>
<% } %>

<script>
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
</script>
