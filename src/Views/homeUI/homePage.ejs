                      </div>

                      <!-- Favorite button toggle -->
                      <button 
                        onclick="toggleFavorite('${pkg.id}')"
                        class="absolute top-4 right-4 w-9 h-9 rounded-full bg-brand-dark/50 backdrop-blur-md flex items-center justify-center text-white hover:text-brand-accent transition-all active:scale-90"
                        title="${isFav ? "Xoá khỏi yêu thích" : "Yêu thích"}"
                      >
                        <i data-lucide="heart" class="w-4 h-4 ${isFav ? 'fill-red-500 text-red-500' : 'text-white'}"></i>
                      </button>
                    </div>

                    <!-- Card Details -->
                    <div class="p-5 flex-1 flex flex-col justify-between text-left">
                      <div>
                        <!-- Map Location -->
                        <div class="flex items-center gap-1 text-brand-muted/90 text-[10px] font-black uppercase mb-1.5 tracking-wider">
                          <i data-lucide="map-pin" class="w-3 h-3 text-brand-accent"></i>
                          <span>${pkg.location}</span>
                        </div>

                        <!-- Title -->
                        <h4 class="text-white font-extrabold text-sm md:text-base group-hover:text-brand-accent transition-colors line-clamp-1">${pkg.title}</h4>
                        
                        <!-- Specs -->
                        <div class="flex items-center gap-3 text-brand-muted text-[11px] font-semibold mt-3.5 mb-4">
                          <span class="flex items-center gap-1">
                            <i data-lucide="clock" class="w-3.5 h-3.5 text-brand-accent"></i>
                            <span>${pkg.duration}</span>
                          </span>
                          <span class="flex items-center gap-1">
                            <i data-lucide="users" class="w-3.5 h-3.5 text-brand-accent"></i>
                            <span>Tối đa ${pkg.maxGuests} khách</span>
                          </span>
                        </div>

                        <!-- Star Rating summary -->
                        <div class="flex items-center justify-between pb-3.5 mb-3.5 border-b border-white/5">
                          <div class="flex items-center gap-1 text-xs">
                            <i data-lucide="star" class="w-3.5 h-3.5 text-yellow-400 fill-yellow-400"></i>
                            <span class="text-white font-black">${pkg.rating}</span>
                            <span class="text-brand-muted">(${pkg.reviewCount})</span>
                          </div>
                          <span class="text-[10px] bg-brand-secondary/10 px-2 py-0.5 rounded text-brand-secondary uppercase font-semibold">Bảo đảm</span>
