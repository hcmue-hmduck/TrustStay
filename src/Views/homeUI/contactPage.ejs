<script>
    function handleContactSubmit(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        alert('Cảm ơn bạn ' + data.ho_ten + '! Yêu cầu tư vấn "' + data.tieu_de + '" đã được gửi tới TrustStay. Bộ phận CSKH sẽ liên hệ với bạn qua SĐT ' + data.so_dien_thoai + ' trong thời gian sớm nhất.');
        form.reset();
    }

    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>