<div class="max-w-screen-2xl mx-auto px-4 md:px-8 py-12">

  <!-- Header Banner -->
  <div class="mb-10 text-left">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-50 border border-sky-200 text-sky-700 text-xs font-black uppercase tracking-wider mb-3">
      <i data-lucide="home" class="w-4 h-4"></i>
      <span>Danh mục phòng trọ</span>
    </div>
    <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">Tìm Kiếm Phòng Trọ Phù Hợp</h1>
    <p class="text-xs md:text-sm text-slate-500 mt-1.5">Danh sách tất cả các phòng trọ khép kín, căn hộ studio, ký túc xá chất lượng cao</p>
  </div>

  <!-- Filter & Search Panel -->
  <div class="glass-panel p-6 md:p-8 rounded-3xl mb-10 border border-white/80 shadow-2xl text-left">
    <form action="/rooms" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
      
      <!-- Category Filter -->
      <div>
        <label class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5">Loại phòng</label>
        <div class="relative">
          <select name="ma_danh_muc" class="w-full bg-white/90 border border-slate-300/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 font-medium focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 appearance-none cursor-pointer">
            <option value="" class="bg-white text-slate-900">Tất cả loại phòng</option>
            <% category.forEach(cat => { %>
              <option value="<%= cat.ma_danh_muc %>" <%= filter.ma_danh_muc === cat.ma_danh_muc ? 'selected' : '' %> class="bg-white text-slate-900"><%= cat.ten_danh_muc %></option>
            <% }) %>
          </select>
          <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 absolute right-3 top-3 pointer-events-none"></i>
        </div>
      </div>

      <!-- Location Filter -->
      <div>
        <label class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5">Khu vực</label>
        <div class="relative">
          <select name="ma_dia_diem" class="w-full bg-white/90 border border-slate-300/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 font-medium focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 appearance-none cursor-pointer">
            <option value="" class="bg-white text-slate-900">Tất cả khu vực</option>
            <% location.forEach(loc => { %>
              <option value="<%= loc.ma_dia_diem %>" <%= filter.ma_dia_diem === loc.ma_dia_diem ? 'selected' : '' %> class="bg-white text-slate-900"><%= loc.ten_dia_diem %></option>
            <% }) %>
          </select>
          <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 absolute right-3 top-3 pointer-events-none"></i>
        </div>
      </div>

      <!-- Max Price Filter -->
      <div>
        <label class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5">Mức giá thuê</label>
        <div class="relative">
          <select name="gia_max" class="w-full bg-white/90 border border-slate-300/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 font-medium focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 appearance-none cursor-pointer">
            <option value="" class="bg-white text-slate-900">Tất cả mức giá</option>
            <option value="2000000" <%= filter.gia_max === '2000000' ? 'selected' : '' %> class="bg-white text-slate-900">Dưới 2 Triệu/tháng</option>
            <option value="4000000" <%= filter.gia_max === '4000000' ? 'selected' : '' %> class="bg-white text-slate-900">Dưới 4 Triệu/tháng</option>
            <option value="6000000" <%= filter.gia_max === '6000000' ? 'selected' : '' %> class="bg-white text-slate-900">Dưới 6 Triệu/tháng</option>
            <option value="10000000" <%= filter.gia_max === '10000000' ? 'selected' : '' %> class="bg-white text-slate-900">Dưới 10 Triệu/tháng</option>
          </select>
          <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 absolute right-3 top-3 pointer-events-none"></i>
        </div>
      </div>

      <!-- Submit & Reset Buttons -->
      <div class="flex items-end gap-2">
        <button type="submit" class="flex-1 btn-primary-gradient text-white font-black py-2.5 px-4 rounded-xl transition-all shadow-md flex items-center justify-center gap-2 text-xs cursor-pointer hover:scale-105 active:scale-95">
          <i data-lucide="filter" class="w-4 h-4"></i>
          <span>Lọc phòng</span>
        </button>
        <a href="/rooms" class="p-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 border border-slate-200 rounded-xl transition-all" title="Bỏ lọc">
          <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
        </a>
      </div>

    </form>
  </div>

  <!-- Room Grid List -->
  <% if (data && data.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% data.forEach(room => { 
        const roomLoc = location.find(l => l.ma_dia_diem === room.ma_dia_diem) || {};
        const roomCat = category.find(c => c.ma_danh_muc === room.ma_danh_muc) || {};
      %>
        <div class="glass-card rounded-3xl overflow-hidden border border-slate-200/80 hover:border-sky-300 transition-all duration-500 shadow-md hover:shadow-2xl hover:shadow-sky-500/10 hover:-translate-y-1 flex flex-col group text-left">
          <!-- Thumbnail -->
          <div class="relative aspect-[16/10] overflow-hidden">
            <img src="<%= room.hinh_anh_dai_dien %>" alt="<%= room.ten_phong %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute top-3 left-3 px-3 py-1 bg-white/90 backdrop-blur-md rounded-full border border-slate-200/80 text-[10px] font-bold text-sky-700 uppercase shadow-sm">
              <%= roomCat.ten_danh_muc || 'Phòng trọ' %>
            </div>
            <% if (room.la_noi_bat) { %>
              <div class="absolute top-3 right-3 px-2.5 py-1 bg-gradient-to-r from-red-500 to-amber-500 text-white rounded-full text-[10px] font-black uppercase shadow-md flex items-center gap-1">
                <i data-lucide="star" class="w-3 h-3 fill-white"></i> HOT
              </div>
            <% } %>
          </div>

          <!-- Details -->
          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center gap-2 text-xs text-sky-600 font-semibold mb-1">
                <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
                <span><%= roomLoc.ten_dia_diem || 'TP.HCM' %></span>
                <% if (room.dien_tich) { %>
                  <span class="text-slate-300">•</span>
                  <i data-lucide="maximize" class="w-3.5 h-3.5 text-slate-400"></i>
                  <span class="text-slate-500"><%= room.dien_tich %> m²</span>
                <% } %>
              </div>

              <h3 class="text-base font-bold text-slate-900 group-hover:text-sky-600 transition-colors line-clamp-2 leading-snug">
                <a href="/room-details/<%= room.ma_phong %>"><%= room.ten_phong %></a>
              </h3>

              <p class="text-xs text-slate-500 line-clamp-2 mt-2 leading-relaxed">
                <%= room.mo_ta_ngan %>
              </p>
            </div>

            <!-- Amenities Badges Preview -->
            <% if (room.tien_nghi && room.tien_nghi.length > 0) { %>
              <div class="flex flex-wrap gap-1.5 pt-2 border-t border-slate-100">
                <% room.tien_nghi.slice(0, 3).forEach(item => { %>
                  <span class="px-2 py-0.5 bg-sky-50/80 text-sky-700 rounded-md text-[10px] font-bold border border-sky-100">
                    <%= item %>
                  </span>
                <% }) %>
                <% if (room.tien_nghi.length > 3) { %>
                  <span class="px-2 py-0.5 bg-sky-50/80 text-sky-700 rounded-md text-[10px] font-bold border border-sky-100">
                    +<%= room.tien_nghi.length - 3 %>
                  </span>
                <% } %>
              </div>
            <% } %>

            <!-- Footer Price & Action -->
            <div class="flex items-center justify-between pt-4 border-t border-slate-100">
              <div>
                <span class="text-[10px] text-slate-400 uppercase font-bold tracking-wider">Giá thuê</span>
                <p class="text-lg font-black bg-gradient-to-r from-sky-600 to-indigo-600 bg-clip-text text-transparent">
                  <%= room.gia_thue.toLocaleString('vi-VN') %> <span class="text-xs font-normal text-slate-500">đ/tháng</span>
                </p>
              </div>

              <a href="/room-details/<%= room.ma_phong %>" class="px-4 py-2 bg-gradient-to-r from-sky-600 to-indigo-600 hover:from-sky-700 hover:to-indigo-700 text-white rounded-xl text-xs font-bold transition-all shadow-md shadow-sky-500/20 flex items-center gap-1.5 cursor-pointer hover:scale-105 active:scale-95">
                <span>Xem chi tiết</span>
                <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="glass-card p-16 rounded-3xl text-center space-y-4 max-w-lg mx-auto border border-slate-200/90 shadow-xl">
      <div class="w-16 h-16 rounded-full bg-sky-100 flex items-center justify-center text-sky-600 mx-auto shadow-sm">
        <i data-lucide="search-x" class="w-8 h-8"></i>
      </div>
      <h3 class="text-xl font-bold text-slate-900">Không tìm thấy phòng trọ phù hợp</h3>
      <p class="text-xs text-slate-500 leading-relaxed">Vui lòng thử lại với các tiêu chí tìm kiếm khác hoặc xóa bộ lọc để xem toàn bộ danh sách phòng trọ.</p>
      <a href="/rooms" class="inline-flex items-center gap-2 px-6 py-2.5 btn-primary-gradient text-white font-bold text-xs rounded-xl shadow-md cursor-pointer hover:scale-105 transition-all">
        <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
        <span>Xóa bộ lọc</span>
      </a>
    </div>
  <% } %>

</div>


