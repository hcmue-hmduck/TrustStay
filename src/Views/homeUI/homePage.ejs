            originalId: 'pkg-halong'
        }
    ];

    let virtualIndex = 1; // Ninh Bình is index 1

    function setup3DCarousel() {
        const stage = document.getElementById('stage-3d');
        const dotsContainer = document.getElementById('dots-3d-container');
        if (!stage) return;

        // Render cards once
        stage.innerHTML = tours3DData.map((tour, idx) => {
            return `
                <div 
                    id="card-3d-${idx}"
                    onclick="select3DActive(${idx})"
                    class="carousel-3d-card rounded-3xl cursor-pointer"
                    style="transform: rotateY(${idx * 90}deg) translateZ(280px);"
                >
                    <div class="tilt-card-inner w-full h-full bg-slate-900/80 border border-white/10 rounded-3xl p-4 flex flex-col justify-between shadow-xl">
                        <!-- Top Image with Rating overlay -->
                        <div class="relative w-full h-[180px] rounded-2xl overflow-hidden mb-4">
                            <img src="${tour.image}" alt="${tour.title}" class="w-full h-full object-cover" />
                            <div class="absolute top-3 right-3 bg-black/50 backdrop-blur-md px-2.5 py-1 rounded-full flex items-center gap-1 border border-white/10 text-white text-[10px] font-bold">
                                <i data-lucide="star" class="w-3 h-3 fill-yellow-500 text-yellow-500"></i>
                                <span>${tour.rating}</span>
                            </div>
                        </div>

                        <!-- Details -->
                        <div class="space-y-2 flex-1 flex flex-col justify-between">
                            <div class="space-y-1 text-left">
                                <div class="flex items-center gap-1 text-[10px] font-bold text-blue-400 uppercase">
                                    <i data-lucide="map-pin" class="w-3 h-3"></i>
                                    <span>${tour.location}</span>
                                </div>
                                <h4 class="text-sm font-black text-white leading-snug line-clamp-2">${tour.title}</h4>
                            </div>

                            <div class="pt-3 border-t border-white/5 flex items-center justify-between">
                                <div class="text-[10px] text-brand-muted flex items-center gap-1 font-bold">
                                    <i data-lucide="calendar" class="w-3 h-3"></i>
                                    <span>${tour.duration}</span>
                                </div>
                                <div class="text-right">
                                    <p class="text-[8px] text-brand-muted uppercase">Từ</p>
                                    <p class="text-xs font-black text-blue-400">${tour.price}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }).join('');

        // Render Dots once
        if (dotsContainer) {
            dotsContainer.innerHTML = tours3DData.map((_, idx) => {
                return `
                    <span 
                        id="dot-3d-${idx}"
                        onclick="clickDot3D(${idx})"
                        class="w-2.5 h-2.5 rounded-full cursor-pointer transition-all duration-300 bg-white/20 hover:bg-white/45"
                    ></span>
                `;
            }).join('');
        }

        // Apply initial rotation and classes
        updateCarouselState();
        init3DTilt();
    }

    function updateCarouselState() {
        const stage = document.getElementById('stage-3d');
        if (!stage) return;

        // Rotate stage without tilt
        stage.style.transform = `rotateY(${-virtualIndex * 90}deg)`;

        // Calculate current active index (modulo 4)
        const activeIdx = (virtualIndex % 4 + 4) % 4;

        // Update card styles
        tours3DData.forEach((_, idx) => {
            const card = document.getElementById(`card-3d-${idx}`);
            const dot = document.getElementById(`dot-3d-${idx}`);
            if (card) {
                const isActive = idx === activeIdx;
                const inner = card.querySelector('.tilt-card-inner');

                // Calculate billboard rotation so card always faces front
                const billboardRot = -idx * 90 + virtualIndex * 90;

                // Update transform with scale & translateZ
                card.style.transform = `rotateY(${idx * 90}deg) translateZ(320px) rotateY(${billboardRot}deg) scale(${isActive ? 1.05 : 0.8})`;

                if (isActive) {
                    card.classList.remove('opacity-50', 'z-10');
                    card.classList.add('opacity-100', 'z-20');
                    if (inner) {
                        inner.classList.add('border-blue-500', 'shadow-[0_0_25px_rgba(30,144,255,0.25)]');
                        inner.classList.remove('border-white/10');
                    }
                } else {
                    card.classList.remove('opacity-100', 'z-20');
                    card.classList.add('opacity-50', 'z-10');
                    if (inner) {
                        inner.classList.remove('border-blue-500', 'shadow-[0_0_25px_rgba(30,144,255,0.25)]');
                        inner.classList.add('border-white/10');
                    }
                }
            }

            if (dot) {
                if (idx === activeIdx) {
                    dot.classList.add('bg-blue-500', 'px-3');
                    dot.classList.remove('bg-white/20');
                } else {
                    dot.classList.remove('bg-blue-500', 'px-3');
                    dot.classList.add('bg-white/20');
                }
            }
        });

        // Update Bottom Showcase Box
        renderBottomShowcase(activeIdx);
    }

    function renderBottomShowcase(activeIdx) {
        const panel = document.getElementById('showcase-3d-panel');
        if (!panel) return;

        const tour = tours3DData[activeIdx];

        panel.innerHTML = `
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="space-y-3 flex-1 text-center md:text-left">
                    <h3 class="text-xl md:text-2xl font-black text-slate-800 leading-tight">${tour.title}</h3>
                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 text-xs text-slate-500 font-bold">
                        <span class="flex items-center gap-1">
                            <i data-lucide="map-pin" class="w-3.5 h-3.5 text-blue-600 fill-blue-600/10"></i>
                            <span>${tour.location}</span>
                        </span>
                        <span class="flex items-center gap-1">
                            <i data-lucide="calendar" class="w-3.5 h-3.5 text-blue-600"></i>
                            <span>${tour.duration}</span>
                        </span>
                        <span class="flex items-center gap-1">
                            <i data-lucide="star" class="w-3.5 h-3.5 text-yellow-500 fill-yellow-500"></i>
                            <span>${tour.rating}</span>
                        </span>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row items-center gap-6 w-full md:w-auto">
                    <div class="text-center sm:text-right">
                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider">Tổng giá vé từ</p>
                        <p class="text-2xl font-black text-blue-600">${tour.price}</p>
                    </div>
                    <button 
                        onclick="openBookingModal('${tour.originalId}')"
                        class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-full text-xs font-black transition-all flex items-center gap-2 cursor-pointer shadow-lg shadow-blue-600/20 active:scale-95 w-full sm:w-auto justify-center"
                    >
                        <span>Đặt tour ngay</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>
        `;
        lucide.createIcons();
    }

    function next3D() {
        virtualIndex++;
        updateCarouselState();
    }

    function prev3D() {
        virtualIndex--;
        updateCarouselState();
    }

    function select3DActive(idx) {
        clickDot3D(idx);
    }

    function clickDot3D(targetIdx) {
        const currentActualIdx = (virtualIndex % 4 + 4) % 4;
        let diff = targetIdx - currentActualIdx;
        if (diff > 2) diff -= 4;
        if (diff < -2) diff += 4;
        virtualIndex += diff;
        updateCarouselState();
    }

    function init3DTilt() {
        const cards = document.querySelectorAll('.carousel-3d-card');
        cards.forEach(card => {
            const inner = card.querySelector('.tilt-card-inner');
            if (!inner) return;

            card.addEventListener('mousemove', (e) => {
                if (!card.classList.contains('opacity-100')) return;

                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const xc = rect.width / 2;
                const yc = rect.height / 2;
                const angleX = (yc - y) / 8;
                const angleY = (x - xc) / 8;
                inner.style.transform = `rotateX(${angleX}deg) rotateY(${angleY}deg) scale3d(1.03, 1.03, 1.03)`;
            });
            card.addEventListener('mouseleave', () => {
                inner.style.transform = `rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
            });
        });
    }

    // App Initialization
    window.addEventListener('DOMContentLoaded', () => {
        renderStats();
        renderCategories();
        renderToursGrid();
        updateFavoritesDropdown();
        updateBookingsDropdown();
        setup3DCarousel();
    });
</script>