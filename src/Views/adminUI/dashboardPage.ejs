<div class="space-y-8 text-left">
  
  <!-- Page Title & Quick Actions -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-4 border-b border-slate-900">
    <div>
      <h1 class="text-2xl font-mono font-black text-white uppercase tracking-tight flex items-center gap-2">
        <i data-lucide="layout-dashboard" class="w-6 h-6 text-brand-accent"></i>
        <span>Bảng Điều Khiển Quản Trị TrustStay</span>
      </h1>
      <p class="text-xs text-brand-muted mt-1">Tổng quan hoạt động hệ thống, phòng trọ, lượt hẹn xem và bài viết kinh nghiệm</p>
    </div>

    <a href="/admin/rooms/create" class="px-5 py-2.5 bg-brand-primary hover:bg-brand-accent text-slate-950 font-bold text-xs rounded-xl transition-all shadow-lg flex items-center gap-2">
      <i data-lucide="plus-circle" class="w-4 h-4"></i>
      <span>Thêm Phòng Trọ Mới</span>
    </a>
  </div>

  <!-- Top Stat Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-5">
    
    <!-- Total Rooms -->
    <a href="/admin/rooms" class="glass-card p-5 rounded-3xl border border-white/5 shadow-xl space-y-2 hover:border-brand-accent/30 transition-all block">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-brand-muted uppercase font-bold tracking-wider">Tổng phòng trọ</span>
        <div class="w-8 h-8 rounded-xl bg-brand-primary/10 border border-brand-accent/20 flex items-center justify-center text-brand-accent">
          <i data-lucide="home" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-mono font-black text-white"><%= data ? data.length : 0 %></p>
      <p class="text-[10px] text-green-400 font-bold flex items-center gap-1">
        <i data-lucide="trending-up" class="w-3 h-3"></i>
        <span>Đang cho thuê</span>
      </p>
    </a>

    <!-- Viewing Requests -->
    <a href="/admin/requests" class="glass-card p-5 rounded-3xl border border-white/5 shadow-xl space-y-2 hover:border-brand-accent/30 transition-all block">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-brand-muted uppercase font-bold tracking-wider">Yêu cầu hẹn xem</span>
        <div class="w-8 h-8 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center text-green-400">
          <i data-lucide="calendar" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-mono font-black text-white"><%= requests ? requests.length : 0 %></p>
      <p class="text-[10px] text-brand-muted">Khách hẹn xem phòng</p>
    </a>

    <!-- Categories -->
    <a href="/admin/categories" class="glass-card p-5 rounded-3xl border border-white/5 shadow-xl space-y-2 hover:border-brand-accent/30 transition-all block">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-brand-muted uppercase font-bold tracking-wider">Danh mục phòng</span>
        <div class="w-8 h-8 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
          <i data-lucide="layers" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-mono font-black text-white"><%= categories ? categories.length : 0 %></p>
      <p class="text-[10px] text-purple-400 font-bold">Phân loại phòng trọ</p>
    </a>

    <!-- Locations -->
    <a href="/admin/locations" class="glass-card p-5 rounded-3xl border border-white/5 shadow-xl space-y-2 hover:border-brand-accent/30 transition-all block">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-brand-muted uppercase font-bold tracking-wider">Khu vực địa điểm</span>
        <div class="w-8 h-8 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
          <i data-lucide="map-pin" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-mono font-black text-white"><%= locations ? locations.length : 0 %></p>
      <p class="text-[10px] text-blue-400 font-bold">Quận huyện cho thuê</p>
    </a>

    <!-- Blog Experience Posts -->
    <a href="/admin/blogs" class="glass-card p-5 rounded-3xl border border-white/5 shadow-xl space-y-2 hover:border-brand-accent/30 transition-all block">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-brand-muted uppercase font-bold tracking-wider">Bài viết kinh nghiệm</span>
        <div class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
          <i data-lucide="book-open" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-mono font-black text-white"><%= blogs ? blogs.length : 0 %></p>
      <p class="text-[10px] text-cyan-400 font-bold">Góc người thuê chia sẻ</p>
    </a>

    <!-- System Status -->
    <div class="glass-card p-5 rounded-3xl border border-white/5 shadow-xl space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-brand-muted uppercase font-bold tracking-wider">Trạng thái</span>
        <div class="w-8 h-8 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center text-green-400">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-lg font-mono font-black text-green-400">ONLINE</p>
      <p class="text-[10px] text-brand-muted">TrustStay v1.0 Ready</p>
    </div>

  </div>

  <!-- Recent Rooms Table -->
  <div class="glass-card rounded-3xl border border-white/5 overflow-hidden shadow-2xl p-6 space-y-4">
    <div class="flex justify-between items-center pb-4 border-b border-slate-900">
      <h3 class="font-mono text-base font-bold text-white uppercase tracking-tight flex items-center gap-2">
        <i data-lucide="list" class="w-4 h-4 text-brand-accent"></i>
        <span>Danh Sách Tin Đăng Phòng Trọ Mới Nhất</span>
      </h3>
      <a href="/admin/rooms" class="text-xs text-brand-accent hover:underline font-bold flex items-center gap-1">
        <span>Quản lý tất cả phòng</span>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950/80 text-brand-muted uppercase text-[10px] tracking-wider font-mono border-b border-slate-900">
          <tr>
            <th class="p-3">Hình ảnh</th>
            <th class="p-3">Tên phòng trọ</th>
            <th class="p-3">Giá thuê</th>
            <th class="p-3">Diện tích</th>
            <th class="p-3">Trạng thái</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-900/60">
          <% if (data && data.length > 0) { %>
            <% data.slice(0, 5).forEach(room => { %>
              <tr class="hover:bg-white/[0.02]">
                <td class="p-3">
                  <img src="<%= room.hinh_anh_dai_dien %>" alt="<%= room.ten_phong %>" class="w-12 h-9 rounded object-cover border border-white/10" />
                </td>
                <td class="p-3 font-bold text-white max-w-xs truncate"><%= room.ten_phong %></td>
                <td class="p-3 font-black text-brand-accent"><%= room.gia_thue ? room.gia_thue.toLocaleString('vi-VN') : 0 %> đ</td>
                <td class="p-3 font-mono"><%= room.dien_tich %> m²</td>
                <td class="p-3">
                  <span class="px-2.5 py-0.5 bg-green-500/10 text-green-400 rounded-full text-[10px] font-bold border border-green-500/20">Hoạt động</span>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="p-4 text-center text-brand-muted">Chưa có phòng trọ nào.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Viewing Requests Section -->
  <div id="requests" class="glass-card rounded-3xl border border-white/5 overflow-hidden shadow-2xl p-6 space-y-4">
    <div class="flex justify-between items-center pb-4 border-b border-slate-900">
      <h3 class="font-mono text-base font-bold text-white uppercase tracking-tight flex items-center gap-2">
        <i data-lucide="phone-incoming" class="w-4 h-4 text-brand-accent"></i>
        <span>Danh Sách Đăng Ký Xem Phòng Mới Nhất</span>
      </h3>
      <a href="/admin/requests" class="text-xs text-brand-accent hover:underline font-bold flex items-center gap-1">
        <span>Xem tất cả yêu cầu</span>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-slate-950/80 text-brand-muted uppercase text-[10px] tracking-wider font-mono border-b border-slate-900">
          <tr>
            <th class="p-3">Mã yêu cầu</th>
            <th class="p-3">Họ tên khách</th>
            <th class="p-3">Số điện thoại</th>
            <th class="p-3">Email</th>
            <th class="p-3">Ghi chú</th>
            <th class="p-3">Trạng thái</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-900/60">
          <% if (requests && requests.length > 0) { %>
            <% requests.slice(0, 5).forEach(req => { %>
              <tr class="hover:bg-white/[0.02]">
                <td class="p-3 font-mono font-bold text-brand-accent"><%= req.ma_yeu_cau %></td>
                <td class="p-3 font-bold text-white"><%= req.ho_ten_khach %></td>
                <td class="p-3 text-brand-accent font-bold"><%= req.so_dien_thoai_khach %></td>
                <td class="p-3 text-brand-muted"><%= req.email_khach || '-' %></td>
                <td class="p-3 max-w-xs truncate text-slate-400"><%= req.ghi_chu || '-' %></td>
                <td class="p-3">
                  <% if (req.trang_thai === 'pending') { %>
                    <span class="px-2.5 py-0.5 bg-yellow-500/15 text-yellow-400 rounded-full text-[10px] font-bold">Chờ liên hệ</span>
                  <% } else { %>
                    <span class="px-2.5 py-0.5 bg-green-500/15 text-green-400 rounded-full text-[10px] font-bold">Đã xác nhận</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="p-4 text-center text-brand-muted">Chưa có yêu cầu hẹn xem phòng nào.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>
