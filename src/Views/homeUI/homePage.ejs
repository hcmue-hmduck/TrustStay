<div class="relative w-full overflow-hidden">

  <!-- Hero Section -->
  <section class="relative min-h-[580px] flex items-center justify-center pt-24 pb-16 px-4 md:px-8">
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=1920&q=80"
        alt="TrustStay Background" class="w-full h-full object-cover opacity-25" />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-50/80 via-slate-50/90 to-[#f8fafc]"></div>
    </div>

    <div class="relative z-10 max-w-5xl w-full text-center space-y-6">
      
      <!-- Brand Name & Slogan Block -->
      <div class="space-y-4 pt-2">
        <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full bg-sky-50 border border-sky-200 text-sky-700 text-xs md:text-sm font-black uppercase tracking-widest shadow-sm backdrop-blur-md">
          <i data-lucide="shield-check" class="w-4 h-4 text-sky-600"></i>
          <span>Nền tảng tìm phòng trọ minh bạch & uy tín</span>
        </div>

        <h1 class="font-mono text-5xl md:text-7xl font-black tracking-tight text-slate-900 uppercase">
          TRUST<span class="hero-gradient-text">STAY</span>
        </h1>

        <div class="flex items-center justify-center gap-3">
          <span class="h-0.5 w-12 md:w-16 bg-gradient-to-r from-transparent to-sky-400"></span>
          <p class="text-xl md:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-sky-600 via-blue-700 to-sky-500 tracking-wide font-sans">
            Trọ Thật — Trải Nghiệm Thật
          </p>
          <span class="h-0.5 w-12 md:w-16 bg-gradient-to-l from-transparent to-sky-400"></span>
        </div>
      </div>

      <p class="text-sm md:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed pt-1">
        Hàng nghìn phòng trọ khép kín, căn hộ mini, sleepbox giá tốt được xác thực thông tin chính xác. Liên hệ xem phòng trực tiếp nhanh chóng không qua trung gian!
      </p>

      <!-- Search Filter Widget Bar -->
      <div class="glass-panel p-5 md:p-8 rounded-3xl max-w-4xl mx-auto shadow-2xl mt-8 text-left border border-white/80">
        <form action="/rooms" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4">
          
          <!-- Category Filter -->
          <div>
            <label class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5">Loại phòng</label>
            <div class="relative">
              <select name="ma_danh_muc" class="w-full bg-white/90 border border-slate-300/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 font-medium focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 appearance-none cursor-pointer">
                <option value="" class="bg-white text-slate-900">Tất cả loại phòng</option>
                <% category.forEach(cat => { %>
                  <option value="<%= cat.ma_danh_muc %>" class="bg-white text-slate-900"><%= cat.ten_danh_muc %></option>
                <% }) %>
              </select>
              <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 absolute right-3 top-3 pointer-events-none"></i>
            </div>
          </div>

          <!-- Location Filter -->
          <div>
            <label class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5">Khu vực</label>
            <div class="relative">
              <select name="ma_dia_diem" class="w-full bg-white/90 border border-slate-300/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 font-medium focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 appearance-none cursor-pointer">
                <option value="" class="bg-white text-slate-900">Tất cả khu vực</option>
                <% location.forEach(loc => { %>
                  <option value="<%= loc.ma_dia_diem %>" class="bg-white text-slate-900"><%= loc.ten_dia_diem %></option>
                <% }) %>
              </select>
              <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 absolute right-3 top-3 pointer-events-none"></i>
            </div>
          </div>

          <!-- Price Filter -->
          <div>
            <label class="block text-[11px] font-extrabold text-slate-700 uppercase tracking-wider mb-1.5">Giá tối đa (/tháng)</label>
            <div class="relative">
              <select name="gia_max" class="w-full bg-white/90 border border-slate-300/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 font-medium focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 appearance-none cursor-pointer">
                <option value="" class="bg-white text-slate-900">Mọi mức giá</option>
                <option value="2000000" class="bg-white text-slate-900">Dưới 2 Triệu</option>
                <option value="4000000" class="bg-white text-slate-900">Dưới 4 Triệu</option>
                <option value="6000000" class="bg-white text-slate-900">Dưới 6 Triệu</option>
                <option value="10000000" class="bg-white text-slate-900">Dưới 10 Triệu</option>
              </select>
              <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 absolute right-3 top-3 pointer-events-none"></i>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="flex items-end">
            <button type="submit" class="w-full btn-primary-gradient text-white font-black py-3 px-4 rounded-xl transition-all shadow-md flex items-center justify-center gap-2 text-xs uppercase tracking-wider cursor-pointer hover:scale-[1.02] active:scale-95">
              <i data-lucide="search" class="w-4 h-4"></i>
              <span>Tìm Phòng Trọ</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="max-w-screen-2xl mx-auto px-4 md:px-8 py-12">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
      <div>
        <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">Loại Hình Phòng Trọ Phổ Biến</h2>
        <p class="text-xs text-slate-500 mt-1">Đa dạng sự lựa chọn đáp ứng mọi nhu cầu ở từ cá nhân tới gia đình</p>
      </div>
      <a href="/rooms" class="text-xs font-bold text-sky-600 hover:underline flex items-center gap-1">
        <span>Xem tất cả loại phòng</span>
        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% category.forEach(cat => { %>
        <a href="/rooms?ma_danh_muc=<%= cat.ma_danh_muc %>" class="group relative rounded-3xl overflow-hidden bg-white border border-slate-200 hover:border-sky-400 transition-all duration-300 shadow-md hover:shadow-xl h-64 flex flex-col justify-end p-6">
          <img src="<%= cat.hinh_anh %>" alt="<%= cat.ten_danh_muc %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 brightness-[0.7]" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/30 to-transparent"></div>
          <div class="relative z-10">
            <h3 class="text-lg font-black text-white group-hover:text-sky-300 transition-colors"><%= cat.ten_danh_muc %></h3>
            <p class="text-[11px] text-slate-200 line-clamp-2 mt-1 opacity-90"><%= cat.mo_ta %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </section>

  <!-- Featured Rooms Section -->
  <section class="max-w-screen-2xl mx-auto px-4 md:px-8 py-12">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-50 border border-red-200 text-red-600 text-[10px] font-bold uppercase tracking-wider mb-2">
          <i data-lucide="flame" class="w-3.5 h-3.5"></i>
          <span>Tin đăng nổi bật</span>
        </div>
        <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">Phòng Trọ Nổi Bật Mới Đăng</h2>
      </div>

      <a href="/rooms" class="text-xs font-bold text-sky-600 hover:underline flex items-center gap-1">
        <span>Xem tất cả danh sách</span>
        <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <!-- Carousel Container -->
    <div id="featured-rooms-carousel" class="relative group/carousel">
      <!-- Side Nav Overlay Buttons for desktop -->
      <button id="featured-prev-btn-side" aria-label="Phòng trước" class="hidden md:flex absolute -left-5 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white border border-slate-200 text-slate-700 items-center justify-center hover:bg-sky-600 hover:text-white transition-all duration-300 shadow-xl opacity-0 group-hover/carousel:opacity-100 active:scale-95">
        <i data-lucide="chevron-left" class="w-6 h-6"></i>
      </button>
      <button id="featured-next-btn-side" aria-label="Phòng tiếp theo" class="hidden md:flex absolute -right-5 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white border border-slate-200 text-slate-700 items-center justify-center hover:bg-sky-600 hover:text-white transition-all duration-300 shadow-xl opacity-0 group-hover/carousel:opacity-100 active:scale-95">
        <i data-lucide="chevron-right" class="w-6 h-6"></i>
      </button>

      <!-- Carousel Viewport & Track -->
      <div class="overflow-hidden rounded-3xl py-2 px-1">
        <div id="featured-carousel-track" class="flex transition-transform duration-500 ease-out -mx-3">
          <% room_noi_bat.forEach(room => { 
            const roomLoc = location.find(l => l.ma_dia_diem === room.ma_dia_diem) || {};
            const roomCat = category.find(c => c.ma_danh_muc === room.ma_danh_muc) || {};
          %>
            <div class="w-full md:w-1/2 lg:w-1/3 flex-shrink-0 px-3">
              <div class="glass-card rounded-3xl overflow-hidden border border-slate-200/80 hover:border-sky-300 transition-all duration-500 shadow-md hover:shadow-2xl hover:shadow-sky-500/10 hover:-translate-y-1 flex flex-col group h-full">
                <!-- Thumbnail -->
                <div class="relative aspect-[16/10] overflow-hidden">
                  <img src="<%= room.hinh_anh_dai_dien %>" alt="<%= room.ten_phong %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  <div class="absolute top-3 left-3 px-3 py-1 bg-white/90 backdrop-blur-md rounded-full border border-slate-200/80 text-[10px] font-bold text-sky-700 uppercase shadow-sm">
                    <%= roomCat.ten_danh_muc || 'Phòng trọ' %>
                  </div>
                  <% if (room.la_noi_bat) { %>
                    <div class="absolute top-3 right-3 px-2.5 py-1 bg-gradient-to-r from-red-500 to-amber-500 text-white rounded-full text-[10px] font-black uppercase shadow-md flex items-center gap-1">
                      <i data-lucide="star" class="w-3 h-3 fill-white"></i> HOT
                    </div>
                  <% } %>
                </div>

                <!-- Details -->
                <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                  <div>
                    <div class="flex items-center gap-2 text-xs text-sky-600 font-semibold mb-1">
                      <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
                      <span><%= roomLoc.ten_dia_diem || 'TP.HCM' %></span>
                      <% if (room.dien_tich) { %>
                        <span class="text-slate-300">•</span>
                        <i data-lucide="maximize" class="w-3.5 h-3.5 text-slate-400"></i>
                        <span class="text-slate-500"><%= room.dien_tich %> m²</span>
                      <% } %>
                    </div>

                    <h3 class="text-base font-bold text-slate-900 group-hover:text-sky-600 transition-colors line-clamp-2 leading-snug">
                      <a href="/room-details/<%= room.ma_phong %>"><%= room.ten_phong %></a>
                    </h3>

                    <p class="text-xs text-slate-500 line-clamp-2 mt-2 leading-relaxed">
                      <%= room.mo_ta_ngan %>
                    </p>
                  </div>

                  <!-- Amenities Badges Preview -->
                  <% if (room.tien_nghi && room.tien_nghi.length > 0) { %>
                    <div class="flex flex-wrap gap-1.5 pt-2 border-t border-slate-100">
                      <% room.tien_nghi.slice(0, 3).forEach(item => { %>
                        <span class="px-2 py-0.5 bg-sky-50/80 text-sky-700 rounded-md text-[10px] font-bold border border-sky-100">
                          <%= item %>
                        </span>
                      <% }) %>
                      <% if (room.tien_nghi.length > 3) { %>
                        <span class="px-2 py-0.5 bg-sky-50/80 text-sky-700 rounded-md text-[10px] font-bold border border-sky-100">
                          +<%= room.tien_nghi.length - 3 %>
                        </span>
                      <% } %>
                    </div>
                  <% } %>

                  <!-- Footer Price & Action -->
                  <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                    <div>
                      <span class="text-[10px] text-slate-400 uppercase font-bold tracking-wider">Giá thuê</span>
                      <p class="text-lg font-black bg-gradient-to-r from-sky-600 to-indigo-600 bg-clip-text text-transparent">
                        <%= room.gia_thue.toLocaleString('vi-VN') %> <span class="text-xs font-normal text-slate-500">đ/tháng</span>
                      </p>
                    </div>

                    <a href="/room-details/<%= room.ma_phong %>" class="px-4 py-2 bg-gradient-to-r from-sky-600 to-indigo-600 hover:from-sky-700 hover:to-indigo-700 text-white rounded-xl text-xs font-bold transition-all shadow-md shadow-sky-500/20 hover:scale-105 active:scale-95 flex items-center gap-1.5">
                      <span>Liên hệ xem</span>
                      <i data-lucide="phone-call" class="w-3.5 h-3.5"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Carousel Footer Controls & Autoplay indicator -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-6 px-1">
        <!-- Autoplay Status & Progress Bar -->
        <div class="flex items-center gap-3 text-xs text-slate-500">
          <div class="flex items-center gap-1.5">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-600"></span>
            </span>
            <span class="text-[11px] font-medium">Tự động chuyển sau 10s</span>
          </div>
          <div class="w-28 h-1.5 bg-slate-200 rounded-full overflow-hidden">
            <div id="featured-autoplay-bar" class="h-full bg-sky-600 rounded-full transition-all ease-linear" style="width: 0%;"></div>
          </div>
        </div>

        <!-- Carousel Pagination Dots -->
        <div id="featured-carousel-dots" class="flex items-center gap-2"></div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const track = document.getElementById('featured-carousel-track');
      if (!track) return;

      const prevBtn = document.getElementById('featured-prev-btn');
      const nextBtn = document.getElementById('featured-next-btn');
      const prevSideBtn = document.getElementById('featured-prev-btn-side');
      const nextSideBtn = document.getElementById('featured-next-btn-side');
      const dotsContainer = document.getElementById('featured-carousel-dots');
      const progressBar = document.getElementById('featured-autoplay-bar');
      const carouselContainer = document.getElementById('featured-rooms-carousel');

      const items = track.children;
      const totalItems = items.length;
      if (totalItems === 0) return;

      let currentIndex = 0;
      let progressTimer = null;
      const AUTOPLAY_DELAY = 10000; // 10s
      const PROGRESS_INTERVAL = 100; // update progress every 100ms
      let progressElapsed = 0;

      function getVisibleCount() {
        if (window.innerWidth >= 1024) return 3;
        if (window.innerWidth >= 768) return 2;
        return 1;
      }

      function getMaxIndex() {
        const visible = getVisibleCount();
        return Math.max(0, totalItems - visible);
      }

      function renderDots() {
        if (!dotsContainer) return;
        dotsContainer.innerHTML = '';
        const maxIdx = getMaxIndex();

        for (let i = 0; i <= maxIdx; i++) {
          const dot = document.createElement('button');
          dot.setAttribute('aria-label', `Trang ${i + 1}`);
          dot.className = `h-2 rounded-full transition-all duration-300 cursor-pointer ${
            i === currentIndex ? 'w-6 bg-sky-600' : 'w-2 bg-slate-300 hover:bg-slate-400'
          }`;
          dot.addEventListener('click', () => {
            goToSlide(i);
          });
          dotsContainer.appendChild(dot);
        }
      }

      function updateCarousel() {
        const visible = getVisibleCount();
        const maxIdx = getMaxIndex();

        if (currentIndex > maxIdx) {
          currentIndex = maxIdx;
        }
        if (currentIndex < 0) {
          currentIndex = 0;
        }

        const translatePercent = currentIndex * (100 / visible);
        track.style.transform = `translateX(-${translatePercent}%)`;

        renderDots();
      }

      function goToSlide(index) {
        const maxIdx = getMaxIndex();
        if (index > maxIdx) {
          currentIndex = 0;
        } else if (index < 0) {
          currentIndex = maxIdx;
        } else {
          currentIndex = index;
        }
        updateCarousel();
        resetAutoplay();
      }

      function nextSlide() {
        const maxIdx = getMaxIndex();
        if (currentIndex >= maxIdx) {
          currentIndex = 0;
        } else {
          currentIndex++;
        }
        updateCarousel();
      }

      function prevSlide() {
        const maxIdx = getMaxIndex();
        if (currentIndex <= 0) {
          currentIndex = maxIdx;
        } else {
          currentIndex--;
        }
        updateCarousel();
      }

      function startAutoplay() {
        stopAutoplay();
        progressElapsed = 0;
        if (progressBar) progressBar.style.width = '0%';

        progressTimer = setInterval(() => {
          progressElapsed += PROGRESS_INTERVAL;
          const percentage = Math.min(100, (progressElapsed / AUTOPLAY_DELAY) * 100);
          if (progressBar) progressBar.style.width = `${percentage}%`;

          if (progressElapsed >= AUTOPLAY_DELAY) {
            nextSlide();
            progressElapsed = 0;
            if (progressBar) progressBar.style.width = '0%';
          }
        }, PROGRESS_INTERVAL);
      }

      function stopAutoplay() {
        if (progressTimer) {
          clearInterval(progressTimer);
          progressTimer = null;
        }
      }

      function resetAutoplay() {
        startAutoplay();
      }

      if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); resetAutoplay(); });
      if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); resetAutoplay(); });
      if (prevSideBtn) prevSideBtn.addEventListener('click', () => { prevSlide(); resetAutoplay(); });
      if (nextSideBtn) nextSideBtn.addEventListener('click', () => { nextSlide(); resetAutoplay(); });

      if (carouselContainer) {
        carouselContainer.addEventListener('mouseenter', stopAutoplay);
        carouselContainer.addEventListener('mouseleave', startAutoplay);
      }

      window.addEventListener('resize', () => {
        updateCarousel();
      });

      // Touch / Swipe support for mobile
      let touchStartX = 0;
      let touchEndX = 0;

      track.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        stopAutoplay();
      }, { passive: true });

      track.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) {
            nextSlide();
          } else {
            prevSlide();
          }
        }
        startAutoplay();
      }, { passive: true });

      // Initialize
      updateCarousel();
      startAutoplay();
      if (window.lucide) {
        window.lucide.createIcons();
      }
    });
  </script>

  <!-- Why Choose TrustStay Section -->
  <section class="max-w-screen-2xl mx-auto px-4 md:px-8 py-16 my-8 text-left">
    <div class="bg-white p-8 md:p-14 rounded-3xl border border-slate-200 relative overflow-hidden shadow-xl">
      <!-- Glow ambient lights -->
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-sky-200/40 blur-[120px] rounded-full pointer-events-none"></div>
      <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-blue-200/40 blur-[120px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 space-y-10">
        
        <!-- Header -->
        <div class="max-w-3xl space-y-3">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-50 border border-sky-200 text-sky-700 text-xs font-black uppercase tracking-widest">
            <i data-lucide="sparkles" class="w-4 h-4"></i>
            <span>Ưu Điểm Vượt Trội</span>
          </div>
          <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">
            Tại Sao Nên Chọn <span class="hero-gradient-text">TrustStay</span>?
          </h2>
          <p class="text-sm md:text-base text-slate-600 leading-relaxed max-w-2xl font-normal">
            Chúng tôi mang đến giải pháp kết nối tìm kiếm phòng trọ an toàn, minh bạch và tối ưu nhất dành cho sinh viên cũng như người đi làm tại TP.HCM.
          </p>
        </div>

        <!-- 4 Grid Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Card 1 -->
          <div class="group p-6 rounded-3xl bg-slate-50 border border-slate-200 hover:border-sky-300 hover:bg-white transition-all duration-300 hover:-translate-y-1.5 shadow-sm hover:shadow-md flex flex-col justify-between space-y-4 relative overflow-hidden">
            <div class="space-y-4">
              <div class="w-14 h-14 rounded-2xl bg-sky-100 border border-sky-300 flex items-center justify-center text-sky-600 group-hover:scale-110 group-hover:bg-sky-600 group-hover:text-white transition-all shadow-sm">
                <i data-lucide="shield-check" class="w-7 h-7"></i>
              </div>
              <h4 class="font-black text-slate-900 text-lg">Xác Thực 100%</h4>
              <p class="text-xs md:text-sm text-slate-600 leading-relaxed font-normal">Hình ảnh phòng thực tế, diện tích chính xác và giá thuê minh bạch không khai khống.</p>
            </div>
            <div class="pt-2 border-t border-slate-200 flex items-center justify-between">
              <span class="text-[11px] font-mono font-bold text-sky-600">01 / MINH BẠCH</span>
              <i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>
            </div>
          </div>

          <!-- Card 2 -->
