                </div>
            </div>

            <!-- Right Arrow Button -->
            <button onclick="next3D()"
                class="absolute right-0 md:right-4 z-30 w-12 h-12 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-white flex items-center justify-center hover:scale-110 active:scale-95 transition-all cursor-pointer shadow-lg backdrop-blur-md">
                <i data-lucide="chevron-right" class="w-6 h-6"></i>
            </button>
        </div>

        <!-- Pagination indicators -->
