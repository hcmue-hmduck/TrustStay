<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title || 'TrustStay - Tìm & Cho Thuê Phòng Trọ Uy Tín' %>
  </title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
    rel="stylesheet">

  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            'brand-dark': '#020e1f',
            'brand-text': '#f3f4f6',
            'brand-accent': '#a4e6ff',
            'brand-primary': '#00d2ff',
            'brand-muted': '#9ca3af',
            'brand-secondary': '#10b981',
          },
          animation: {
            'spin-slow': 'spin 12s linear infinite',
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Custom Glassmorphism & Dropdown styles -->
  <style>
    .glass-panel {
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .glass-dropdown {
      background: rgba(10, 25, 47, 0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(164, 230, 255, 0.2);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 20px rgba(164, 230, 255, 0.1);
    }

    .hero-gradient-text {
      background: linear-gradient(135deg, #fff 30%, #a4e6ff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  </style>
</head>

<body class="relative min-h-screen bg-[#020e1f] text-brand-text overflow-x-hidden font-sans">

  <!-- Top Banner Navigation Bar -->
  <header class="sticky top-0 z-50 bg-[#020e1f]/85 backdrop-blur-md border-b border-white/10 transition-all duration-300">
    <nav class="flex justify-between items-center w-full px-4 md:px-8 py-4 max-w-screen-2xl mx-auto" id="main-nav">
      
      <!-- Brand Logo -->
      <a href="/" class="text-2xl font-black text-brand-accent tracking-tighter cursor-pointer flex items-center gap-2 hover:scale-105 transition-transform">
        <div class="w-9 h-9 rounded-xl bg-brand-accent/15 border border-brand-accent/40 flex items-center justify-center text-brand-accent shadow-[0_0_15px_rgba(164,230,255,0.2)]">
          <i data-lucide="home" class="w-5 h-5"></i>
        </div>
        <span>Trust<span class="text-white">Stay</span></span>
      </a>

      <!-- Center Navigation Actions (Desktop) -->
      <div class="hidden md:flex items-center gap-8 text-xs font-bold uppercase tracking-wider">
        <a href="/"
          class="pb-1 transition-all <%= page === 'home' ? 'text-brand-accent border-b-2 border-brand-accent' : 'text-brand-text/80 hover:text-brand-accent' %>">
          Trang chủ
        </a>
        <a href="/rooms"
          class="pb-1 transition-all <%= page === 'list_rooms' ? 'text-brand-accent border-b-2 border-brand-accent' : 'text-brand-text/80 hover:text-brand-accent' %>">
          Danh sách Phòng trọ
        </a>
        <a href="/blogs" 
          class="pb-1 transition-all <%= page === 'blogs' ? 'text-brand-accent border-b-2 border-brand-accent' : 'text-brand-text/80 hover:text-brand-accent' %>">
          Kinh nghiệm thuê phòng
        </a>
        <a href="/contacts" 
          class="pb-1 transition-all <%= page === 'contacts' ? 'text-brand-accent border-b-2 border-brand-accent' : 'text-brand-text/80 hover:text-brand-accent' %>">
          Liên hệ tư vấn
        </a>
      </div>

      <!-- Right Header Controls -->
      <div class="flex items-center gap-3 relative">

        <!-- Saved Rooms Counter / Favorites -->
        <a href="/rooms" class="p-2.5 rounded-full glass-panel hover:bg-white/10 hover:border-brand-accent/40 transition-all text-brand-text/80 relative cursor-pointer"
          title="Xem phòng trọ">
          <i data-lucide="search" class="w-4 h-4 text-brand-accent"></i>
        </a>

        <!-- Profile Menu Dropdown Container -->
        <div class="relative">
          <button
            class="flex items-center gap-2.5 pl-2 pr-3.5 py-1.5 glass-panel rounded-full hover:bg-white/10 hover:border-brand-accent/40 active:scale-95 transition-all group cursor-pointer"
            id="user-profile-btn">
            <div class="relative">
              <div class="w-7 h-7 rounded-full bg-brand-accent/20 border-2 border-brand-accent flex items-center justify-center text-brand-accent font-black text-xs group-hover:scale-105 transition-transform">
                TS
              </div>
              <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-green-500 rounded-full border border-brand-dark animate-pulse"></span>
            </div>
            <span class="text-xs font-bold text-white hidden sm:inline group-hover:text-brand-accent transition-colors">Tài khoản</span>
            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-brand-muted group-hover:text-brand-accent transition-colors"></i>
          </button>

          <!-- Premium Profile Dropdown Box -->
          <div
            class="absolute right-0 mt-3 w-64 glass-dropdown rounded-2xl p-4 z-50 text-left hidden transition-all duration-200"
            id="bookings-dropdown">

            <!-- User Info Header -->
            <div class="flex items-center gap-3 pb-3 mb-3 border-b border-white/10">
              <div class="w-10 h-10 rounded-full bg-brand-accent/20 border-2 border-brand-accent flex items-center justify-center text-brand-accent font-black text-sm shrink-0">
                TS
              </div>
              <div class="overflow-hidden">
                <h4 class="font-extrabold text-white text-xs truncate">Tài Khoản Khách Hàng</h4>
                <p class="text-[10px] text-brand-muted truncate opacity-80">khachhang@truststay.vn</p>
              </div>
            </div>

            <!-- Dropdown Options List -->
            <div class="space-y-1 text-xs">
              <a href="/rooms"
                class="flex items-center gap-2.5 px-3 py-2 text-white/90 hover:text-brand-accent hover:bg-white/10 rounded-xl transition-all font-medium">
                <i data-lucide="search" class="w-4 h-4 text-brand-accent"></i>
                <span>Tìm kiếm phòng trọ</span>
              </a>

              <a href="/blogs"
                class="flex items-center gap-2.5 px-3 py-2 text-white/90 hover:text-brand-accent hover:bg-white/10 rounded-xl transition-all font-medium">
                <i data-lucide="book-open" class="w-4 h-4 text-brand-accent"></i>
                <span>Kinh nghiệm & Review</span>
              </a>

              <a href="/contacts"
                class="flex items-center gap-2.5 px-3 py-2 text-white/90 hover:text-brand-accent hover:bg-white/10 rounded-xl transition-all font-medium">
                <i data-lucide="phone-call" class="w-4 h-4 text-brand-accent"></i>
                <span>Liên hệ hỗ trợ xem phòng</span>
              </a>

              <div class="pt-2 border-t border-white/10 mt-2">
                <a href="/admin/dashboard"
                  class="flex items-center gap-2.5 px-3 py-2.5 text-brand-accent hover:bg-brand-accent/15 rounded-xl transition-all font-bold">
                  <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                  <span>Trang quản trị (Admin)</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" class="md:hidden p-2.5 rounded-full glass-panel text-white hover:text-brand-accent">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>

      </div>
    </nav>

    <!-- Mobile Drawer Navigation -->
    <div id="mobile-menu-drawer" class="hidden md:hidden bg-[#020e1f]/95 border-b border-white/10 px-6 py-4 space-y-3 text-xs font-bold uppercase tracking-wider text-left">
      <a href="/" class="block py-2 <%= page === 'home' ? 'text-brand-accent font-black' : 'text-white/80' %>">Trang chủ</a>
      <a href="/rooms" class="block py-2 <%= page === 'list_rooms' ? 'text-brand-accent font-black' : 'text-white/80' %>">Danh sách Phòng trọ</a>
      <a href="/blogs" class="block py-2 <%= page === 'blogs' ? 'text-brand-accent font-black' : 'text-white/80' %>">Kinh nghiệm thuê phòng</a>
      <a href="/contacts" class="block py-2 <%= page === 'contacts' ? 'text-brand-accent font-black' : 'text-white/80' %>">Liên hệ tư vấn</a>
    </div>
  </header>

  <!-- Main Content Body -->
  <main class="min-h-[calc(100vh-80px)]">
    <%- body %>
  </main>

  <!-- Footer Section -->
  <footer class="bg-[#020e1f] text-brand-muted text-xs py-12 border-t border-white/10" id="feedback-footer">
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8 grid grid-cols-1 md:grid-cols-4 gap-10 text-left">
      
      <!-- Brand & Description -->
      <div class="space-y-4">
        <div class="text-xl font-black text-brand-accent flex items-center gap-2 leading-tight">
          <div class="w-7 h-7 rounded-lg bg-brand-accent/20 border border-brand-accent/40 flex items-center justify-center text-brand-accent">
            <i data-lucide="home" class="w-4 h-4"></i>
          </div>
          <span>TrustStay</span>
        </div>
        <p class="text-[11px] leading-relaxed opacity-80">
          TrustStay - Nền tảng Tìm & Cho Thuê Phòng Trọ Uy Tín. Kết nối trực tiếp giữa người thuê và chủ trọ chất lượng cao tại TP.HCM, Hà Nội & các khu vực lân cận.
        </p>
        <div class="pt-1 text-xs text-brand-accent font-bold">
          Hotline xem phòng 24/7: <span class="text-white">0909 123 456</span>
        </div>
      </div>

      <!-- Quick Navigation Links -->
      <div class="space-y-3">
        <h4 class="font-bold text-white text-xs uppercase tracking-wider">Khám Phá TrustStay</h4>
        <ul class="space-y-2 text-[11px]">
          <li><a href="/" class="hover:text-brand-accent transition-colors">Trang chủ</a></li>
          <li><a href="/rooms" class="hover:text-brand-accent transition-colors">Danh sách phòng trọ</a></li>
          <li><a href="/blogs" class="hover:text-brand-accent transition-colors">Kinh nghiệm & Review thuê trọ</a></li>
          <li><a href="/contacts" class="hover:text-brand-accent transition-colors">Liên hệ tư vấn xem phòng</a></li>
        </ul>
      </div>

      <!-- Popular Areas -->
      <div class="space-y-3">
        <h4 class="font-bold text-white text-xs uppercase tracking-wider">Khu Vực Hot</h4>
        <ul class="space-y-2 text-[11px]">
          <li><a href="/rooms?ma_dia_diem=Q7" class="hover:text-brand-accent transition-colors">Phòng trọ Quận 7 - TP.HCM</a></li>
          <li><a href="/rooms?ma_dia_diem=BK" class="hover:text-brand-accent transition-colors">Phòng trọ Bách Khoa - Hà Nội</a></li>
          <li><a href="/rooms?ma_dia_diem=TD" class="hover:text-brand-accent transition-colors">Trọ sinh viên Làng Đại Học</a></li>
          <li><a href="/rooms?ma_dia_diem=Q10" class="hover:text-brand-accent transition-colors">Căn hộ Studio Quận 10</a></li>
        </ul>
      </div>

      <!-- Newsletter Signups -->
      <div class="space-y-3">
        <h4 class="font-bold text-white text-xs uppercase tracking-wider">Đăng Ký Nhận Tin Phòng Mới</h4>
        <p class="text-[11px] leading-relaxed">Nhập email để nhận ngay thông báo phòng trọ mới đăng giá tốt hàng tuần.</p>

        <div class="flex gap-2">
          <input type="email" placeholder="Nhập địa chỉ email..."
            class="flex-1 bg-white/5 border border-white/10 rounded-xl px-3 py-2.5 text-xs text-white placeholder:text-brand-muted/40 focus:outline-none focus:border-brand-accent"
            id="newsletter-email-input" />
          <button onclick="alert('Đăng ký nhận thông báo phòng trọ thành công!')"
            class="px-4 py-2.5 bg-brand-accent text-brand-dark rounded-xl font-bold hover:bg-brand-primary whitespace-nowrap cursor-pointer text-xs">
            Đăng ký
          </button>
        </div>

        <p class="text-[10px] text-brand-muted opacity-70">Cam kết bảo mật 100%, không gửi spam.</p>
      </div>

    </div>

    <!-- Copyright Bar -->
    <div class="max-w-screen-2xl mx-auto px-4 md:px-8 mt-10 pt-6 border-t border-white/5 flex flex-col md:flex-row justify-between items-center text-[10px] text-brand-muted/70 gap-4 text-left">
      <p>© 2026 TrustStay. Tất cả các quyền được bảo lưu. Nền tảng cho thuê phòng trọ uy tín hàng đầu.</p>
      <div class="flex items-center gap-6">
        <a href="/contacts" class="hover:text-white transition-colors">Quy định xem phòng</a>
        <a href="/contacts" class="hover:text-white transition-colors">Bảo mật thông tin</a>
        <a href="/contacts" class="hover:text-white transition-colors">Hotline hỗ trợ 24/7</a>
      </div>
    </div>
  </footer>

  <!-- Dropdowns & Icon Initialization Script -->
  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    const profileBtn = document.getElementById('user-profile-btn');
    const bookingsDropdown = document.getElementById('bookings-dropdown');

    if (profileBtn && bookingsDropdown) {
      profileBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        bookingsDropdown.classList.toggle('hidden');
      });
    }

    document.addEventListener('click', () => {
      if (bookingsDropdown) bookingsDropdown.classList.add('hidden');
    });

    if (bookingsDropdown) {
      bookingsDropdown.addEventListener('click', (e) => e.stopPropagation());
    }

    // Mobile Menu Drawer Toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileDrawer = document.getElementById('mobile-menu-drawer');
    if (mobileBtn && mobileDrawer) {
      mobileBtn.addEventListener('click', () => {
        mobileDrawer.classList.toggle('hidden');
      });
    }
  </script>
</body>

</html>