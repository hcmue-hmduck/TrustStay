<!-- Category Manager Modal Overlay -->
<div id="category-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-md hidden transition-all duration-300">
    <div
        class="glass-panel max-w-[95%] md:max-w-7xl w-full mx-4 rounded-3xl border border-white/80 overflow-hidden shadow-2xl flex flex-col md:flex-row h-[90vh] md:h-[720px]">

        <!-- Left Column: Add/Edit Category Form -->
        <div
            class="w-full md:w-[360px] p-6 bg-slate-50 border-r border-slate-200 flex flex-col justify-between shrink-0 text-left">
            <div class="min-h-0 flex flex-col">
                <div class="flex items-center justify-between pb-4 border-b border-slate-200 shrink-0">
                    <h3 id="category-form-title" class="text-sm font-black text-slate-900 uppercase tracking-wider">
                        Quản lý Danh Mục
                    </h3>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="resetCategoryForm()"
                            class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-sky-50 border border-sky-200 hover:bg-sky-100 rounded-xl text-[10px] font-bold text-sky-700 transition-all cursor-pointer"
                            title="Tạo mới danh mục">
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                            <span>Tạo mới</span>
                        </button>
                        <button type="button" onclick="closeCategoryModal()"
                            class="md:hidden p-1.5 hover:bg-slate-200 rounded-xl text-slate-400 hover:text-slate-900 transition-colors cursor-pointer">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <form id="category-form" class="space-y-4 mt-4 overflow-y-auto pr-1 flex-1">
                    <input type="hidden" name="ma_danh_muc" id="cat-form-ma-danh-muc" />

                    <!-- Name -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-700 uppercase">Tên Danh Mục <span
                                class="text-red-500">*</span></label>
                        <input type="text" name="ten_danh_muc" id="cat-form-ten" required
                            placeholder="Ví dụ: Du Lịch Nghỉ Dưỡng"
                            class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-sky-500 transition-all font-semibold" />
                    </div>

                    <!-- Description -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-700 uppercase">Mô Tả Danh Mục</label>
                        <textarea name="mo_ta" id="cat-form-mo-ta" rows="3" placeholder="Mô tả ngắn về loại hình..."
                            class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-sky-500 transition-all font-semibold resize-none"></textarea>
                    </div>

                    <!-- Image File Upload -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-700 uppercase">Hình Đại Diện</label>
                        <input type="hidden" name="hinh_anh" id="cat-form-hinh-anh" />
                        <div class="flex items-center gap-2">
                            <input type="file" id="cat-image-upload-input" accept="image/*" class="hidden" />
                            <button type="button" onclick="document.getElementById('cat-image-upload-input').click()"
                                class="px-4 py-2 bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 rounded-xl text-xs font-extrabold transition-all flex items-center gap-2 cursor-pointer">
                                <i data-lucide="upload-cloud" class="w-4 h-4"></i>
                                <span>Tải Ảnh</span>
                            </button>
                            <span id="cat-upload-file-name"
                                class="text-xs text-slate-500 font-semibold truncate max-w-[150px]">
                                Chưa chọn file
                            </span>
                        </div>
                    </div>

                    <!-- Image Preview Area -->
                    <div class="space-y-1">
                        <div
                            class="w-full h-36 rounded-xl border border-slate-200 bg-white overflow-hidden flex items-center justify-center relative">
                            <img id="cat-image-preview"
                                src="https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80"
                                alt="Category Preview" class="w-full h-full object-cover" />
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-700 uppercase">Trạng Thái Hoạt Động</label>
                        <select name="trang_thai" id="cat-form-trang-thai"
                            class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-sky-500 transition-all font-semibold">
                            <option value="active">Hoạt Động</option>
                            <option value="inactive">Tạm Khóa</option>
                        </select>
                    </div>
                </form>
            </div>

            <!-- Buttons -->
            <div class="pt-4 border-t border-slate-200 flex shrink-0">
                <button type="button" onclick="submitCategoryForm()"
                    class="w-full py-2.5 btn-primary-gradient rounded-xl text-sm font-black text-white transition-all shadow-md shadow-sky-500/20 cursor-pointer hover:scale-[1.02] active:scale-95">
                    Lưu Lại
                </button>
            </div>
        </div>

        <!-- Right Column: List of Categories Table -->
        <div class="flex-1 p-6 flex flex-col min-h-0 bg-white text-left">
            <!-- Header -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 shrink-0">
                <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2 uppercase tracking-wider">
                    <i data-lucide="folder-open" class="w-4 h-4 text-sky-600"></i>
                    Bảng Thông Tin Danh Mục
                </h3>
                <button type="button" onclick="closeCategoryModal()"
                    class="hidden md:flex p-1.5 hover:bg-slate-100 rounded-xl text-slate-400 hover:text-slate-900 transition-colors cursor-pointer">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <!-- Table Wrapper -->
            <div class="flex-1 overflow-auto rounded-xl border border-slate-200 bg-white mt-4">
                <table class="w-full text-left text-sm text-slate-700">
                    <thead>
                        <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 font-bold sticky top-0 z-10">
                            <th class="py-3.5 px-4 w-16 text-center text-sm">Hình</th>
                            <th class="py-3.5 px-4 w-44 text-sm">Tên Danh Mục</th>
                            <th class="py-3.5 px-4 w-32 text-center text-sm">Trạng Thái</th>
                            <th class="py-3.5 px-4 text-sm">Mô Tả</th>
                            <th class="py-3.5 px-4 w-28 text-right text-sm">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="category-table-body" class="divide-y divide-slate-100">
                        <tr>
                            <td colspan="5" class="text-center text-sm text-slate-500 py-12 font-semibold animate-pulse">
                                Đang tải danh sách danh mục...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
    // Global State Variable for Categories
    let categories = [];
    let isInitialFetched = false;

    // Helper to generate innerHTML for a category row
    const getCategoryRowHtml = (cat) => {
        const statusText = cat.trang_thai === 'inactive' ? 'Tạm Khóa' : 'Hoạt Động';
        const statusClass = cat.trang_thai === 'inactive'
            ? 'bg-red-50 text-red-700 border-red-200'
            : 'bg-emerald-50 text-emerald-700 border-emerald-200';

        return `
            <td class="hidden">
                ${cat.ma_danh_muc}
            </td>
            <td class="py-3 px-4 text-center">
                ${cat.hinh_anh ? `
                    <img src="${cat.hinh_anh}" class="w-10 h-10 rounded-lg object-cover border border-slate-200 mx-auto" />
                ` : `
                    <div class="w-10 h-10 bg-slate-100 rounded-lg flex items-center justify-center mx-auto text-slate-400">
                        <i data-lucide="image" class="w-5 h-5"></i>
                    </div>
                `}
            </td>
            <td class="py-3 px-4 font-bold text-slate-900 align-middle">
                ${cat.ten_danh_muc}
            </td>
            <td class="py-3 px-4 text-center align-middle">
                <span class="inline-flex px-2.5 py-1 rounded text-xs font-bold border ${statusClass}">
                    ${statusText}
                </span>
            </td>
            <td class="py-3 px-4 text-slate-600 align-middle max-w-xs truncate">
                ${cat.mo_ta || '<span class="text-slate-400 font-medium">Không có mô tả</span>'}
            </td>
            <td class="py-3 px-4 text-right align-middle">
                <div class="flex items-center justify-end gap-1.5">
                    <button type="button" 
                        class="edit-cat-btn p-2 hover:bg-sky-50 rounded-lg text-sky-600 transition-all cursor-pointer" 
                        data-ma="${cat.ma_danh_muc}"
                        data-ten="${cat.ten_danh_muc}"
                        data-mota="${cat.mo_ta || ''}"
                        data-hinhanh="${cat.hinh_anh || ''}"
                        data-trangthai="${cat.trang_thai || 'active'}"
                        title="Sửa">
                        <i data-lucide="edit-3" class="w-4 h-4"></i>
                    </button>
                    <button type="button" 
                        class="delete-cat-btn p-2 hover:bg-red-50 rounded-lg text-red-500 transition-all cursor-pointer" 
                        data-ma="${cat.ma_danh_muc}"
                        title="Xóa">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
            </td>
        `;
    };

    // Add category row to global variable and DOM
    const addCategoryRow = (cat) => {
        const tbody = document.getElementById('category-table-body');
        if (!tbody) return;

        // Clear empty state placeholder if it exists
        if (categories.length === 0) {
            tbody.innerHTML = '';
        }

        // Add to array
        categories.push(cat);

        // Append to DOM
        const tr = document.createElement('tr');
        tr.id = `cat-row-${cat.ma_danh_muc}`;
        tr.className = "hover:bg-slate-50 transition-colors text-sm";
        tr.innerHTML = getCategoryRowHtml(cat);
        tbody.appendChild(tr);

        // Update icon library
        if (window.lucide) {
            lucide.createIcons();
        }
    };

    // Update category row in global variable and DOM
    const updateCategoryRow = (cat) => {
        // Update in array
        const idx = categories.findIndex(item => item.ma_danh_muc === cat.ma_danh_muc);
        if (idx !== -1) {
            categories[idx] = cat;
        }

        // Update in DOM
        const tr = document.getElementById(`cat-row-${cat.ma_danh_muc}`);
        if (tr) {
            tr.innerHTML = getCategoryRowHtml(cat);
            if (window.lucide) {
                lucide.createIcons();
            }
        }
    };

    // Remove category row from global variable and DOM
    const removeCategoryRow = (ma_danh_muc) => {
        // Remove from array
        categories = categories.filter(item => item.ma_danh_muc !== ma_danh_muc);

        // Remove from DOM
        const tr = document.getElementById(`cat-row-${ma_danh_muc}`);
        if (tr) {
            tr.remove();
        }

        // If no categories left, render placeholder
        const tbody = document.getElementById('category-table-body');
        if (tbody && categories.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center text-sm text-slate-500 py-12 font-semibold">
                        Chưa có danh mục nào.
                    </td>
                </tr>
            `;
        }
    };

    // Render the entire category table dynamically
    const renderCategoryTable = () => {
        const tbody = document.getElementById('category-table-body');
        if (!tbody) return;

        if (categories && categories.length > 0) {
            tbody.innerHTML = categories.map(cat => `
                <tr id="cat-row-${cat.ma_danh_muc}" class="hover:bg-slate-50 transition-colors text-sm">
                    ${getCategoryRowHtml(cat)}
                </tr>
            `).join('');
            if (window.lucide) {
                lucide.createIcons();
            }
        } else {
            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center text-sm text-slate-500 py-12 font-semibold">
                        Chưa có danh mục nào.
                    </td>
                </tr>
            `;
        }
    };

    // Initialize categories: fetch once on load or modal open
    const initCategories = async () => {
        if (isInitialFetched) return;

        try {
            const res = await fetch('/api/category');
            const result = await res.json();
            if (result.success && result.data) {
                categories = result.data;
                isInitialFetched = true;
                renderCategoryTable();
            }
        } catch (err) {
            console.error("Lỗi khi fetch danh mục ban đầu:", err);
        }
    };

    // Open Modal
    const openCategoryModal = () => {
        const modal = document.getElementById('category-modal');
        modal.classList.remove('hidden');
        resetCategoryForm();
        initCategories();
    };

    // Close Modal
    const closeCategoryModal = () => {
        const modal = document.getElementById('category-modal');
        modal.classList.add('hidden');
    };

    // Close modal when clicking outside the modal box (backdrop)
    document.getElementById('category-modal').addEventListener('click', (e) => {
        if (e.target.id === 'category-modal') {
            closeCategoryModal();
        }
    });

    // File Upload Handler (Base64 conversion)
    const catFileInput = document.getElementById('cat-image-upload-input');
    const catFileNameSpan = document.getElementById('cat-upload-file-name');
    const catImgPreview = document.getElementById('cat-image-preview');
    const catHiddenHinhAnh = document.getElementById('cat-form-hinh-anh');

    if (catFileInput && catImgPreview) {
        catFileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                if (catFileNameSpan) catFileNameSpan.innerText = file.name;

                const reader = new FileReader();
                reader.onload = (event) => {
                    catImgPreview.src = event.target.result;
                    catHiddenHinhAnh.value = event.target.result; // Store base64 in hidden input
                };
                reader.readAsDataURL(file);
            }
        });

        catImgPreview.addEventListener('error', () => {
            catImgPreview.src = 'https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80';
        });
    }

    // Populate data for editing
    const editCategory = (id, name, desc, img, status) => {
        document.getElementById('cat-form-ma-danh-muc').value = id || '';
        document.getElementById('cat-form-ten').value = name || '';
        document.getElementById('cat-form-mo-ta').value = desc || '';
        document.getElementById('cat-form-hinh-anh').value = img || '';
        document.getElementById('cat-form-trang-thai').value = status || 'active';

        if (img) {
            catImgPreview.src = img;
            catFileNameSpan.innerText = 'Đã chọn ảnh đại diện';
        } else {
            catImgPreview.src = 'https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80';
            catFileNameSpan.innerText = 'Chưa chọn file';
        }

        document.getElementById('category-form-title').innerText = 'Quản lý Danh Mục';
    };

    // Reset Form to Create mode
    const resetCategoryForm = () => {
        document.getElementById('category-form').reset();
        document.getElementById('cat-form-ma-danh-muc').value = '';
        document.getElementById('cat-form-hinh-anh').value = '';
        catImgPreview.src = 'https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80';
        catFileNameSpan.innerText = 'Chưa chọn file';

        document.getElementById('category-form-title').innerText = 'Quản lý Danh Mục';
    };

    // Submit form (Create / Update)
    const submitCategoryForm = async () => {
        const ma_danh_muc = document.getElementById('cat-form-ma-danh-muc').value;
        const ten_danh_muc = document.getElementById('cat-form-ten').value.trim();

        if (!ten_danh_muc) {
            alert("Vui lòng nhập tên danh mục!");
            return;
        }

        const data = {
            ten_danh_muc,
            hinh_anh: document.getElementById('cat-form-hinh-anh').value.trim(),
            mo_ta: document.getElementById('cat-form-mo-ta').value.trim(),
            trang_thai: document.getElementById('cat-form-trang-thai').value
        };

        const url = ma_danh_muc ? `/api/category/${ma_danh_muc}` : '/api/category';
        const method = ma_danh_muc ? 'PUT' : 'POST';

        try {
            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();

            if (result.success && result.data) {
                showAdminToast(ma_danh_muc ? "Cập nhật danh mục thành công!" : "Tạo danh mục mới thành công!");
                resetCategoryForm();
                if (ma_danh_muc) {
                    updateCategoryRow(result.data);
                } else {
                    addCategoryRow(result.data);
                }
            } else {
                alert("Lỗi: " + result.message);
            }
        } catch (err) {
            console.error(err);
            alert("Không thể lưu danh mục do lỗi kết nối.");
        }
    };

    // Delete Category (Soft Delete)
    const deleteCategory = async (ma_danh_muc) => {
        if (!confirm("Bạn có chắc chắn muốn xóa danh mục này không?")) return;

        try {
            const res = await fetch(`/api/category/${ma_danh_muc}`, {
                method: 'DELETE'
            });
            const result = await res.json();

            if (result.success) {
                showAdminToast("Đã xóa danh mục thành công!");
                removeCategoryRow(ma_danh_muc);
            } else {
                alert("Lỗi: " + result.message);
            }
        } catch (err) {
            console.error(err);
            alert("Không thể xóa danh mục do lỗi kết nối.");
        }
    };

    // Event delegation for category table body
    const categoryTableBody = document.getElementById('category-table-body');
    if (categoryTableBody) {
        categoryTableBody.addEventListener('click', (e) => {
            const editBtn = e.target.closest('.edit-cat-btn');
            if (editBtn) {
                const id = editBtn.getAttribute('data-ma');
                const name = editBtn.getAttribute('data-ten');
                const desc = editBtn.getAttribute('data-mota');
                const img = editBtn.getAttribute('data-hinhanh');
                const status = editBtn.getAttribute('data-trangthai');
                editCategory(id, name, desc, img, status);
                return;
            }

            const deleteBtn = e.target.closest('.delete-cat-btn');
            if (deleteBtn) {
                const id = deleteBtn.getAttribute('data-ma');
                deleteCategory(id);
                return;
            }
        });
    }
</script>