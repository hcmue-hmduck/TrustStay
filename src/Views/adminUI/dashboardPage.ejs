<div class="space-y-8 text-left">
  
  <!-- Page Title & Quick Actions -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-4 border-b border-slate-200">
    <div>
      <h1 class="text-2xl font-mono font-black text-slate-900 uppercase tracking-tight flex items-center gap-2">
        <i data-lucide="layout-dashboard" class="w-6 h-6 text-sky-600"></i>
        <span>Bảng Điều Khiển Quản Trị TrustStay</span>
      </h1>
      <p class="text-xs text-slate-500 mt-1">Tổng quan hoạt động hệ thống, phòng trọ, lượt hẹn xem và bài viết kinh nghiệm</p>
    </div>

    <a href="/admin/rooms/create" class="px-5 py-2.5 btn-primary-gradient text-white font-extrabold text-xs rounded-xl transition-all shadow-md shadow-sky-500/20 flex items-center gap-2 cursor-pointer hover:scale-105 active:scale-95">
      <i data-lucide="plus-circle" class="w-4 h-4"></i>
      <span>Thêm Phòng Trọ Mới</span>
    </a>
  </div>

  <!-- Top Stat Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-5">
    
    <!-- Total Rooms -->
    <a href="/admin/rooms" class="glass-card p-5 rounded-3xl border border-slate-200/80 shadow-md space-y-2 hover:border-sky-300 hover:-translate-y-1 transition-all duration-300 block">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-slate-500 uppercase font-extrabold tracking-wider">Tổng phòng trọ</span>
        <div class="w-8 h-8 rounded-xl bg-sky-50 border border-sky-200 flex items-center justify-center text-sky-600 shadow-sm">
          <i data-lucide="home" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-mono font-black text-slate-900"><%= data ? data.length : 0 %></p>
      <p class="text-[10px] text-emerald-600 font-bold flex items-center gap-1">
        <i data-lucide="trending-up" class="w-3 h-3"></i>
        <span>Đang cho thuê</span>
      </p>
    </a>

    <!-- Viewing Requests -->
    <a href="/admin/requests" class="glass-card p-5 rounded-3xl border border-slate-200/80 shadow-md space-y-2 hover:border-sky-300 hover:-translate-y-1 transition-all duration-300 block">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-slate-500 uppercase font-extrabold tracking-wider">Yêu cầu hẹn xem</span>
        <div class="w-8 h-8 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600 shadow-sm">
          <i data-lucide="calendar" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-mono font-black text-slate-900"><%= requests ? requests.length : 0 %></p>
      <p class="text-[10px] text-slate-500">Khách hẹn xem phòng</p>
    </a>

    <!-- Categories -->
    <a href="/admin/categories" class="glass-card p-5 rounded-3xl border border-slate-200/80 shadow-md space-y-2 hover:border-sky-300 hover:-translate-y-1 transition-all duration-300 block">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-slate-500 uppercase font-extrabold tracking-wider">Danh mục phòng</span>
        <div class="w-8 h-8 rounded-xl bg-purple-50 border border-purple-200 flex items-center justify-center text-purple-600 shadow-sm">
          <i data-lucide="layers" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-mono font-black text-slate-900"><%= categories ? categories.length : 0 %></p>
      <p class="text-[10px] text-purple-600 font-bold">Phân loại phòng trọ</p>
    </a>

    <!-- Locations -->
    <a href="/admin/locations" class="glass-card p-5 rounded-3xl border border-slate-200/80 shadow-md space-y-2 hover:border-sky-300 hover:-translate-y-1 transition-all duration-300 block">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-slate-500 uppercase font-extrabold tracking-wider">Khu vực địa điểm</span>
        <div class="w-8 h-8 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-600 shadow-sm">
          <i data-lucide="map-pin" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-mono font-black text-slate-900"><%= locations ? locations.length : 0 %></p>
      <p class="text-[10px] text-blue-600 font-bold">Quận huyện cho thuê</p>
    </a>

    <!-- Blog Experience Posts -->
    <a href="/admin/blogs" class="glass-card p-5 rounded-3xl border border-slate-200/80 shadow-md space-y-2 hover:border-sky-300 hover:-translate-y-1 transition-all duration-300 block">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-slate-500 uppercase font-extrabold tracking-wider">Bài viết kinh nghiệm</span>
        <div class="w-8 h-8 rounded-xl bg-cyan-50 border border-cyan-200 flex items-center justify-center text-cyan-600 shadow-sm">
          <i data-lucide="book-open" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-2xl font-mono font-black text-slate-900"><%= blogs ? blogs.length : 0 %></p>
      <p class="text-[10px] text-cyan-600 font-bold">Góc người thuê chia sẻ</p>
    </a>

    <!-- System Status -->
    <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Trạng thái</span>
        <div class="w-8 h-8 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
        </div>
      </div>
      <p class="text-lg font-mono font-black text-emerald-600">ONLINE</p>
      <p class="text-[10px] text-slate-500">TrustStay v1.0 Ready</p>
    </div>

  </div>

  <!-- Recent Rooms Table -->
  <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-md p-6 space-y-4">
    <div class="flex justify-between items-center pb-4 border-b border-slate-100">
      <h3 class="font-mono text-base font-bold text-slate-900 uppercase tracking-tight flex items-center gap-2">
        <i data-lucide="list" class="w-4 h-4 text-sky-600"></i>
        <span>Danh Sách Tin Đăng Phòng Trọ Mới Nhất</span>
      </h3>
      <a href="/admin/rooms" class="text-xs text-sky-600 hover:underline font-bold flex items-center gap-1">
        <span>Quản lý tất cả phòng</span>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-700">
        <thead class="bg-slate-50 text-slate-500 uppercase text-[10px] tracking-wider font-mono border-b border-slate-200">
          <tr>
            <th class="p-3">Hình ảnh</th>
            <th class="p-3">Tên phòng trọ</th>
            <th class="p-3">Giá thuê</th>
            <th class="p-3">Diện tích</th>
            <th class="p-3">Trạng thái</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (data && data.length > 0) { %>
            <% data.slice(0, 5).forEach(room => { %>
              <tr class="hover:bg-slate-50/80">
                <td class="p-3">
                  <img src="<%= room.hinh_anh_dai_dien %>" alt="<%= room.ten_phong %>" class="w-12 h-9 rounded object-cover border border-slate-200" />
                </td>
                <td class="p-3 font-bold text-slate-900 max-w-xs truncate"><%= room.ten_phong %></td>
                <td class="p-3 font-black text-sky-600"><%= room.gia_thue ? room.gia_thue.toLocaleString('vi-VN') : 0 %> đ</td>
                <td class="p-3 font-mono text-slate-700"><%= room.dien_tich %> m²</td>
                <td class="p-3">
                  <span class="px-2.5 py-0.5 bg-emerald-50 text-emerald-700 rounded-full text-[10px] font-bold border border-emerald-200">Hoạt động</span>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="p-4 text-center text-slate-500">Chưa có phòng trọ nào.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Viewing Requests Section -->
  <div id="requests" class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-md p-6 space-y-4">
    <div class="flex justify-between items-center pb-4 border-b border-slate-100">
      <h3 class="font-mono text-base font-bold text-slate-900 uppercase tracking-tight flex items-center gap-2">
        <i data-lucide="phone-incoming" class="w-4 h-4 text-sky-600"></i>
        <span>Danh Sách Đăng Ký Xem Phòng Mới Nhất</span>
      </h3>
      <a href="/admin/requests" class="text-xs text-sky-600 hover:underline font-bold flex items-center gap-1">
        <span>Xem tất cả yêu cầu</span>
        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-700">
        <thead class="bg-slate-50 text-slate-500 uppercase text-[10px] tracking-wider font-mono border-b border-slate-200">
          <tr>
            <th class="p-3">Mã yêu cầu</th>
            <th class="p-3">Họ tên khách</th>
            <th class="p-3">Số điện thoại</th>
            <th class="p-3">Email</th>
            <th class="p-3">Ghi chú</th>
            <th class="p-3">Trạng thái</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (requests && requests.length > 0) { %>
            <% requests.slice(0, 5).forEach(req => { %>
              <tr class="hover:bg-slate-50/80">
                <td class="p-3 font-mono font-bold text-sky-600"><%= req.ma_yeu_cau %></td>
                <td class="p-3 font-bold text-slate-900"><%= req.ho_ten_khach %></td>
                <td class="p-3 text-sky-600 font-bold"><%= req.so_dien_thoai_khach %></td>
                <td class="p-3 text-slate-500"><%= req.email_khach || '-' %></td>
                <td class="p-3 max-w-xs truncate text-slate-600"><%= req.ghi_chu || '-' %></td>
                <td class="p-3">
                  <% if (req.trang_thai === 'pending') { %>
                    <span class="px-2.5 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 rounded-full text-[10px] font-bold">Chờ liên hệ</span>
                  <% } else { %>
                    <span class="px-2.5 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full text-[10px] font-bold">Đã xác nhận</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="p-4 text-center text-slate-500">Chưa có yêu cầu hẹn xem phòng nào.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

