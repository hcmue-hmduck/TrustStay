<!-- Location Manager Modal Overlay -->
<div id="location-modal"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden transition-all duration-300">
    <div
        class="glass-card max-w-[95%] md:max-w-7xl w-full mx-4 rounded-2xl border border-white/10 overflow-hidden shadow-2xl flex flex-col md:flex-row h-[95vh] md:h-[840px] bg-[#0b1329]">

        <!-- Left Column: Add/Edit Location Form -->
        <div
            class="w-full md:w-[360px] p-6 bg-slate-950/80 border-r border-white/5 flex flex-col justify-between shrink-0">
            <div class="min-h-0 flex flex-col">
                <div class="flex items-center justify-between pb-4 border-b border-white/5 shrink-0">
                    <h3 id="location-form-title" class="text-sm font-black text-white uppercase tracking-wider">
                        Quản lý Địa Điểm
                    </h3>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="resetLocationForm()"
                            class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-brand-primary/20 border border-brand-accent/30 hover:bg-brand-primary/45 rounded-xl text-[10px] font-bold text-brand-accent transition-all cursor-pointer"
                            title="Tạo mới địa điểm">
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                            <span>Tạo mới</span>
                        </button>
                        <button type="button" onclick="closeLocationModal()"
                            class="md:hidden p-1.5 hover:bg-white/5 rounded-xl text-slate-400 hover:text-white transition-colors cursor-pointer">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

                <form id="location-form" class="space-y-4 mt-4 overflow-y-auto pr-1 flex-1">
                    <input type="hidden" name="ma_dia_diem" id="loc-form-ma-dia-diem" />

                    <!-- Name -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-300 uppercase">Tên Địa Điểm <span
                                class="text-red-500">*</span></label>
                        <input type="text" name="ten_dia_diem" id="loc-form-ten" required
                            placeholder="Ví dụ: Vịnh Hạ Long"
                            class="w-full px-4 py-2.5 bg-slate-900 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                    </div>

                    <!-- Category selection -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-300 uppercase">Thuộc Danh Mục <span
                                class="text-red-500">*</span></label>
                        <select name="ma_danh_muc" id="loc-form-ma-danh-muc" required
                            class="w-full px-4 py-2.5 bg-slate-900 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-brand-accent transition-all font-semibold">
                            <option value="">-- Đang tải danh mục --</option>
                        </select>
                    </div>

                    <!-- City & Country -->
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300 uppercase">Tỉnh Thành</label>
                            <input type="text" name="tinh_thanh" id="loc-form-tinh-thanh"
                                placeholder="Quảng Ninh"
                                class="w-full px-4 py-2.5 bg-slate-900 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                        </div>
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300 uppercase">Quốc Gia</label>
                            <input type="text" name="quoc_gia" id="loc-form-quoc-gia"
                                placeholder="Việt Nam"
                                class="w-full px-4 py-2.5 bg-slate-900 border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-brand-accent transition-all font-semibold" />
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-300 uppercase">Mô Tả</label>
                        <textarea name="mo_ta" id="loc-form-mo-ta" rows="3" placeholder="Mô tả sơ lược về địa danh..."
                            class="w-full px-4 py-2.5 bg-slate-900 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-brand-accent transition-all font-semibold resize-none"></textarea>
                    </div>

                    <!-- Image File Upload -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-300 uppercase">Hình Ảnh Địa Điểm</label>
                        <input type="hidden" name="hinh_anh" id="loc-form-hinh-anh" />
                        <div class="flex items-center gap-2">
                            <input type="file" id="loc-image-upload-input" accept="image/*" class="hidden" />
                            <button type="button" onclick="document.getElementById('loc-image-upload-input').click()"
                                class="px-4 py-2 bg-slate-900 border border-white/10 text-slate-300 hover:text-white hover:bg-white/5 rounded-xl text-xs font-extrabold transition-all flex items-center gap-2 cursor-pointer">
                                <i data-lucide="upload-cloud" class="w-4 h-4"></i>
                                <span>Tải Ảnh</span>
                            </button>
                            <span id="loc-upload-file-name"
                                class="text-xs text-brand-muted font-semibold truncate max-w-[150px]">
                                Chưa chọn file
                            </span>
                        </div>
                    </div>

                    <!-- Image Preview Area -->
                    <div class="space-y-1">
                        <div
                            class="w-full h-28 rounded-xl border border-white/5 bg-slate-950/80 overflow-hidden flex items-center justify-center relative">
                            <img id="loc-image-preview"
                                src="https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80"
                                alt="Location Preview" class="w-full h-full object-cover" />
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-300 uppercase">Trạng Thái Hoạt Động</label>
                        <select name="trang_thai" id="loc-form-trang-thai"
                            class="w-full px-4 py-2.5 bg-slate-900 border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-brand-accent transition-all font-semibold">
                            <option value="active">Hoạt Động</option>
                            <option value="inactive">Tạm Khóa</option>
                        </select>
                    </div>
                </form>
            </div>

            <!-- Buttons -->
            <div class="pt-4 border-t border-white/5 flex shrink-0">
                <button type="button" onclick="submitLocationForm()"
                    class="w-full py-2.5 bg-brand-primary border border-brand-accent/20 hover:bg-brand-primary/80 rounded-xl text-sm font-bold text-white transition-all cursor-pointer">
                    Lưu Lại
                </button>
            </div>
        </div>

        <!-- Right Column: List of Locations Table -->
        <div class="flex-1 p-6 flex flex-col min-h-0">
            <!-- Header -->
            <div class="flex items-center justify-between pb-4 border-b border-white/5 shrink-0">
                <h3 class="text-base font-extrabold text-white flex items-center gap-2 uppercase tracking-wider">
                    <i data-lucide="map-pin" class="w-4 h-4 text-brand-accent"></i>
                    Bảng Thông Tin Địa Điểm
                </h3>
                <button type="button" onclick="closeLocationModal()"
                    class="hidden md:flex p-1.5 hover:bg-white/5 rounded-xl text-slate-400 hover:text-white transition-colors cursor-pointer">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>

            <!-- Table Wrapper -->
            <div class="flex-1 overflow-auto rounded-xl border border-white/5 bg-[#070b19] mt-4">
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-white/5 bg-slate-950/80 text-slate-400 font-bold sticky top-0 z-10">
                            <th class="py-3.5 px-4 w-16 text-center text-sm">Hình</th>
                            <th class="py-3.5 px-4 w-40 text-sm">Tên Địa Điểm</th>
                            <th class="py-3.5 px-4 w-36 text-sm">Danh Mục</th>
                            <th class="py-3.5 px-4 w-40 text-sm">Tỉnh / Quốc Gia</th>
                            <th class="py-3.5 px-4 w-28 text-center text-sm">Trạng Thái</th>
                            <th class="py-3.5 px-4 w-24 text-right text-sm">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody id="location-table-body" class="divide-y divide-white/5">
                        <tr>
                            <td colspan="6" class="text-center text-sm text-slate-400 py-12 font-semibold animate-pulse">
                                Đang tải danh sách địa điểm...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<script>
    // Global State Variables for Locations
    let locations = [];
    let locationCategories = [];
    let isLocInitialFetched = false;

    // Helper to get Category Name by ID
    const getCategoryName = (ma_danh_muc) => {
        const cat = locationCategories.find(c => c.ma_danh_muc === ma_danh_muc);
        return cat ? cat.ten_danh_muc : '<span class="text-slate-600 font-medium">Chưa phân loại</span>';
    };

    // Helper to generate innerHTML for a location row
    const getLocationRowHtml = (loc) => {
        const statusText = loc.trang_thai === 'inactive' ? 'Tạm Khóa' : 'Hoạt Động';
        const statusClass = loc.trang_thai === 'inactive'
            ? 'bg-red-500/10 text-red-400 border-red-500/20'
            : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';

        const locationPlaceText = [loc.tinh_thanh, loc.quoc_gia].filter(Boolean).join(', ');

        return `
            <td class="hidden">
                ${loc.ma_dia_diem}
            </td>
            <td class="py-3 px-4 text-center">
                ${loc.hinh_anh ? `
                    <img src="${loc.hinh_anh}" class="w-10 h-10 rounded-lg object-cover border border-white/10 mx-auto" />
                ` : `
                    <div class="w-10 h-10 bg-slate-800 rounded-lg flex items-center justify-center mx-auto text-slate-500">
                        <i data-lucide="image" class="w-5 h-5"></i>
                    </div>
                `}
            </td>
            <td class="py-3 px-4 font-bold text-white align-middle">
                ${loc.ten_dia_diem}
            </td>
            <td class="py-3 px-4 text-slate-300 align-middle">
                ${getCategoryName(loc.ma_danh_muc)}
            </td>
            <td class="py-3 px-4 text-slate-300 align-middle">
                ${locationPlaceText || '<span class="text-slate-600 font-medium">Chưa cập nhật</span>'}
            </td>
            <td class="py-3 px-4 text-center align-middle">
                <span class="inline-flex px-2.5 py-1 rounded text-xs font-bold border ${statusClass}">
                    ${statusText}
                </span>
            </td>
            <td class="py-3 px-4 text-right align-middle">
                <div class="flex items-center justify-end gap-1.5">
                    <button type="button" 
                        class="edit-loc-btn p-2 hover:bg-brand-primary/10 rounded-lg text-brand-accent transition-all cursor-pointer" 
                        data-ma="${loc.ma_dia_diem}"
                        data-ten="${loc.ten_dia_diem}"
                        data-danhmuc="${loc.ma_danh_muc || ''}"
                        data-tinhthanh="${loc.tinh_thanh || ''}"
                        data-quocgia="${loc.quoc_gia || ''}"
                        data-mota="${loc.mo_ta || ''}"
                        data-hinhanh="${loc.hinh_anh || ''}"
                        data-trangthai="${loc.trang_thai || 'active'}"
                        title="Sửa">
                        <i data-lucide="edit-3" class="w-4 h-4"></i>
                    </button>
                    <button type="button" 
                        class="delete-loc-btn p-2 hover:bg-red-500/10 rounded-lg text-red-400 transition-all cursor-pointer" 
                        data-ma="${loc.ma_dia_diem}"
                        title="Xóa">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
            </td>
        `;
    };

    // Add location row to global variable and DOM
    const addLocationRow = (loc) => {
        const tbody = document.getElementById('location-table-body');
        if (!tbody) return;

        // Clear empty state placeholder if it exists
        if (locations.length === 0) {
            tbody.innerHTML = '';
        }

        // Add to array
        locations.push(loc);

        // Append to DOM
        const tr = document.createElement('tr');
        tr.id = `loc-row-${loc.ma_dia_diem}`;
        tr.className = "hover:bg-white/5 transition-colors text-sm";
        tr.innerHTML = getLocationRowHtml(loc);
        tbody.appendChild(tr);

        // Update icon library
        if (window.lucide) {
            lucide.createIcons();
        }
    };

    // Update location row in global variable and DOM
    const updateLocationRow = (loc) => {
        // Update in array
        const idx = locations.findIndex(item => item.ma_dia_diem === loc.ma_dia_diem);
        if (idx !== -1) {
            locations[idx] = loc;
        }

        // Update in DOM
        const tr = document.getElementById(`loc-row-${loc.ma_dia_diem}`);
        if (tr) {
            tr.innerHTML = getLocationRowHtml(loc);
            if (window.lucide) {
                lucide.createIcons();
            }
        }
    };

    // Remove location row from global variable and DOM
    const removeLocationRow = (ma_dia_diem) => {
        // Remove from array
        locations = locations.filter(item => item.ma_dia_diem !== ma_dia_diem);

        // Remove from DOM
        const tr = document.getElementById(`loc-row-${ma_dia_diem}`);
        if (tr) {
            tr.remove();
        }

        // If no locations left, render placeholder
        const tbody = document.getElementById('location-table-body');
        if (tbody && locations.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center text-sm text-slate-500 py-12 font-semibold">
                        Chưa có địa điểm nào.
                    </td>
                </tr>
            `;
        }
    };

    // Render the entire location table dynamically
    const renderLocationTable = () => {
        const tbody = document.getElementById('location-table-body');
        if (!tbody) return;

        if (locations && locations.length > 0) {
            tbody.innerHTML = locations.map(loc => `
                <tr id="loc-row-${loc.ma_dia_diem}" class="hover:bg-white/5 transition-colors text-sm">
                    ${getLocationRowHtml(loc)}
                </tr>
            `).join('');
            if (window.lucide) {
                lucide.createIcons();
            }
        } else {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center text-sm text-slate-500 py-12 font-semibold">
                        Chưa có địa điểm nào.
                    </td>
                </tr>
            `;
        }
    };

    // Initialize locations and categories
    const initLocations = async () => {
        // Fetch categories first for select list & lookup
        try {
            const catRes = await fetch('/api/category');
            const catResult = await catRes.json();
            if (catResult.success && catResult.data) {
                locationCategories = catResult.data;
                // Populate category select dropdown
                const selectDropdown = document.getElementById('loc-form-ma-danh-muc');
                if (selectDropdown) {
                    selectDropdown.innerHTML = '<option value="" disabled selected>-- Chọn Danh Mục --</option>' + 
                        locationCategories.map(cat => 
                            `<option value="${cat.ma_danh_muc}">${cat.ten_danh_muc}</option>`).join('');
                }
            }
        } catch (err) {
            console.error("Lỗi khi fetch danh mục trong địa điểm:", err);
        }

        if (isLocInitialFetched) {
            renderLocationTable();
            return;
        }

        try {
            const res = await fetch('/api/location');
            const result = await res.json();
            if (result.success && result.data) {
                locations = result.data;
                isLocInitialFetched = true;
                renderLocationTable();
            }
        } catch (err) {
            console.error("Lỗi khi fetch địa điểm ban đầu:", err);
        }
    };

    // Open Modal
    const openLocationModal = () => {
        const modal = document.getElementById('location-modal');
        modal.classList.remove('hidden');
        resetLocationForm();
        initLocations();
    };

    // Close Modal
    const closeLocationModal = () => {
        const modal = document.getElementById('location-modal');
        modal.classList.add('hidden');
    };

    // Close modal when clicking outside the modal box (backdrop)
    document.getElementById('location-modal').addEventListener('click', (e) => {
        if (e.target.id === 'location-modal') {
            closeLocationModal();
        }
    });

    // File Upload Handler (Base64 conversion)
    const locFileInput = document.getElementById('loc-image-upload-input');
    const locFileNameSpan = document.getElementById('loc-upload-file-name');
    const locImgPreview = document.getElementById('loc-image-preview');
    const locHiddenHinhAnh = document.getElementById('loc-form-hinh-anh');

    if (locFileInput && locImgPreview) {
        locFileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                if (locFileNameSpan) locFileNameSpan.innerText = file.name;

                const reader = new FileReader();
                reader.onload = (event) => {
                    locImgPreview.src = event.target.result;
                    locHiddenHinhAnh.value = event.target.result; // Store base64 in hidden input
                };
                reader.readAsDataURL(file);
            }
        });

        locImgPreview.addEventListener('error', () => {
            locImgPreview.src = 'https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80';
        });
    }

    // Populate data for editing
    const editLocation = (id, name, catId, city, country, desc, img, status) => {
        document.getElementById('loc-form-ma-dia-diem').value = id || '';
        document.getElementById('loc-form-ten').value = name || '';
        document.getElementById('loc-form-ma-danh-muc').value = catId || '';
        document.getElementById('loc-form-tinh-thanh').value = city || '';
        document.getElementById('loc-form-quoc-gia').value = country || '';
        document.getElementById('loc-form-mo-ta').value = desc || '';
        document.getElementById('loc-form-hinh-anh').value = img || '';
        document.getElementById('loc-form-trang-thai').value = status || 'active';

        if (img) {
            locImgPreview.src = img;
            locFileNameSpan.innerText = 'Đã chọn ảnh địa điểm';
        } else {
            locImgPreview.src = 'https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80';
            locFileNameSpan.innerText = 'Chưa chọn file';
        }

        document.getElementById('location-form-title').innerText = 'Chỉnh Sửa Địa Điểm';
    };

    // Reset Form to Create mode
    const resetLocationForm = () => {
        document.getElementById('location-form').reset();
        document.getElementById('loc-form-ma-dia-diem').value = '';
        document.getElementById('loc-form-hinh-anh').value = '';
        locImgPreview.src = 'https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?auto=format&fit=crop&w=800&q=80';
        locFileNameSpan.innerText = 'Chưa chọn file';

        document.getElementById('location-form-title').innerText = 'Quản lý Địa Điểm';
    };

    // Submit form (Create / Update)
    const submitLocationForm = async () => {
        const ma_dia_diem = document.getElementById('loc-form-ma-dia-diem').value;
        const ten_dia_diem = document.getElementById('loc-form-ten').value.trim();
        const ma_danh_muc = document.getElementById('loc-form-ma-danh-muc').value;

        if (!ten_dia_diem) {
            alert("Vui lòng nhập tên địa điểm!");
            return;
        }

        if (!ma_danh_muc) {
            alert("Vui lòng chọn danh mục cho địa điểm!");
            return;
        }

        const data = {
            ten_dia_diem,
            ma_danh_muc,
            tinh_thanh: document.getElementById('loc-form-tinh-thanh').value.trim(),
            quoc_gia: document.getElementById('loc-form-quoc-gia').value.trim(),
            hinh_anh: document.getElementById('loc-form-hinh-anh').value.trim(),
            mo_ta: document.getElementById('loc-form-mo-ta').value.trim(),
            trang_thai: document.getElementById('loc-form-trang-thai').value
        };

        const url = ma_dia_diem ? `/api/location/${ma_dia_diem}` : '/api/location';
        const method = ma_dia_diem ? 'PUT' : 'POST';

        try {
            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();

            if (result.success && result.data) {
                showAdminToast(ma_dia_diem ? "Cập nhật địa điểm thành công!" : "Tạo địa điểm mới thành công!");
                resetLocationForm();
                if (ma_dia_diem) {
                    updateLocationRow(result.data);
                } else {
                    addLocationRow(result.data);
                }
            } else {
                alert("Lỗi: " + result.message);
            }
        } catch (err) {
            console.error(err);
            alert("Không thể lưu địa điểm do lỗi kết nối.");
        }
    };

    // Delete Location (Soft Delete)
    const deleteLocation = async (ma_dia_diem) => {
        if (!confirm("Bạn có chắc chắn muốn xóa địa điểm này không?")) return;

        try {
            const res = await fetch(`/api/location/${ma_dia_diem}`, {
                method: 'DELETE'
            });
            const result = await res.json();

            if (result.success) {
                showAdminToast("Đã xóa địa điểm thành công!");
                removeLocationRow(ma_dia_diem);
            } else {
                alert("Lỗi: " + result.message);
            }
        } catch (err) {
            console.error(err);
            alert("Không thể xóa địa điểm do lỗi kết nối.");
        }
    };

    // Event delegation for location table body
    const locationTableBody = document.getElementById('location-table-body');
    if (locationTableBody) {
        locationTableBody.addEventListener('click', (e) => {
            const editBtn = e.target.closest('.edit-loc-btn');
            if (editBtn) {
                const id = editBtn.getAttribute('data-ma');
                const name = editBtn.getAttribute('data-ten');
                const catId = editBtn.getAttribute('data-danhmuc');
                const city = editBtn.getAttribute('data-tinhthanh');
                const country = editBtn.getAttribute('data-quocgia');
                const desc = editBtn.getAttribute('data-mota');
                const img = editBtn.getAttribute('data-hinhanh');
                const status = editBtn.getAttribute('data-trangthai');
                editLocation(id, name, catId, city, country, desc, img, status);
                return;
            }

            const deleteBtn = e.target.closest('.delete-loc-btn');
            if (deleteBtn) {
                const id = deleteBtn.getAttribute('data-ma');
                deleteLocation(id);
                return;
            }
        });
    }
</script>
