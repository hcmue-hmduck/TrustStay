<!-- Data Store & Application Script -->
<script>
    const heroStats = [
        { value: '500+', label: 'Tours' },
        { value: '50K+', label: 'Khách hàng' },
        { value: '4.9/5', label: 'Đánh giá' },
        { value: '10+', label: 'Năm kinh nghiệm' }
    ];

    // Toast function
    function showToast(message) {
        const toast = document.getElementById('toast-notification');
        const text = document.getElementById('toast-text');
        text.innerText = message;
        toast.classList.remove('hidden');
        setTimeout(() => {
            toast.classList.remove('opacity-0', '-translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');
        }, 50);

        setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', '-translate-y-4');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 300);
        }, 3000);
    }

    // Toggle Bento Item View
    function toggleBentoView(id) {
        const activeCard = document.getElementById(`bento-card-${id}`);
        const activePanel = document.getElementById(`bento-info-${id}`);
        const activeLabel = document.getElementById(`bento-label-${id}`);

        if (!activeCard) return;

        const isCurrentlyActive = activeCard.classList.contains('lg:flex-[4.5]');

        // Get bento keys from data attribute to prevent EJS syntax errors in JS files
        const bentoWrapper = document.getElementById('bento-destinations-wrapper');
        const bentoKeys = bentoWrapper ? JSON.parse(bentoWrapper.getAttribute('data-locations') || '[]') : ['halong', 'phuquoc', 'hoian', 'sapa'];
        const defaultKey = bentoKeys[0] || 'halong';

        // If clicking a card that is already active:
        if (isCurrentlyActive) {
            // If it's already the default active card, do nothing (keep it open)
            if (id === defaultKey) return;

            // If it's another card, close it and open the default card back
            toggleBentoView(defaultKey);
            return;
        }

        // Reset all cards to flex-1 (including the default card)
        bentoKeys.forEach(key => {
            const card = document.getElementById(`bento-card-${key}`);
            const panel = document.getElementById(`bento-info-${key}`);
            const label = document.getElementById(`bento-label-${key}`);

            if (card) {
                card.classList.remove('lg:flex-[4.5]');
                card.classList.add('flex-1');

                // Height on mobile
                card.classList.remove('h-[350px]');
                card.classList.add('h-[120px]');
            }
            if (panel) {
                panel.classList.add('opacity-0', 'pointer-events-none');
                panel.classList.remove('opacity-100');
                // Hide panel after fade transition to prevent text wrapping in small columns
                setTimeout(() => {
                    if (panel.classList.contains('opacity-0')) {
                        panel.classList.add('hidden');
                    }
                }, 500);
            }
            if (label) {
                label.classList.remove('opacity-0');
                label.classList.add('opacity-100');
            }
        });

        // Activate clicked card
        activeCard.classList.remove('flex-1');
        activeCard.classList.add('lg:flex-[4.5]');

        // Height on mobile
        activeCard.classList.remove('h-[120px]');
        activeCard.classList.add('h-[350px]');

        if (activePanel) {
            activePanel.classList.remove('hidden');
            // Small delay to allow display: flex state to register in DOM, then fade in
            setTimeout(() => {
                activePanel.classList.remove('opacity-0', 'pointer-events-none');
                activePanel.classList.add('opacity-100');
            }, 50);
        }
        if (activeLabel) {
            activeLabel.classList.remove('opacity-100');
            activeLabel.classList.add('opacity-0');
        }
    }

    // Close Dropdowns on Document Click
    document.addEventListener('click', (e) => {
        if (!e.target.closest('#bento-destinations')) {
            const bentoWrapper = document.getElementById('bento-destinations-wrapper');
            const bentoKeys = bentoWrapper ? JSON.parse(bentoWrapper.getAttribute('data-locations') || '[]') : ['halong', 'phuquoc', 'hoian', 'sapa'];
            const defaultKey = bentoKeys[0] || 'halong';
            const defaultCard = document.getElementById(`bento-card-${defaultKey}`);
            if (defaultCard && !defaultCard.classList.contains('lg:flex-[4.5]')) {
                toggleBentoView(defaultKey);
            }
        }
    });

    // Render Stats
    function renderStats() {
        const container = document.getElementById('stats-container');
        container.innerHTML = heroStats.map(stat => `
            <div class="flex flex-col items-center">
                <span class="text-2xl md:text-4xl font-extrabold text-brand-accent">${stat.value}</span>
                <span class="text-xs text-brand-muted/80 uppercase tracking-wider mt-1">${stat.label}</span>
            </div>
        `).join('');
    }

    // Explore category button
    function exploreCategory(catId, catTitle) {
        showToast(`Đang khám phá danh mục: ${catTitle}`);
    }

    // Toggle favorite
    function toggleFavorite(id) {
        const icon = document.getElementById(`fav-icon-${id}`);
        if (icon) {
            icon.classList.toggle('fill-red-500');
            icon.classList.toggle('text-red-500');
            icon.classList.toggle('text-white');
        }
    }

    // Form search submit
    document.getElementById('search-form').addEventListener('submit', (e) => {
        e.preventDefault();
        showToast('Chức năng tìm kiếm sẽ khả dụng trong phiên bản tới!');
    });



    // 3D Tours Carousel Logic
    const stage3DElement = document.getElementById('stage-3d');
    const tours3DData = stage3DElement ? JSON.parse(stage3DElement.getAttribute('data-tours-3d') || '[]') : [];

    let virtualIndex = 1; // Ninh Bình is index 1

    function setup3DCarousel() {
        const stage = document.getElementById('stage-3d');
        const dotsContainer = document.getElementById('dots-3d-container');
        if (!stage) return;

        // Render Dots once
        if (dotsContainer) {
            dotsContainer.innerHTML = tours3DData.map((_, idx) => {
                return `
                    <span 
                        id="dot-3d-${idx}"
                        onclick="clickDot3D(${idx})"
                        class="w-2.5 h-2.5 rounded-full cursor-pointer transition-all duration-300 bg-white/20 hover:bg-white/45"
                    ></span>
                `;
            }).join('');
        }

        // Attach click listeners dynamically to card-3d elements
        tours3DData.forEach((_, idx) => {
            const card = document.getElementById(`card-3d-${idx}`);
            if (card) {
                card.addEventListener('click', () => select3DActive(idx));
            }
        });

        // Apply initial rotation and classes
        updateCarouselState();
        init3DTilt();
    }

    function updateCarouselState() {
        const stage = document.getElementById('stage-3d');
        if (!stage) return;

        // Rotate stage without tilt
        stage.style.transform = `rotateY(${-virtualIndex * 90}deg)`;

        // Calculate current active index (modulo 4)
        const activeIdx = (virtualIndex % 4 + 4) % 4;

        // Update card styles
        tours3DData.forEach((_, idx) => {
            const card = document.getElementById(`card-3d-${idx}`);
            const dot = document.getElementById(`dot-3d-${idx}`);
            if (card) {
                const isActive = idx === activeIdx;
                const inner = card.querySelector('.tilt-card-inner');

                // Calculate billboard rotation so card always faces front
                const billboardRot = -idx * 90 + virtualIndex * 90;

                // Update transform with scale & translateZ
                card.style.transform = `rotateY(${idx * 90}deg) translateZ(320px) rotateY(${billboardRot}deg) scale(${isActive ? 1.05 : 0.8})`;

                if (isActive) {
                    card.classList.remove('opacity-50', 'z-10');
                    card.classList.add('opacity-100', 'z-20');
                    if (inner) {
                        inner.classList.add('border-blue-500', 'shadow-[0_0_25px_rgba(30,144,255,0.25)]');
                        inner.classList.remove('border-white/10');
                    }
                } else {
                    card.classList.remove('opacity-100', 'z-20');
                    card.classList.add('opacity-50', 'z-10');
                    if (inner) {
                        inner.classList.remove('border-blue-500', 'shadow-[0_0_25px_rgba(30,144,255,0.25)]');
                        inner.classList.add('border-white/10');
                    }
                }
            }

            if (dot) {
                if (idx === activeIdx) {
                    dot.classList.add('bg-blue-500', 'px-3');
                    dot.classList.remove('bg-white/20');
                } else {
                    dot.classList.remove('bg-blue-500', 'px-3');
                    dot.classList.add('bg-white/20');
                }
            }
        });

        // Update Bottom Showcase Box
        renderBottomShowcase(activeIdx);
    }

    function renderBottomShowcase(activeIdx) {
        const panel = document.getElementById('showcase-3d-panel');
        if (!panel) return;

        const tour = tours3DData[activeIdx];

        panel.innerHTML = `
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="space-y-3 flex-1 text-center md:text-left">
                    <h3 class="text-xl md:text-2xl font-black text-slate-800 leading-tight">${tour.title}</h3>
                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 text-xs text-slate-500 font-bold">
                        <span class="flex items-center gap-1">
                            <i data-lucide="map-pin" class="w-3.5 h-3.5 text-blue-600 fill-blue-600/10"></i>
                            <span>${tour.location}</span>
                        </span>
                        <span class="flex items-center gap-1">
                            <i data-lucide="calendar" class="w-3.5 h-3.5 text-blue-600"></i>
                            <span>${tour.duration}</span>
                        </span>
                        <span class="flex items-center gap-1">
                            <i data-lucide="star" class="w-3.5 h-3.5 text-yellow-500 fill-yellow-500"></i>
                            <span>${tour.rating}</span>
                        </span>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row items-center gap-6 w-full md:w-auto">
                    <div class="text-center sm:text-right">
                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-wider">Tổng giá vé từ</p>
                        <p class="text-2xl font-black text-blue-600">${tour.price}</p>
                    </div>
                    <button 
                        onclick="showToast('Tính năng đang được cập nhật!')"
                        class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-full text-xs font-black transition-all flex items-center gap-2 cursor-pointer shadow-lg shadow-blue-600/20 active:scale-95 w-full sm:w-auto justify-center"
                    >
                        <span>Đặt tour ngay</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>
        `;
        lucide.createIcons();
    }

    function next3D() {
        virtualIndex++;
        updateCarouselState();
    }

    function prev3D() {
        virtualIndex--;
        updateCarouselState();
    }

    function select3DActive(idx) {
        clickDot3D(idx);
    }

    function clickDot3D(targetIdx) {
        const currentActualIdx = (virtualIndex % 4 + 4) % 4;
        let diff = targetIdx - currentActualIdx;
        if (diff > 2) diff -= 4;
        if (diff < -2) diff += 4;
        virtualIndex += diff;
        updateCarouselState();
    }

    function init3DTilt() {
        const cards = document.querySelectorAll('.carousel-3d-card');
        cards.forEach(card => {
            const inner = card.querySelector('.tilt-card-inner');
            if (!inner) return;

            card.addEventListener('mousemove', (e) => {
                if (!card.classList.contains('opacity-100')) return;

                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const xc = rect.width / 2;
                const yc = rect.height / 2;
                const angleX = (yc - y) / 8;
                const angleY = (x - xc) / 8;
                inner.style.transform = `rotateX(${angleX}deg) rotateY(${angleY}deg) scale3d(1.03, 1.03, 1.03)`;
            });
            card.addEventListener('mouseleave', () => {
                inner.style.transform = `rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
            });
        });
    }

    // App Initialization
    window.addEventListener('DOMContentLoaded', () => {
        renderStats();
        setup3DCarousel();
    });
</script>