                    class="flex items-center gap-1.5 text-xs font-bold text-white bg-white/5 border border-white/10 hover:border-brand-accent/30 hover:bg-white/10 px-4 py-2 rounded-full cursor-pointer transition-colors"
                    onclick="applyLocationFilter('${loc}')"
                >
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-accent"></i>
                    <span>${loc}</span>
                </span>
            `).join('');

            return `
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    <!-- Image showcase wrapper -->
                    <div class="lg:col-span-6 w-full h-[250px] sm:h-[350px] lg:h-[400px] relative rounded-3xl overflow-hidden shadow-2xl border border-white/5 group ${isEven ? 'order-1' : 'order-1 lg:order-2'}">
                        <img 
                            alt="${cat.title}" 
                            class="w-full h-full object-cover transition-transform duration-[1000ms] group-hover:scale-105" 
                            src="${cat.image}"
                            referrerPolicy="no-referrer"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-transparent to-transparent"></div>
                        
                        <!-- Badge -->
                        <div class="absolute top-6 left-6 px-4 py-2 glass-panel rounded-full flex items-center gap-2">
                            <span class="w-2 h-2 bg-brand-accent rounded-full animate-ping"></span>
                            <span class="text-[10px] font-black uppercase tracking-widest text-white">${cat.title}</span>
                        </div>

                        <!-- Watermark -->
                        <div class="absolute bottom-6 left-6 right-6 flex items-center justify-between">
                            <span class="text-[10px] bg-black/60 backdrop-blur-md text-brand-muted/95 border border-white/10 px-3 py-1 rounded-full font-bold">
                                Bắt đầu hành trình kì vĩ
                            </span>
                        </div>
                    </div>

                    <!-- Info details wrapper -->
                    <div class="lg:col-span-6 text-left ${isEven ? 'order-2' : 'order-2 lg:order-1'}">
                        <p class="text-brand-accent font-extrabold text-xs tracking-widest mb-3 uppercase">―― ${cat.countLabel}</p>
                        <h3 class="text-2xl md:text-4xl font-extrabold text-white mb-4 flex items-center gap-2">
                            <span>${cat.title}</span>
                            <span class="text-xs font-semibold px-2.5 py-1 bg-white/5 rounded-full border border-white/5 text-brand-secondary">
                                ${cat.subtitle}
                            </span>
                        </h3>
                        <p class="text-brand-muted text-sm md:text-base leading-relaxed mb-6 opacity-90">
                            ${cat.description}
                        </p>

                        <!-- Tags -->
                        <div class="flex flex-wrap gap-2.5 mb-8">
                            ${locationsHtml}
                        </div>

                        <button 
                            onclick="exploreCategory('${cat.id}', '${cat.title}')"
                            class="px-8 py-3.5 bg-brand-accent text-brand-dark rounded-full text-xs font-black hover:bg-brand-primary active:scale-95 transition-all flex items-center gap-2 shadow-lg shadow-brand-accent/10 cursor-pointer"
                        >
                            <span>Khám phá ngay</span>
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            `;
        }).join('');
        lucide.createIcons();
    }

    // Apply Location tag filter
    function applyLocationFilter(loc) {
        searchDest = loc;
        document.getElementById('search-destination-input').value = loc;
        document.getElementById('clear-dest-btn').classList.remove('hidden');
        showToast(`Đã lọc theo: ${loc}`);
        document.getElementById('search-destination-input').focus();
    }

    // Explore category button
    function exploreCategory(catId, catTitle) {
        const pkg = tourPackages.find(p => p.categoryId === catId);
        if (pkg) {
            openBookingModal(pkg.id);
        } else {
            searchDest = catTitle;
            document.getElementById('search-destination-input').value = catTitle;
            document.getElementById('clear-dest-btn').classList.remove('hidden');
            filterTours();
            showToast(`Lọc theo thể loại: ${catTitle}`);
        }
    }

    // Toggle favorite
    function toggleFavorite(id) {
        const pkg = tourPackages.find(p => p.id === id);
        if (!pkg) return;
        if (favorites.includes(id)) {
            favorites = favorites.filter(favId => favId !== id);
            showToast(`Đã xoá "${pkg.title}" khỏi danh sách yêu thích`);
        } else {
            favorites.push(id);
            showToast(`Đã thêm "${pkg.title}" vào danh sách yêu thích! ❤️`);
        }
        updateFavoritesDropdown();
        renderToursGrid();
    }

    // Update Favorites List in Header Dropdown
    function updateFavoritesDropdown() {
        const dropdown = document.getElementById('favorites-dropdown');
        const badge = document.querySelector('#favorites-toggle-btn span');
        const icon = document.querySelector('#favorites-toggle-btn i');

        if (!dropdown) return;
        const listContainer = dropdown.querySelector('.space-y-3');
        if (!listContainer) return;

        listContainer.innerHTML = '';

        if (favorites.length === 0) {
            listContainer.innerHTML = `
                <div class="text-center py-6 text-brand-muted text-xs">
                    <p class="mb-2">Danh sách yêu thích trống.</p>
                    <p class="text-[10px]">Nhấn ❤️ tại các tour du lịch để lưu trữ tiện lợi.</p>
                </div>
            `;
            if (badge) badge.classList.add('hidden');
            if (icon) icon.classList.remove('fill-brand-accent');
        } else {
            if (badge) {
                badge.classList.remove('hidden');
                badge.textContent = favorites.length;
            }
            if (icon) {
                icon.classList.add('fill-brand-accent');
            }

            favorites.forEach(favId => {
                const pkg = tourPackages.find(p => p.id === favId);
                if (!pkg) return;

                const item = document.createElement('div');
                item.className = 'flex items-center gap-3 p-1.5 rounded-xl hover:bg-white/5 transition-colors cursor-pointer group';
                item.onclick = () => {
                    openBookingModal(pkg.id);
                    dropdown.classList.add('hidden');
                };
                item.innerHTML = `
                    <img src="${pkg.image}" alt="${pkg.title}" class="w-12 h-12 rounded-lg object-cover" />
                    <div class="flex-1 min-w-0">
                      <p class="text-xs font-bold text-white group-hover:text-brand-primary transition-colors truncate">${pkg.title}</p>
                      <p class="text-[10px] text-brand-muted flex items-center gap-1 mt-0.5">
                        <i data-lucide="map-pin" class="w-3 h-3 text-brand-accent"></i>
                        <span class="truncate">${pkg.location}</span>
                      </p>
                      <p class="text-xs font-black text-brand-accent mt-0.5">${pkg.currentPrice.toLocaleString('vi-VN')} đ</p>
                    </div>
                    <button 
                      onclick="event.stopPropagation(); toggleFavorite('${pkg.id}');"
                      class="p-1 text-red-400 hover:text-red-300 hover:bg-white/5 rounded"
                      title="Xóa khỏi yêu thích"
                    >
                      <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                `;
                listContainer.appendChild(item);
            });
            lucide.createIcons();
        }
    }

    // Update Bookings List in Header Dropdown
    function updateBookingsDropdown() {
        const dropdown = document.getElementById('bookings-dropdown');
        const badge = document.querySelector('#user-profile-btn .relative span');

        if (!dropdown) return;
        const listContainer = dropdown.querySelector('.space-y-3');
        if (!listContainer) return;

        listContainer.innerHTML = '';

        if (myBookings.length === 0) {
            listContainer.innerHTML = `
                <div class="text-center py-6 text-brand-muted text-xs">
                    <p>Bạn chưa đặt tour nào gần đây.</p>
                    <p class="mt-1 text-[10px]">Tìm hành trình yêu thích và đặt vé trải nghiệm ngay!</p>
                </div>
            `;
            if (badge) badge.classList.add('hidden');
        } else {
            if (badge) badge.classList.remove('hidden');

            myBookings.forEach(bk => {
                const item = document.createElement('div');
                item.className = 'p-3 bg-white/5 hover:bg-white/10 rounded-xl transition-all border border-white/5 relative group';
                item.innerHTML = `
                    <span class="absolute top-2.5 right-2.5 bg-green-500/20 text-green-300 text-[9px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">
                      ${bk.status === 'confirmed' ? 'Đã xác nhận' : 'Chờ duyệt'}
                    </span>
                    <p class="text-[10px] text-brand-accent font-mono">${bk.id}</p>
                    <h5 class="text-xs font-bold text-white mt-1 pr-14 line-clamp-1">${bk.tourTitle}</h5>
                    
                    <div class="grid grid-cols-2 gap-y-1.5 gap-x-2 mt-2 pt-2 border-t border-white/5 text-[10px] text-brand-muted">
                      <p class="flex items-center gap-1">
                        <i data-lucide="calendar" class="w-3 h-3 text-brand-accent"></i>
                        <span>${bk.startDate}</span>
                      </p>
                      <p class="flex items-center gap-1">
                        <i data-lucide="users" class="w-3 h-3 text-brand-accent"></i>
                        <span>${bk.guestsCount} Vé</span>
                      </p>
                    </div>
                    <div class="flex justify-between items-center mt-2.5 pt-1.5 border-t border-white/5">
                      <span class="text-[9px] text-brand-muted">Ngày đặt: ${bk.bookingDate}</span>
                      <span class="text-xs font-extrabold text-brand-accent">${bk.totalPrice.toLocaleString('vi-VN')} đ</span>
                    </div>
                `;
                listContainer.appendChild(item);
            });
            lucide.createIcons();
        }
    }

